{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "MMLib.Alvo.Api.Tests/MMLib.Alvo.Api.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "log-to-file": true,
    "additional-timeout": 300000,
    "mutate": [
      "**/Commands/Internal/CommandEndpointFilter.cs",
      "**/Commands/Internal/CommandGateCheck.cs",
      "**/InboundWebhooks/Internal/WebhookReceiver.cs",
      "**/Api/Internal/CallerGate.cs",
      "**/Api/Internal/AlvoCallerFilter.cs",
      "**/Api/Internal/AlvoGateWitness.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 44,
      "break": 40
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
