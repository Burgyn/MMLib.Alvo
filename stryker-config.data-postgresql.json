{
  "stryker-config": {
    "project": "MMLib.Alvo.Data.PostgreSql.csproj",
    "test-projects": [
      "MMLib.Alvo.Data.PostgreSql.Tests/MMLib.Alvo.Data.PostgreSql.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
      "**/*.cs",
      "!**/AssemblyInfo.cs",
      "!AlvoPostgreSqlBuilderExtensions.cs",
      "!PostgreSqlProviderOptions.cs"
    ],
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 80
    },
    "reporters": [
      "progress",
      "cleartext"
    ]
  }
}
