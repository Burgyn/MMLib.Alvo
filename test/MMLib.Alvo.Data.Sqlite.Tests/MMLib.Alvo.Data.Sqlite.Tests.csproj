<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/MMLib.Alvo/MMLib.Alvo.csproj" />
    <ProjectReference Include="../../src/MMLib.Alvo.Data.Sqlite/MMLib.Alvo.Data.Sqlite.csproj" />
    <!-- The relational half of the test-support library: AlvoSqlDialectContractTests (and, where a
         test needs it, the T-SQL fake). Referenced per project rather than from
         test/Directory.Build.props on purpose — only the projects with a dialect to hold to the
         contract take an EF dependency for it. -->
    <ProjectReference Include="../../src/MMLib.Alvo.Testing.EntityFrameworkCore/MMLib.Alvo.Testing.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- The SQLite fixture and the dialect it records locks through, shared with
       MMLib.Alvo.Data.Sqlite.Tests.Integration — which is the chaos criterion's own project since that criterion
       left ring0. They live in test/_shared/sqlite rather than here because a second copy of "stand up one
       isolated real SQLite database" is how the two projects' engines would come to be wired differently, and
       under test/_shared/sqlite rather than at test/_shared because that directory's *.cs glob is compiled by
       every test project, including ones with no engine at all. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/sqlite/SqliteAlvoDataFixture.cs" Link="_shared/SqliteAlvoDataFixture.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/sqlite/LockRecordingSqlDialect.cs" Link="_shared/LockRecordingSqlDialect.cs" />
  </ItemGroup>

  <!-- The one differential probe both engines answer through. Linked rather than copied: two per-engine
       copies would be the very way a differential comparison stops comparing like with like. It lives in a
       _shared subdirectory so the test/_shared/*.cs glob — which every test project compiles, including ones
       with no EF reference at all — does not pick it up. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/DifferentialProbe.cs" Link="_shared/DifferentialProbe.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/SqlCapture.cs" Link="_shared/SqlCapture.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/PolicyPredicateParameters.cs" Link="_shared/PolicyPredicateParameters.cs" />
  </ItemGroup>

  <!-- The outbox table's engine facts, shared with MMLib.Alvo.Data.PostgreSql.Tests.Integration. Linked for
       the same reason DifferentialProbe is: the DDL is one CREATE TABLE IF NOT EXISTS over ANSI-portable types
       and the insert is one parameterised INSERT, so both engines must be asked exactly the same question —
       two per-engine copies are two chances for them to stop being asked it. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/OutboxTableFacts.cs" Link="_shared/OutboxTableFacts.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/AlvoDataOutboxWorld.cs" Link="_shared/AlvoDataOutboxWorld.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/AlvoDataBeforeHookWorld.cs" Link="_shared/AlvoDataBeforeHookWorld.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/OutboxStoreWorld.cs" Link="_shared/OutboxStoreWorld.cs" />
  </ItemGroup>

  <!-- The world the two event acceptance criteria run over, shared with
       MMLib.Alvo.Data.PostgreSql.Tests.Integration. Linked for the same reason the outbox facts are: both
       criteria are engine-agnostic by construction, and a per-engine copy of the drain, the tally or the
       probes is how the two legs stop being asked the same question. They live under _shared/events rather
       than at test/_shared, whose *.cs glob every test project compiles — including ones with no engine and
       no event subsystem, where these types would be uninstantiated internal classes. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/events/AlvoEventCriteriaWorld.cs" Link="_shared/AlvoEventCriteriaWorld.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/events/DispatchedEventCollection.cs" Link="_shared/DispatchedEventCollection.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/events/OutboxTallyProbe.cs" Link="_shared/OutboxTallyProbe.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/events/RecordingEventLog.cs" Link="_shared/RecordingEventLog.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/events/RecordingMeterListener.cs" Link="_shared/RecordingMeterListener.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/events/RecordingWebhookReceiver.cs" Link="_shared/RecordingWebhookReceiver.cs" />
  </ItemGroup>

  <!-- The concurrent-cold-start harness, shared with MMLib.Alvo.Data.PostgreSql.Tests.Integration. Linked for
       the same reason DifferentialProbe is: convergence under a lost race is an engine-agnostic guarantee, and
       two per-engine copies of the barrier and the probe counts are how the two legs stop measuring the same
       thing. It uses Alvo's public surface only, because that project is not granted the core's internals. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/boot/ConcurrentColdStart.cs" Link="_shared/ConcurrentColdStart.cs" />
  </ItemGroup>

</Project>
