<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testcontainers-backed integration project, not a 1:1 unit test project
       (hence the ".Tests.Integration" suffix instead of ".Tests"): opt out of
       the shared architecture + public-API approval gate. A fast unit test
       project for MMLib.Alvo.Data.PostgreSql (and its public-API baseline)
       lands later, when the provider is wired (F3 Task 12). -->
  <PropertyGroup>
    <AlvoSharedArchTests>false</AlvoSharedArchTests>
  </PropertyGroup>

  <ItemGroup>
    <!-- MMLib.Alvo (core) is not otherwise on this project's reference chain — Data.PostgreSql only
         depends on Data.EntityFrameworkCore + Abstractions — but RuntimeSchemaService and AddAlvo
         live in core, so the runtime-versioning integration tests need it directly, mirroring
         MMLib.Alvo.Data.Sqlite.Tests' reference to both core and its provider. -->
    <ProjectReference Include="../../src/MMLib.Alvo/MMLib.Alvo.csproj" />
    <ProjectReference Include="../../src/MMLib.Alvo.Data.PostgreSql/MMLib.Alvo.Data.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!-- Only the path-derivation module initializer from test/_shared — this project opts out of
       the shared arch/public-API gate above (AlvoSharedArchTests=false), but the generated-SQL
       snapshot tests still want their Verify baselines to live next to this project, not in
       test/_shared. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/VerifyModuleInit.cs" Link="_shared/VerifyModuleInit.cs" />
  </ItemGroup>

  <!-- The one differential probe both engines answer through — see the same link in
       MMLib.Alvo.Data.Sqlite.Tests. A per-engine copy is how a differential comparison stops comparing like
       with like. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/DifferentialProbe.cs" Link="_shared/DifferentialProbe.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/SqlCapture.cs" Link="_shared/SqlCapture.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/PolicyPredicateParameters.cs" Link="_shared/PolicyPredicateParameters.cs" />
  </ItemGroup>

  <!-- The outbox table's engine facts, shared with MMLib.Alvo.Data.Sqlite.Tests — see the same link there. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/OutboxTableFacts.cs" Link="_shared/OutboxTableFacts.cs" />
  </ItemGroup>

  <!-- The container-creation mechanics every Testcontainers-backed PostgreSQL fixture in this repository
       needs, shared with MMLib.Alvo.Api.Tests.Integration's PostgresApiEngine — a second copy of the image
       tag and the lazy-build discipline is exactly how the two would quietly drift apart. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/postgres/PostgresTestContainer.cs" Link="_shared/PostgresTestContainer.cs" />
  </ItemGroup>

  <!-- The concurrent-cold-start harness, shared with MMLib.Alvo.Data.Sqlite.Tests. Convergence under a lost
       race is an engine-agnostic guarantee (§0 principle 3) and only the engine's own failure differs, so the
       barrier and the probe counts are linked rather than copied. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/boot/ConcurrentColdStart.cs" Link="_shared/ConcurrentColdStart.cs" />
  </ItemGroup>

</Project>
