<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AlvoSharedArchTests>false</AlvoSharedArchTests>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <ExtendingSnippets>$(MSBuildThisFileDirectory)../../website/src/snippets/extending</ExtendingSnippets>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="Xunit" />
    <Using Remove="Shouldly" />
    <Using Remove="MMLib.Alvo.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MMLib.Alvo.TestHost/MMLib.Alvo.TestHost.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Every snippet a reader copies compiles under ALVO1001, which TreatWarningsAsErrors makes an error here. -->
    <ProjectReference Include="../../src/MMLib.Alvo.Analyzers/MMLib.Alvo.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(ExtendingSnippets)/**/*.cs" Link="Snippets/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(ExtendingSnippets)/**/*.alvo.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
