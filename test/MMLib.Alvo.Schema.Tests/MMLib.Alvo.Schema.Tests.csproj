<Project Sdk="Microsoft.NET.Sdk">

  <!-- No 1:1 production assembly (like Conventions/integration/e2e): opt out of
       the shared architecture + public-API approval gate. -->
  <PropertyGroup>
    <AlvoSharedArchTests>false</AlvoSharedArchTests>
    <!-- Corvus.Json.Validator (used only by this project's SchemaValidator test helper, not by
         shipped MMLib.Alvo) compiles its generated validator types at runtime via Roslyn,
         resolving reference assemblies from DependencyContext.Default.CompileLibraries — which is
         only populated when the running executable sets PreserveCompilationContext. This project
         is an Exe (own deps.json), so without this, JsonSchema.FromFile/Validate throws
         (CS0518 "Predefined type 'System.Object' is not defined") the first time it runs. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Corvus.Json.Validator" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MMLib.Alvo.Abstractions/MMLib.Alvo.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="VerifyXunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meta-schema/**/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="meta-schema" />
  </ItemGroup>

</Project>
