<Project Sdk="Microsoft.NET.Sdk">

  <!-- The docs generator's renderers over small fixtures, plus structural facts over the real schema and assemblies.
       It maps to no shipped assembly, so it opts out of the shared architecture + public-API gate. -->
  <PropertyGroup>
    <AlvoSharedArchTests>false</AlvoSharedArchTests>
    <!-- DocIdFixture's member shapes are read back from this assembly's own XML documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/MMLib.Alvo.DocsGen/MMLib.Alvo.DocsGen.csproj" />
  </ItemGroup>

</Project>
