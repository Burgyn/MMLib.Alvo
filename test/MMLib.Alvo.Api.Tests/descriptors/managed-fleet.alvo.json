{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "managed-fleet",
  "description": "The project the Management API's read surface is measured over. It declares an access block, so a caller can reach the surface at all; two entities, so 'what is served' is a set rather than a single name; and rules that admit one declared role and refuse another, so a policy simulation has two different answers to give and can be compared against what the Data API actually answers.",
  "auth": {
    "providers": ["local"],
    "roles": ["ops", "dispatcher"]
  },
  "access": {
    "viewer": "'ops' in @user.roles"
  },
  "entities": {
    "depots": {
      "description": "Where a vehicle is kept.",
      "fields": {
        "name": { "type": "string", "required": true, "maxLength": 120 }
      },
      "rules": {
        "list": "'dispatcher' in @user.roles",
        "get": "'dispatcher' in @user.roles",
        "create": "'admin' in @user.roles",
        "update": "'admin' in @user.roles",
        "delete": "'admin' in @user.roles"
      }
    },
    "vehicles": {
      "description": "A vehicle the fleet operates.",
      "fields": {
        "plate": { "type": "string", "required": true, "unique": true, "maxLength": 12 }
      },
      "rules": {
        "list": "'dispatcher' in @user.roles",
        "get": "'dispatcher' in @user.roles",
        "create": "'admin' in @user.roles",
        "update": "'admin' in @user.roles",
        "delete": "'admin' in @user.roles"
      }
    }
  }
}
