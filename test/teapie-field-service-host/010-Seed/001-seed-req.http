### The embedded host serves the same descriptor as the standalone stack: a region only the admin creates
# @name CreateNorthRegion
## TEST-EXPECT-STATUS: [201]
POST {{fshBaseUrl}}/api/regions
X-Alvo-Api-Key: {{keyAdmin}}
Content-Type: application/json

{ "code": "NORTH", "name": "Northern region" }

### A north customer open 07:00-19:00 Bratislava: the service hours the host's before-write hook schedules against
# @name CreateNorthCustomer
## TEST-EXPECT-STATUS: [201]
POST {{fshBaseUrl}}/api/customers
X-Alvo-Api-Key: {{keyDispatcherNorth}}
Content-Type: application/json

{ "tenant_id": "{{tenantNorth}}", "name": "Kaviareň Dunaj", "tier": "standard", "email": "ops@dunaj.test", "service_opens_hour": 7, "service_closes_hour": 19 }

### A south customer with no service hours, so nothing south is ever refused for its slot
# @name CreateSouthCustomer
## TEST-EXPECT-STATUS: [201]
POST {{fshBaseUrl}}/api/customers
X-Alvo-Api-Key: {{keyDispatcherSouth}}
Content-Type: application/json

{ "tenant_id": "{{tenantSouth}}", "name": "Pekáreň Juh", "tier": "priority" }

### WO-7001: a new job the dispatcher will dispatch, and the technician app will complete
# @name CreateWo7001
## TEST-EXPECT-STATUS: [201]
POST {{fshBaseUrl}}/api/work_orders
X-Alvo-Api-Key: {{keyDispatcherNorth}}
Content-Type: application/json

{ "tenant_id": "{{tenantNorth}}", "reference": "WO-7001", "title": "Espresso machine leaks", "status": "new", "priority": 3, "access_code": "7001", "contact_email": "barista@dunaj.test", "customer_id": "{{CreateNorthCustomer.response.body.$.id}}", "region_id": "{{CreateNorthRegion.response.body.$.id}}" }

### WO-7002: new, already assigned to tech-north — so the technician can READ it and the dispatch refusal is the rule's, not a 404
# @name CreateWo7002
## TEST-EXPECT-STATUS: [201]
POST {{fshBaseUrl}}/api/work_orders
X-Alvo-Api-Key: {{keyDispatcherNorth}}
Content-Type: application/json

{ "tenant_id": "{{tenantNorth}}", "reference": "WO-7002", "title": "Grinder jams", "status": "new", "priority": 3, "access_code": "7002", "assigned_to": "{{userTechNorth}}", "customer_id": "{{CreateNorthCustomer.response.body.$.id}}", "region_id": "{{CreateNorthRegion.response.body.$.id}}" }

