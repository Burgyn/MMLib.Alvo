<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="'' != $([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="MMLib.Alvo.Testing" />
  </ItemGroup>

  <!-- Test-support library (ArchTargetAttribute, RepositoryRoot; later fakes + contract-suite base). -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/MMLib.Alvo.Testing/MMLib.Alvo.Testing.csproj" />
  </ItemGroup>

  <!--
    Shared tests linked into each test project so they compile into that
    project's assembly and run against its sibling production assembly, composing
    with dotnet-affected: architecture rules (os B) + the public-API approval
    gate. Opt out with AlvoSharedArchTests=false where a project does not map 1:1
    to a production assembly (conventions, integration, e2e). The public-API
    tooling is only needed here.
  -->
  <ItemGroup Condition="'$(AlvoSharedArchTests)' != 'false'">
    <Compile Include="$(MSBuildThisFileDirectory)_shared/*.cs" Link="_shared/%(Filename)%(Extension)" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!--
    What a test assembly must do differently when Stryker is the one running it
    (issue #142). Unconditional, unlike the shared set above, because the projects
    that opt out of that set use Verify too and one of them (MMLib.Alvo.Api.Tests)
    is a mutation target. Its own subdirectory so the non-recursive _shared/*.cs
    glob above cannot also pick it up and double-include it. Verify itself arrives
    transitively from MMLib.Alvo.Testing.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)_shared/mutation/*.cs" Link="_shared/mutation/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
