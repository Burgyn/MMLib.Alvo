{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "ledger-desk",
  "description": "The transaction facts' desk. An auditor may correct an invoice but never create one, so a create checked as an update would pass and a fact can tell the two apart.",
  "tenancy": { "enabled": true },
  "auth": { "roles": ["clerk", "auditor"] },
  "entities": {
    "invoices": {
      "tenancy": "scoped",
      "fields": {
        "number": { "type": "string", "required": true, "unique": true, "maxLength": 20 },
        "total": { "type": "decimal", "precision": 12, "scale": 2 },
        "note": { "type": "string", "maxLength": 40 },
        "vat": { "type": "integer" },
        "net": {
          "type": "integer",
          "description": "The sum of the lines' amounts, maintained by Alvo.",
          "rollup": { "from": "invoice_lines", "op": "sum", "field": "amount" }
        },
        "gross": {
          "type": "integer",
          "description": "The rollup plus the VAT, computed by the database.",
          "computed": "net + vat"
        }
      },
      "rules": {
        "list": "'clerk' in @user.roles || 'auditor' in @user.roles || 'admin' in @user.roles",
        "get": "'clerk' in @user.roles || 'auditor' in @user.roles || 'admin' in @user.roles",
        "create": "'clerk' in @user.roles || 'admin' in @user.roles",
        "update": "'clerk' in @user.roles || 'auditor' in @user.roles || 'admin' in @user.roles"
      }
    },
    "invoice_lines": {
      "tenancy": "scoped",
      "fields": {
        "invoice_id": { "type": "ref", "entity": "invoices", "required": true },
        "amount": { "type": "integer", "required": true }
      },
      "rules": {
        "list": "'clerk' in @user.roles || 'admin' in @user.roles",
        "get": "'clerk' in @user.roles || 'admin' in @user.roles",
        "create": "'clerk' in @user.roles || 'admin' in @user.roles"
      }
    }
  }
}
