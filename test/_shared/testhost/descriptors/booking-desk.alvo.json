{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "booking-desk",
  "description": "The time facts' desk: a tenant-scoped booking whose reminders are timers.",
  "tenancy": { "enabled": true },
  "auth": { "roles": ["staff", "ops", "watch"] },
  "access": {
    "developer": "'ops' in @user.roles",
    "viewer": "'watch' in @user.roles"
  },
  "entities": {
    "bookings": {
      "tenancy": "scoped",
      "fields": {
        "starts_at": { "type": "datetime" },
        "note": { "type": "text" }
      },
      "rules": {
        "list": "true",
        "get": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    }
  }
}
