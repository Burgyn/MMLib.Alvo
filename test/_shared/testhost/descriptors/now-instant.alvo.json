{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "now-instant",
  "description": "One now() per request (HX-11 acceptance (4)): a rule, a before-hook condition and its mutate, and a write hook's when all read now(), while host hooks move the clock in between. Every rule is the window created_at > now() - duration('1h'), so each data-port entry judges a now() rule.",
  "auth": { "providers": ["local"], "roles": ["clerk"] },
  "entities": {
    "notes": {
      "audit": true,
      "fields": {
        "body": { "type": "string", "maxLength": 200 },
        "stamped_at": { "type": "datetime" },
        "judged_at": { "type": "datetime" }
      },
      "hooks": {
        "beforeCreate": [
          {
            "condition": "now() == now()",
            "action": { "mutate": { "stamped_at": { "$cel": "now()" } } }
          }
        ]
      },
      "rules": {
        "list": "created_at > now() - duration('1h')",
        "get": "created_at > now() - duration('1h')",
        "create": "true",
        "update": "created_at > now() - duration('1h')",
        "delete": "created_at > now() - duration('1h')"
      }
    }
  }
}
