<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../src/MMLib.Alvo/build/MMLib.Alvo.props" />

  <ItemGroup>
    <ProjectReference Include="../../src/MMLib.Alvo.TestHost/MMLib.Alvo.TestHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/testhost/*.cs" Link="_shared/testhost/%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)../_shared/testhost/descriptors/*.alvo.json" Link="descriptors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(MSBuildThisFileDirectory)../_shared/ef/SqlCapture.cs" Link="_shared/SqlCapture.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../tools/MMLib.Alvo.Load.Host/CalibrationHooks.cs" Link="_load/CalibrationHooks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <!--
    The typed-entity generator over the shared generated/ descriptors, wired as a packed consumer's build/MMLib.Alvo.props
    and analyzers/dotnet/cs would wire it. desk-v1 is desk-live without legacy_code, for the unknown-field round trip.
    ALVO1001 is silenced: these suites deliberately put banned I/O in hooks to prove the boot ban.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/MMLib.Alvo.Analyzers/MMLib.Alvo.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../_shared/testhost/generated/desk-live.alvo.json" AlvoDescriptor="true" AlvoNamespace="MMLib.Alvo.TestHost.Tests.Generated" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../_shared/testhost/generated/desk-v1.alvo.json" AlvoDescriptor="true" AlvoNamespace="MMLib.Alvo.TestHost.Tests.Generated.V1" />
    <None Include="$(MSBuildThisFileDirectory)../_shared/testhost/generated/desk-live.alvo.json" Link="generated/desk-live.alvo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../_shared/testhost/generated/desk-v1.alvo.json" Link="generated/desk-v1.alvo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);ALVO1001</NoWarn>
  </PropertyGroup>

</Project>
