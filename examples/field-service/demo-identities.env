# The field-service demo's NON-SECRET constants: tenant ids, user ids and the published port.
#
# Read by two consumers so neither has to restate the other's literals:
#   docker compose --env-file examples/field-service/demo-identities.env -f docker-compose.field-service.yml up
#   scripts/test-e2e, which sources it and writes the same values into the TeaPie environment
#
# Nothing secret lives here, and nothing secret may be added. A tenant id and a user id are
# *identifiers* — a request body has to carry `tenant_id` on a scoped create, and `assigned_to` names a
# technician by user id, so a test cannot be written without knowing them. The five key secrets are the
# opposite: they are credentials, they are never committed (§2.14), and compose demands them from the
# shell with `${...:?}` so a stack cannot start with an invented one. Shell values win over this file,
# so exporting a variable here overrides it.

ALVO_FS_PORT=8081

ALVO_FS_TENANT_NORTH=7e9a1c00-0001-4000-8000-00000000000a
ALVO_FS_TENANT_SOUTH=7e9a1c00-0002-4000-8000-00000000000b

ALVO_FS_USER_DISPATCHER_NORTH=0a51c4e1-0001-4000-8000-000000000001
ALVO_FS_USER_TECH_NORTH=0a51c4e1-0002-4000-8000-000000000002
ALVO_FS_USER_SPARE_NORTH=0a51c4e1-0003-4000-8000-000000000003
ALVO_FS_USER_DISPATCHER_SOUTH=0a51c4e1-0004-4000-8000-000000000004
ALVO_FS_USER_ADMIN=0a51c4e1-0005-4000-8000-000000000005
