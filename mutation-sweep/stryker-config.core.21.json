{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "MMLib.Alvo.Tests/MMLib.Alvo.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
      "Migrations/Internal/AlvoBootService.cs",
      "Migrations/Internal/AlvoSchemaOptionsConfiguration.cs",
      "Migrations/Internal/DescriptorBootPlan.cs",
      "Migrations/Internal/DescriptorContent.cs",
      "Migrations/Internal/DescriptorHistoryOrder.cs",
      "Migrations/Internal/SchemaStartupDecision.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 57,
      "break": 30
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
