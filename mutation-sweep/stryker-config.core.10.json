{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "MMLib.Alvo.Tests/MMLib.Alvo.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
      "Events/Internal/AutomationCompiler.cs",
      "Events/Internal/ConsoleEmailSender.cs",
      "Events/Internal/DeliveryBackoff.cs",
      "Events/Internal/DeliveryDispatcher.cs",
      "Events/Internal/DeliveryFanOut.cs",
      "Events/Internal/DeliveryLog.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 57,
      "break": 30
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
