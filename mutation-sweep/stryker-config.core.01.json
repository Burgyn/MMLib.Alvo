      "Auth/Internal/AppTokenSecret.cs",
      "Auth/Internal/CallerResolution.cs",
      "Auth/Internal/CallerResolvers.cs",
      "Auth/Internal/InMemoryApiKeyStore.cs",
      "Auth/Internal/MembershipResolution.cs",
      "Auth/Internal/NoBootstrapAdmin.cs",
      "Auth/Internal/PersonSessionKey.cs",
      "Auth/Internal/PresentedCredential.cs",
