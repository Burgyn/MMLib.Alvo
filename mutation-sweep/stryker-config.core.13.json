{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "MMLib.Alvo.Tests/MMLib.Alvo.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
      "Extensions/AlvoExtensionBuilderExtensions.cs",
      "Extensions/AlvoExtensionOptions.cs",
      "Extensions/AlvoHandlerOptions.cs",
      "Extensions/AlvoHookOptions.cs",
      "Extensions/AlvoOrdering.cs",
      "Extensions/AlvoRetirement.cs",
      "Extensions/AlvoRetryPolicy.cs",
      "Extensions/AlvoRunAs.cs",
      "Extensions/Internal/AlvoDeliveryOptionsConfiguration.cs",
      "Extensions/Internal/AlvoExtensionOptionsConfiguration.cs",
      "Extensions/Internal/AlvoSessions.cs",
      "Extensions/Internal/ConditionTranslator.Calls.cs",
      "Extensions/Internal/ConditionTranslator.Enums.cs",
      "Extensions/Internal/ConditionTranslator.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 57,
      "break": 30
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
