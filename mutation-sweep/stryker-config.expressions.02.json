{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "MMLib.Alvo.Tests/MMLib.Alvo.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
      "Expressions/Internal/CelFunctionBudget.cs",
      "Expressions/Internal/CelFunctionBudgetPolicy.cs",
      "Expressions/Internal/CelFunctionCatalog.cs",
      "Expressions/Internal/CelFunctionException.cs",
      "Expressions/Internal/CelFunctionRegistration.cs",
      "Expressions/Internal/CelHookArithmetic.cs",
      "Expressions/Internal/CelInterpreter.cs",
      "Expressions/Internal/CelLexer.cs"
    ],
    "thresholds": {
      "high": 96,
      "low": 92,
      "break": 30
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
