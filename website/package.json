{
  "name": "alvo-website",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "gen": "dotnet run --project ../tools/MMLib.Alvo.DocsGen -- --site .",
    "dev": "npm run sync:tokens && npm run gen && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "prebuild": "npm run sync:tokens && npm run gen",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:ux": "node scripts/ux-check.mjs",
    "check:lighthouse": "node scripts/lighthouse-check.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8",
    "rehype-mermaid": "3.0.0",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "starlight-openapi": "0.27.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "playwright": "1.64.0"
  },
  "overrides": {
    "httpsnippet": {
      "form-data": "4.0.6"
    }
  }
}
