---
// The hero (design B2): the pitch on the left; on the right, four steps from a prompt to a running backend, lit in turn
// by a CSS-only loop. The loop changes only colours and a transform, so it never moves the layout, and every card is
// readable in every frame. Without motion (prefers-reduced-motion) it is the final frame: every card, the last lit.
// The pause control is a checkbox, so it works without JavaScript (WCAG 2.2.2: the loop lasts longer than 5 s).
import { page } from '../../lib/links';
import descriptor from '../../snippets/landing/hero/help-desk.alvo.json?raw';

type Tone = 'key' | 'str' | 'acc' | 'dim';
type Token = { text: string; tone?: Tone };

const tickets = JSON.parse(descriptor).entities.tickets;
const onCreate = tickets.hooks.afterCreate[0];
const q = (value: unknown) => JSON.stringify(value);
const k = (key: string): Token => ({ text: q(key), tone: 'key' });
const s = (value: string, tone: Tone = 'str'): Token => ({ text: q(value), tone });
const t = (text: string): Token => ({ text });
const inline = (value: Record<string, string>): Token[] => [
  ...Object.entries(value).flatMap(([key, v], i) => [t(i ? ', ' : '{ '), k(key), t(': '), s(v)]),
  t(' }'),
];

// The descriptor the prompt asks for, cut down to what the card has room for. Every key and value is read from the
// snippet, which the rings validate against the schema and apply, so the card cannot drift from a descriptor that runs.
const code: Token[][] = [
  [k('tickets'), t(': {')],
  [t('  '), k('audit'), t(`: ${tickets.audit},`)],
  [t('  '), k('fields'), t(': { '), ...Object.keys(tickets.fields).flatMap((f, i) => [t(i ? ', ' : ''), k(f), t(': …')]), t(' },')],
  [t('  '), k('rules'), t(': {')],
  [t('    '), k('list'), t(': '), s(tickets.rules.list, 'acc'), t(',')],
  [t('    '), k('create'), t(': '), s(tickets.rules.create), t(', …')],
  [t('  },')],
  [t('  '), k('hooks'), t(': { '), k('afterCreate'), t(': [{')],
  [t('    '), k('condition'), t(': '), s(onCreate.condition), t(',')],
  [t('    '), k('action'), t(': '), ...inline(onCreate.action), t(' }] }')],
  [t('}')],
];

const tiles = [
  { name: 'CRUD · batch · query', note: '/api/tickets' },
  { name: 'filter · sort · page', note: 'PostgREST syntax' },
  { name: 'access rules', note: 'in the SQL' },
  { name: 'multi-tenancy', note: 'from the API key' },
  { name: 'hooks · webhooks', note: 'via an outbox' },
  { name: 'OpenAPI', note: '/scalar' },
  { name: 'admin dashboard', note: '/admin' },
  { name: 'revisions', note: 'roll back any time' },
];

// The candidates the roadmap page's "What comes after" names, in its words.
const coming = ['automation', 'custom functions', 'sign-in providers', 'realtime', 'file storage', 'dynamic entities'];
---
<section class="alvo-hero" aria-labelledby="_top">
  <div class="alvo-hero__grid alvo-wrap">
    <div class="alvo-hero__pitch">
      <p class="alvo-hero__eyebrow"><span>.NET-native backend-as-a-service</span> <span class="alvo-hero__status">· pre-v0.1</span></p>
      <h1 id="_top">Write the schema. <span class="alvo-hero__accent">The backend is done.</span></h1>
      <p class="alvo-hero__lead">
        One JSON descriptor holds your entities, access rules, hooks and webhooks. You write it, or your coding agent
        does: every refusal names the key at fault and, where it can, the fix. Apply it, and Alvo serves the whole
        backend.
      </p>
      <div class="alvo-cta-row">
        <a class="alvo-btn alvo-btn--primary" href={page('/start-here/quick-start/')}>Quick start <span aria-hidden="true">→</span></a>
        <a class="alvo-btn alvo-btn--ghost" href={page('/start-here/coding-agents/')}>With a coding agent</a>
      </div>
      <p class="alvo-hero__foot">
        <span>no controllers · no migrations to write · no queue code</span>
        <span>docker compose up, or AddAlvo() in your host</span>
      </p>
    </div>

    <div class="alvo-build">
      <ol class="alvo-build__steps" aria-label="From a prompt to a running backend">
        <li class="alvo-step alvo-step--1">
          <p class="alvo-step__label"><span class="alvo-step__n" aria-hidden="true">1</span>you ask your agent</p>
          <p class="alvo-step__prompt">“Build a help desk on Alvo: tickets with a title and a priority. Agents see only their own tickets. Post high-priority ones to our ops board.”</p>
        </li>
        <li class="alvo-step alvo-step--2">
          <p class="alvo-step__label"><span class="alvo-step__n" aria-hidden="true">2</span>it writes one file · help-desk.alvo.json</p>
          <pre class="alvo-step__code" tabindex="0" aria-label="An excerpt of help-desk.alvo.json"><code>{code.map((line) => (
            <span class="alvo-step__line">{line.map((token) => token.tone ? <span class={`alvo-tk alvo-tk--${token.tone}`}>{token.text}</span> : token.text)}</span>
          ))}</code></pre>
        </li>
        <li class="alvo-step alvo-step--3">
          <p class="alvo-step__label"><span class="alvo-step__n" aria-hidden="true">3</span>apply · revision 1</p>
          <pre class="alvo-step__code" tabindex="0" aria-label="What the apply does"><code><span class="alvo-step__line">CREATE TABLE "tickets" (…)</span><span class="alvo-step__line"><span class="alvo-tk alvo-tk--dim">-- and each rule compiled to a SQL predicate</span></span></code></pre>
        </li>
        <li class="alvo-step alvo-step--4">
          <div class="alvo-step__head">
            <p class="alvo-step__label"><span class="alvo-step__n" aria-hidden="true">4</span>running</p>
            <p class="alvo-step__claim">A full REST API. A complete backend.</p>
          </div>
          <ul class="alvo-tiles">
            {tiles.map((tile) => (
              <li><span>{tile.name}</span><span class="alvo-tiles__note">{tile.note}</span></li>
            ))}
          </ul>
        </li>
      </ol>
      <div class="alvo-coming">
        <p class="alvo-coming__label">coming after v0.1</p>
        <ul class="alvo-coming__list" aria-label="Planned after v0.1">
          {coming.map((item) => <li>{item}</li>)}
        </ul>
        <a class="alvo-coming__link" href={page('/project/roadmap/')}>Roadmap <span aria-hidden="true">→</span></a>
      </div>
      <div class="alvo-build__bar">
        <p class="alvo-build__note">An illustration. The descriptor lines are read from a descriptor the test suite applies.</p>
        <input class="alvo-build__toggle sr-only" type="checkbox" id="alvo-build-pause" />
        <label class="alvo-build__pause" for="alvo-build-pause">
          <svg class="alvo-build__icon-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="3" height="9" rx="0.5" fill="currentColor"></rect><rect x="7" y="1.5" width="3" height="9" rx="0.5" fill="currentColor"></rect></svg>
          <svg class="alvo-build__icon-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5 L10 6 L3 10.5 Z" fill="currentColor"></path></svg>
          <span>Pause animation</span>
        </label>
      </div>
    </div>
  </div>
</section>
