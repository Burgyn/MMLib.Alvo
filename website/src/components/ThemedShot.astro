---
import { Image } from 'astro:assets';
interface Props { light: ImageMetadata; dark: ImageMetadata; alt: string; caption?: string }
const { light, dark, alt, caption } = Astro.props;
const sizes = '(min-width: 72rem) 46rem, 100vw';
---
<figure class="alvo-themed-shot">
  <Image src={light} alt={alt} widths={[720, 1440]} sizes={sizes} class="alvo-themed-shot__img alvo-themed-shot__img--light" />
  <Image src={dark} alt={alt} widths={[720, 1440]} sizes={sizes} class="alvo-themed-shot__img alvo-themed-shot__img--dark" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .alvo-themed-shot { margin: 1.5rem 0; }
  .alvo-themed-shot__img {
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }
  .alvo-themed-shot__img--dark { display: none; }
  :global(:root[data-theme='dark']) .alvo-themed-shot__img--dark { display: block; }
  :global(:root[data-theme='dark']) .alvo-themed-shot__img--light { display: none; }
  figcaption { margin-top: 0.5rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
