---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const primary = [
  { label: 'Docs', href: '/MMLib.Alvo/start-here/why-alvo/' },
  { label: 'Reference', href: '/MMLib.Alvo/reference/', group: 'Reference' },
  { label: 'Examples', href: '/MMLib.Alvo/examples/' },
  { label: 'Roadmap', href: '/MMLib.Alvo/project/roadmap/' },
];

const { entry, sidebar } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const isSplash = entry.data.template === 'splash';

type Item = (typeof sidebar)[number];
const holdsCurrent = (item: Item): boolean =>
  item.type === 'link' ? item.isCurrent : item.entries.some(holdsCurrent);
const currentGroup = sidebar.find((item) => item.type === 'group' && holdsCurrent(item))?.label;
type Link = (typeof primary)[number];
const inSection = (link: Link) =>
  path.startsWith(link.href) || ('group' in link && link.group === currentGroup);
const fallback = !isSplash && !primary.slice(1).some(inSection);
const current = (link: Link, index: number) => {
  if (path === link.href) return 'page';
  if (inSection(link) || (index === 0 && fallback)) return 'true';
  return undefined;
};
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav aria-label="Primary" class="alvo-primary-nav print:hidden">
    {primary.map((link, index) => (
      <a href={link.href} aria-current={current(link, index)}>{link.label}</a>
    ))}
  </nav>
  <div class="sl-flex print:hidden alvo-search">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
  {isSplash && (
    <div class="alvo-sheet-host md:sl-hidden print:hidden">
      <button class="alvo-sheet-toggle" type="button" popovertarget="alvo-sheet" aria-label="Menu">
        <svg class="alvo-sheet-toggle__open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
        <svg class="alvo-sheet-toggle__close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
      </button>
      <div id="alvo-sheet" class="alvo-sheet" popover>
        <nav aria-label="Menu" class="alvo-sheet__nav">
          {primary.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <div class="alvo-sheet__prefs mobile-preferences">
          <div class="social-icons"><SocialIcons /></div>
          <ThemeSelect />
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .header {
    display: flex;
    gap: 8px;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    flex: none;
  }
  .title-wrapper :global(.site-title) {
    gap: 10px;
    min-height: 44px;
    padding-inline-end: 8px;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .title-wrapper :global(.site-title img) { height: 30px; }

  .alvo-primary-nav {
    display: none;
    align-items: center;
    gap: 2px;
    margin-inline-start: 16px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .alvo-primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    color: var(--dim);
    text-decoration: none;
  }
  .alvo-primary-nav a:hover { color: var(--text); background-color: var(--panel2); }
  .alvo-primary-nav a[aria-current] { color: var(--text); font-weight: 600; }
  .alvo-primary-nav a[aria-current]::after {
    content: '';
    position: absolute;
    inset-inline: 12px;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--accent);
  }
  @media (min-width: 64rem) {
    .alvo-primary-nav { display: flex; }
  }

  .alvo-search { margin-inline-start: auto; }

  /* The landing has no sidebar, so no Starlight drawer: below md it gets this sheet instead (spec §4.3:
     logo · search · menu, and the menu carries the navigation, GitHub and the theme control). */
  .alvo-sheet-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .alvo-sheet-toggle:hover { background-color: var(--panel2); }
  .alvo-sheet-toggle__close { display: none; }
  .alvo-sheet-host:has(.alvo-sheet:popover-open) .alvo-sheet-toggle { background-color: var(--panel2); }
  .alvo-sheet-host:has(.alvo-sheet:popover-open) .alvo-sheet-toggle__open { display: none; }
  .alvo-sheet-host:has(.alvo-sheet:popover-open) .alvo-sheet-toggle__close { display: block; }
  .alvo-sheet {
    inset: var(--sl-nav-height) 0 auto 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 8px var(--alvo-gutter) 20px;
    border: 0;
    border-bottom: 1px solid var(--border);
    background-color: var(--bg);
    color: var(--text);
    box-shadow: var(--shadow-pop);
  }
  .alvo-sheet::backdrop { background: transparent; }
  .alvo-sheet__nav { display: grid; }
  .alvo-sheet__nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 4px;
    border-bottom: 1px solid var(--border);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .alvo-sheet__nav a:hover { color: var(--accentInk); }
  .alvo-sheet__prefs { margin-top: 16px; padding: 0; border-bottom: 0; }
  .alvo-search :global(button[data-open-modal]) {
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0;
    border-color: transparent;
    border-radius: var(--radius-sm);
    color: var(--dim);
    font-size: 1.25rem;
  }
  .alvo-search :global(button[data-open-modal]:hover) { color: var(--text); background-color: var(--panel2); }
  @media (min-width: 50rem) {
    .alvo-search :global(button[data-open-modal]) {
      justify-content: flex-start;
      gap: 8px;
      width: 15rem;
      max-width: none;
      height: 40px;
      min-height: 40px;
      padding-inline: 12px 8px;
      border-color: var(--alvo-control-border);
      background-color: var(--panel);
      color: var(--faint);
      font-size: 0.875rem;
    }
    .alvo-search :global(button[data-open-modal]:hover) {
      border-color: var(--text);
      background-color: var(--panel);
      color: var(--dim);
    }
    .alvo-search :global(button[data-open-modal] > kbd) {
      padding: 1px 6px;
      border: 1px solid var(--border2);
      border-radius: var(--radius-xs);
      background-color: transparent;
      color: var(--dim);
      font-family: var(--font-ibm-plex-mono);
      font-size: var(--text-xs);
      gap: 0.4em;
    }
    .alvo-search :global(button[data-open-modal] > kbd kbd) { font-family: inherit; }
    .alvo-search :global(button[data-open-modal]:focus-visible) {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accentSoft);
    }
  }
  @media (min-width: 72rem) {
    .alvo-search :global(button[data-open-modal]) { width: 280px; margin-inline-end: 6px; }
  }

  .right-group,
  .social-icons {
    gap: 4px;
    align-items: center;
  }
  .right-group :global(.social-icons a) {
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-radius: var(--radius-sm);
    color: var(--dim);
  }
  .right-group :global(.social-icons a:hover) { color: var(--text); background-color: var(--panel2); }
  .right-group :global(.social-icons a svg) { width: 20px; height: 20px; }

  .right-group :global(starlight-theme-select label) {
    width: 52px;
    height: 44px;
  }
  .right-group :global(starlight-theme-select select) {
    width: 52px;
    padding: 0;
    color: transparent;
  }
  .right-group :global(starlight-theme-select option) { color: var(--text); }
  .right-group :global(starlight-theme-select .label-icon) {
    inset-inline-start: 11px;
    font-size: 18px;
    width: 18px;
    height: 18px;
  }
  .right-group :global(starlight-theme-select .caret) {
    inset-inline-end: 6px;
    font-size: 14px;
    width: 14px;
    height: 14px;
  }
</style>
