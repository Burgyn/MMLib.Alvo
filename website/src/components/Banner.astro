---
const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

{!isSplash && (
  <div class="alvo-banner" role="note" data-pagefind-ignore>
    <span class="alvo-banner__long">Alvo is pre-v0.1: no NuGet package or container image is published yet.</span>
    <span class="alvo-banner__short">Pre-v0.1: nothing is published yet.</span>
    <a href="/MMLib.Alvo/project/roadmap/">Roadmap and status</a>
  </div>
)}
