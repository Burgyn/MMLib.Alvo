---
import { page } from '../lib/links';
const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

{!isSplash && (
  <div class="alvo-banner" role="note" data-pagefind-ignore>
    <span class="alvo-banner__long">Alvo is pre-v0.1: the image runs from its edge tag, and no NuGet package or release is published yet.</span>
    <span class="alvo-banner__short">Pre-v0.1: no release yet.</span>
    <a href={page('/project/roadmap/')}>Roadmap and status</a>
  </div>
)}
