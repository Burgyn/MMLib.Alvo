---
import { Code } from '@astrojs/starlight/components';
import { statusTone } from '../lib/status';
interface Props { name: string; steps?: number[]; form?: 'curl' | 'http'; fields?: string[] }
interface CapturedStep { curl: string; httpRequest: string; status: number; reason: string; httpResponse: string; responseBody: Record<string, unknown> | null }
interface CapturedExchange { name: string; steps: CapturedStep[] }
const { name, steps, form = 'curl', fields } = Astro.props;
if (!name) throw new Error('Exchange: the "name" prop is required');
const all = import.meta.glob<CapturedExchange>('../generated/exchanges/**/*.json', { eager: true, import: 'default' });
const exchange = all[`../generated/exchanges/${name}.json`];
if (!exchange) throw new Error(`Exchange: no captured exchange "${name}" (run npm run gen)`);
const chosen = (steps ?? exchange.steps.map((_, i) => i)).map((i) => {
  if (!exchange.steps[i]) throw new Error(`Exchange: "${name}" has no step ${i}`);
  return exchange.steps[i];
});
const pick = (step: CapturedStep, f: string) => {
  if (!step.responseBody || !(f in step.responseBody)) throw new Error(`Exchange: "${name}" has no response field "${f}"`);
  return [f, step.responseBody[f]];
};
const body = (step: CapturedStep) => fields ? JSON.stringify(Object.fromEntries(fields.map((f) => pick(step, f))), null, 2) : null;
const response = (step: CapturedStep) => {
  const projected = body(step);
  return projected ? step.httpResponse.split('\n\n')[0] + '\n\n' + projected : step.httpResponse;
};
---
{chosen.map((step) => (
  <div class="alvo-exchange">
    <Code code={form === 'curl' ? step.curl : step.httpRequest} lang={form === 'curl' ? 'sh' : 'http'} title="Request" />
    <p class="alvo-exchange__status"><span class={`alvo-status alvo-status--${statusTone(step.status)}`}>{step.status} {step.reason}</span></p>
    <Code code={response(step)} lang="http" title="Response" />
  </div>
))}
