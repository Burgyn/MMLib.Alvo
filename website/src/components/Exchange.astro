---
import { Code } from '@astrojs/starlight/components';
import { statusTone } from '../lib/status';
import { capturedExchange, type CapturedStep } from '../lib/exchanges';
interface Props {
  name: string; steps?: number[]; form?: 'curl' | 'http'; fields?: string[];
  /** One borderless pane: the request, the status, then the response body alone (no titles, no response headers). */
  compact?: boolean;
  /** false drops the request body (a long one shown elsewhere); the request line and headers stay. */
  requestBody?: boolean;
  wrap?: boolean;
}
const { name, steps, form = 'curl', fields, compact = false, requestBody = true, wrap } = Astro.props;
if (!name) throw new Error('Exchange: the "name" prop is required');
if (!requestBody && form === 'curl') throw new Error(`Exchange: "${name}" can drop the request body only in the http form`);
const exchange = capturedExchange(name);
if (steps && steps.length === 0) throw new Error(`Exchange: "${name}" was given an empty steps list`);
const chosen = (steps ?? exchange.steps.map((_, i) => i)).map((i) => {
  if (!exchange.steps[i]) throw new Error(`Exchange: "${name}" has no step ${i}`);
  return exchange.steps[i];
});
const pick = (step: CapturedStep, f: string) => {
  if (!step.responseBody || !(f in step.responseBody)) throw new Error(`Exchange: "${name}" has no response field "${f}"`);
  return [f, step.responseBody[f]];
};
const body = (step: CapturedStep) => fields ? JSON.stringify(Object.fromEntries(fields.map((f) => pick(step, f))), null, 2) : null;
const head = (message: string) => message.split('\n\n')[0];
const tail = (message: string) => message.split('\n\n').slice(1).join('\n\n');
const request = (step: CapturedStep) => {
  if (form === 'curl') return step.curl;
  const message = requestBody ? step.httpRequest : head(step.httpRequest);
  return compact ? message.replace(/ HTTP\/1\.1$/m, '') : message;
};
const response = (step: CapturedStep) => {
  const projected = body(step);
  if (compact) return projected ?? tail(step.httpResponse);
  return projected ? head(step.httpResponse) + '\n\n' + projected : step.httpResponse;
};
const frame = compact ? 'none' : undefined;
---
{chosen.map((step) => (
  <div class:list={['alvo-exchange', { 'alvo-exchange--compact': compact }]}>
    <Code code={request(step)} lang={form === 'curl' ? 'sh' : 'http'} title={compact ? undefined : 'Request'} frame={frame} wrap={wrap} />
    <p class="alvo-exchange__status"><span class={`alvo-status alvo-status--${statusTone(step.status)}`}>{step.status} {step.reason}</span></p>
    {response(step) && <Code code={response(step)} lang={compact ? 'json' : 'http'} title={compact ? undefined : 'Response'} frame={frame} wrap={wrap} />}
  </div>
))}
