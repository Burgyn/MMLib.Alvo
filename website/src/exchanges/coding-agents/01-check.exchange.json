      "bodyFileAs": "descriptorJson",
      "body": { "path": "/entities/tickets/rules/update", "source": "'agnet' in @user.roles" },
      "expect": 200
    },
    {
      "key": "admin",
      "method": "POST",
      "path": "/management/projects/help-desk/cel/check",
      "bodyFile": "website/src/snippets/coding-agents/02-add-field.alvo.json",
      "bodyFileAs": "descriptorJson",
      "body": { "path": "/entities/tickets/rules/update", "source": "'agent' in @user.roles || 'admin' in @user.roles" },
      "expect": 200
    }
  ]
