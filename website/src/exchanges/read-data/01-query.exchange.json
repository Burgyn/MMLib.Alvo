{
  "descriptor": "examples/vehicle-registry/vehicles.alvo.json",
  "keys": {
    "demo": {
      "roles": [
        "admin",
        "authenticated",
        "inspector"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_DEMO_KEY_SECRET"
    }
  },
  "steps": [
    {
      "key": "demo",
      "method": "PUT",
      "path": "/api/owners/2c4e6a80-1b3d-4f5a-8c7e-9d0f1a2b3c4d",
      "body": {
        "name": "Fleet Desk Ltd",
        "email": "office@fleetdesk.example"
      },
      "expect": 201
    },
    {
      "key": "demo",
      "method": "POST",
      "path": "/api/vehicles/batch",
      "body": {
        "rows": [
          {
            "vin": "TMBJJ7NE8L0123456",
            "plate": "BA-101AA",
            "make": "Skoda",
            "model": "Octavia",
            "year": 2020,
            "color": "red",
            "owner_id": "2c4e6a80-1b3d-4f5a-8c7e-9d0f1a2b3c4d"
          },
          {
            "vin": "TMBEG7NJ1N0234567",
            "plate": "BA-202BB",
            "make": "Skoda",
            "model": "Fabia",
            "year": 2022,
            "color": "blue",
            "owner_id": "2c4e6a80-1b3d-4f5a-8c7e-9d0f1a2b3c4d"
          },
          {
            "vin": "WVWZZZAUZKW345678",
            "plate": "KE-303CC",
            "make": "Volkswagen",
            "model": "Golf",
            "year": 2019,
            "color": "red",
            "owner_id": "2c4e6a80-1b3d-4f5a-8c7e-9d0f1a2b3c4d"
          },
          {
            "vin": "WVWZZZ3CZPE456789",
            "plate": "KE-404DD",
            "make": "Volkswagen",
            "model": "Passat",
            "year": 2023,
            "owner_id": "2c4e6a80-1b3d-4f5a-8c7e-9d0f1a2b3c4d"
          },
          {
            "vin": "VF1RJA00X67567890",
            "plate": "ZA-505EE",
            "make": "Renault",
            "model": "Clio",
            "year": 2017,
            "color": "white",
            "owner_id": "2c4e6a80-1b3d-4f5a-8c7e-9d0f1a2b3c4d"
          }
        ]
      },
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?make=eq.Skoda&year=gte.2021&select=plate,make,model,year",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?or=(color.eq.red,color.eq.blue)&select=plate,make,color",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?color=is.null&select=plate,color",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?model=ilike.%25a%25&select=plate,model",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?order=color.desc.nullsfirst,year&select=plate,color,year",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?select=plate,label:make",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?order=year.desc&limit=2&select=plate,year",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?order=year.desc&limit=2&select=plate,year&after={8.body.next}",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?make=eq.Skoda&limit=1&select=plate",
      "headers": {
        "Prefer": "count=exact"
      },
      "expect": 200
    },
    {
      "key": "demo",
      "method": "POST",
      "path": "/api/vehicles/query",
      "body": {
        "make": "in.(Skoda,Renault)",
        "model": "ilike.%a%",
        "order": "year",
        "select": "plate,make,model,year"
      },
      "expect": 200
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?colour=eq.red&limit=500",
      "expect": 422,
      "expectType": "malformed-query"
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?year=like.20%25",
      "expect": 422,
      "expectType": "malformed-query"
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/vehicles?not.make=eq.Skoda&or=(not.color.eq.red,year.gte.2023)&select=plate,make,color,year",
      "expect": 200
    }
  ]
}
