{
  "descriptor": "website/src/snippets/after-hooks-and-webhooks/01-webhook.alvo.json",
  "keys": {
    "agent": {
      "roles": [
        "agent",
        "authenticated"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_AGENT_KEY_SECRET",
      "user": "3f2b8c1e-7a4d-4e9b-9c21-5d6e7f8a9b01"
    }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "Server room is flooding",
        "priority": "high"
      },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "PATCH",
      "path": "/api/tickets/{0.body.id}",
      "body": {
        "status": "closed",
        "resolution": "Pumped out; the drain is cleared."
      },
      "expect": 200
    }
  ]
}
