{
  "descriptor": "website/src/snippets/before-hooks/02-mutate.alvo.json",
  "keys": {
    "agent": {
      "roles": [
        "agent",
        "authenticated"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_AGENT_KEY_SECRET",
      "user": "3f2b8c1e-7a4d-4e9b-9c21-5d6e7f8a9b01"
    }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "  Printer on fire  ",
        "estimate_hours": 2.5
      },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "PATCH",
      "path": "/api/tickets/{0.body.id}",
      "body": {
        "status": "closed",
        "resolution": "Replaced the fuser unit."
      },
      "expect": 200
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "The third-floor printer prints every page twice since Monday"
      },
      "expect": 403,
      "expectType": "forbidden"
    }
  ]
}
