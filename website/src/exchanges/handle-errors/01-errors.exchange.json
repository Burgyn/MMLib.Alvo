{
  "descriptor": "website/src/snippets/handle-errors/01-help-desk.alvo.json",
  "keys": {
    "agent": {
      "roles": [
        "agent",
        "authenticated"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_AGENT_KEY_SECRET",
      "user": "3f2b8c1e-7a4d-4e9b-9c21-5d6e7f8a9b01"
    },
    "admin": {
      "roles": [
        "admin",
        "authenticated"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_ADMIN_KEY_SECRET",
      "user": "8d4e2a6c-1b3f-4c5d-8e7a-9f0b1c2d3e02"
    },
    "reader": {
      "roles": [
        "agent",
        "authenticated"
      ],
      "scopes": [
        "*:read"
      ],
      "secretVariable": "ALVO_READER_KEY_SECRET",
      "user": "5a1d0c3e-2f4b-4a6c-9d8e-7f6a5b4c3d03"
    }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "Printer on fire",
        "priority": "high"
      },
      "expect": 422,
      "expectType": "validation"
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "Printer on fire"
      },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "PATCH",
      "path": "/api/tickets/{1.body.id}",
      "body": {
        "status": "closed"
      },
      "expect": 403,
      "expectType": "forbidden"
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "The third-floor printer prints every page twice since Monday"
      },
      "expect": 403,
      "expectType": "forbidden"
    },
    {
      "key": "admin",
      "method": "DELETE",
      "path": "/api/tickets/{1.body.id}",
      "expect": 403,
      "expectType": "forbidden"
    },
    {
      "key": null,
      "method": "GET",
      "path": "/api/tickets",
      "expect": 403,
      "expectType": "forbidden"
    },
    {
      "key": "reader",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "Printer on fire"
      },
      "expect": 403,
      "expectType": "out-of-scope"
    },
    {
      "key": "reader",
      "method": "GET",
      "path": "/api/tickets",
      "expect": 200
    },
    {
      "key": "admin",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "Renew the TLS certificate"
      },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "GET",
      "path": "/api/tickets/{8.body.id}",
      "expect": 404,
      "expectType": "not-found"
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "contentType": "text/plain",
      "body": {
        "title": "Printer on fire"
      },
      "expect": 415,
      "expectType": "unsupported-media-type",
      "showHeaders": [
        "Accept-Post"
      ]
    },
    {
      "key": "agent",
      "method": "GET",
      "path": "/api/tickets",
      "wrongSecret": true,
      "expect": 401,
      "expectType": "unauthenticated"
    }
  ]
}
