{
  "descriptor": "website/src/snippets/access-rules/01-roles.alvo.json",
  "keys": {
    "agent": {
      "roles": [
        "agent",
        "authenticated"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_AGENT_KEY_SECRET",
      "user": "3f2b8c1e-7a4d-4e9b-9c21-5d6e7f8a9b01"
    },
    "admin": {
      "roles": [
        "admin",
        "authenticated"
      ],
      "scopes": [
        "*:read",
        "*:write"
      ],
      "secretVariable": "ALVO_ADMIN_KEY_SECRET",
      "user": "8d4e2a6c-1b3f-4c5d-8e7a-9f0b1c2d3e02"
    }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/queues",
      "body": {
        "name": "Hardware"
      },
      "expect": 403,
      "expectType": "forbidden"
    },
    {
      "key": "admin",
      "method": "POST",
      "path": "/api/queues",
      "body": {
        "name": "Hardware"
      },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "GET",
      "path": "/api/queues",
      "expect": 200
    },
    {
      "key": "agent",
      "method": "DELETE",
      "path": "/api/queues/{1.body.id}",
      "expect": 404,
      "expectType": "not-found"
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": {
        "title": "Printer on fire"
      },
      "expect": 201
    },
    {
      "key": "admin",
      "method": "DELETE",
      "path": "/api/tickets/{4.body.id}",
      "expect": 403,
      "expectType": "forbidden"
    }
  ]
}
