{
  "descriptor": "website/src/snippets/entities-and-fields/01-basic.alvo.json",
  "keys": {
    "agent": { "roles": ["agent", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_AGENT_KEY_SECRET" },
    "admin": { "roles": ["admin", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_ADMIN_KEY_SECRET" }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/customers",
      "body": { "name": "Northwind Traders", "email": "it@northwind.example", "phone": "+421 2 1234 5678" },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/customers",
      "body": { "email": "help@contoso.example", "phone": "+421 2 1234 5678 ext. 9012" },
      "expect": 422,
      "expectType": "validation"
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/customers",
      "body": { "name": "Northwind (duplicate)", "email": "it@northwind.example" },
      "expect": 409,
      "expectType": "conflict"
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/customers",
      "body": { "name": "Contoso", "email": "help@contoso.example", "credit_limit": 5000 },
      "expect": 422,
      "expectType": "validation"
    },
    {
      "key": "admin",
      "method": "POST",
      "path": "/api/customers",
      "body": { "name": "Contoso", "email": "help@contoso.example", "credit_limit": 5000, "internal_note": "Pays late; call before renewing." },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "GET",
      "path": "/api/customers/{4.body.id}",
      "expect": 200
    }
  ]
}
