{
  "descriptor": "website/src/snippets/entities-and-fields/02-ref.alvo.json",
  "keys": {
    "agent": { "roles": ["agent", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_AGENT_KEY_SECRET" },
    "admin": { "roles": ["admin", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_ADMIN_KEY_SECRET" }
  },
  "steps": [
    {
      "key": "admin",
      "method": "PUT",
      "path": "/api/customers/0b7f3c1e-5a2d-4e8b-9c6f-1d2e3f4a5b6c",
      "body": { "name": "Northwind Traders", "email": "it@northwind.example" },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": { "title": "VPN drops every hour", "customer_id": "0b7f3c1e-5a2d-4e8b-9c6f-1d2e3f4a5b6c" },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": { "title": "Printer offline", "customer_id": "9a8b7c6d-0000-4000-8000-000000000000" },
      "expect": 422,
      "expectType": "validation"
    },
    {
      "key": "admin",
      "method": "DELETE",
      "path": "/api/customers/0b7f3c1e-5a2d-4e8b-9c6f-1d2e3f4a5b6c",
      "expect": 409,
      "expectType": "conflict"
    }
  ]
}
