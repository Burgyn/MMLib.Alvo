{
  "descriptor": "website/src/snippets/landing/history/v1.alvo.json",
  "keys": {
    "demo": { "roles": ["admin", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_DEMO_KEY_SECRET" }
  },
  "steps": [
    {
      "key": "demo",
      "method": "GET",
      "path": "/management/projects/helpdesk/descriptor",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "PUT",
      "path": "/management/projects/helpdesk/descriptor",
      "headers": { "If-Match": "\"{0.body.revision}\"" },
      "bodyFile": "website/src/snippets/landing/history/v2.alvo.json",
      "bodyFileAs": "descriptorJson",
      "expect": 200
    },
    {
      "key": "demo",
      "method": "POST",
      "path": "/management/projects/helpdesk/revisions/{0.body.revision}/rollback",
      "headers": { "If-Match": "\"{1.body.revision}\"" },
      "expect": 200
    }
  ]
}
