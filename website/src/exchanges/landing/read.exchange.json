{
  "descriptor": "website/src/snippets/landing/helpdesk.alvo.json",
  "keys": {
    "demo": { "roles": ["authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_DEMO_KEY_SECRET" }
  },
  "steps": [
    {
      "key": "demo",
      "method": "POST",
      "path": "/api/tickets",
      "body": { "title": "Printer on fire", "priority": "high" },
      "expect": 201
    },
    {
      "key": "demo",
      "method": "GET",
      "path": "/api/tickets?priority=eq.high&order=title",
      "expect": 200
    }
  ]
}
