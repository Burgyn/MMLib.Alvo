{
  "descriptor": "website/src/snippets/tutorial/02-rules.alvo.json",
  "keys": {
    "agent": { "roles": ["agent", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_AGENT_KEY_SECRET" },
    "admin": { "roles": ["admin", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_ADMIN_KEY_SECRET" }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": { "title": "Reset my password" },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "DELETE",
      "path": "/api/tickets/{0.body.id}",
      "expect": 404,
      "expectType": "not-found"
    },
    {
      "key": "admin",
      "method": "DELETE",
      "path": "/api/tickets/{0.body.id}",
      "expect": 204
    }
  ]
}
