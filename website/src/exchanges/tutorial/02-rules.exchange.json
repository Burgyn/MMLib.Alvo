{
  "descriptor": "website/src/snippets/tutorial/02-rules.alvo.json",
  "keys": {
    "agent": { "roles": ["agent", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_AGENT_KEY_SECRET", "user": "3f2b8c1e-7a4d-4e9b-9c21-5d6e7f8a9b01" },
    "admin": { "roles": ["admin", "authenticated"], "scopes": ["*:read", "*:write"], "secretVariable": "ALVO_ADMIN_KEY_SECRET", "user": "8d4e2a6c-1b3f-4c5d-8e7a-9f0b1c2d3e02" }
  },
  "steps": [
    {
      "key": "agent",
      "method": "POST",
      "path": "/api/tickets",
      "body": { "title": "Reset my password" },
      "expect": 201
    },
    {
      "key": "agent",
      "method": "DELETE",
      "path": "/api/tickets/{0.body.id}",
      "expect": 404,
      "expectType": "not-found"
    },
    {
      "key": "admin",
      "method": "DELETE",
      "path": "/api/tickets/{0.body.id}",
      "expect": 204
    }
  ]
}
