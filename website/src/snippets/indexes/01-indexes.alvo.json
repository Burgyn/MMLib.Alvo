{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "help-desk",
  "auth": {
    "providers": ["local"],
    "roles": ["admin", "agent"]
  },
  "entities": {
    "tickets": {
      "fields": {
        "queue": {
          "type": "enum", "values": ["billing", "hardware", "software"],
          "required": true
        },
        "number": { "type": "integer", "required": true },
        "title": { "type": "string", "required": true, "maxLength": 120 },
        "status": {
          "type": "enum", "values": ["open", "closed"], "default": "open"
        },
        "assignee_id": { "type": "ref", "entity": "users", "index": true }
      },
      "indexes": [
        { "fields": ["queue", "status"] },
        { "fields": ["queue", "number"], "unique": true }
      ],
      "rules": {
        "list": "'authenticated' in @user.roles",
        "get": "'authenticated' in @user.roles",
        "create": "'agent' in @user.roles || 'admin' in @user.roles",
        "update": "'agent' in @user.roles || 'admin' in @user.roles"
      }
    }
  }
}
