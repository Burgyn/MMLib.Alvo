{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "sales-desk",
  "auth": { "roles": ["staff"] },
  "webhooks": {
    "endpoints": { "crm": { "url": "https://crm.example/hooks/orders", "secretRef": "crm-signing" } }
  },
  "templates": {
    "big-order": { "subject": "Big order {{new.number}}", "body": "Order {{new.number}} totals {{new.total}}." }
  },
  "entities": {
    "orders": {
      "fields": {
        "number": { "type": "string", "required": true, "maxLength": 20 },
        "total": { "type": "decimal", "precision": 12, "scale": 2, "required": true },
        "flagged": { "type": "boolean", "default": false }
      },
      "rules": { "list": "'staff' in @user.roles", "get": "'staff' in @user.roles", "create": "'staff' in @user.roles", "update": "'admin' in @user.roles" }
    }
  },
  "automation": {
    "big-order": {
      "description": "Tells the CRM and sales about a big order, and flags it.",
      "trigger": { "event": "entity.orders.created" },
      "condition": "new.total >= 1000.0",
      "actions": [
        { "type": "webhook", "endpoint": "crm" },
        { "type": "email", "template": "big-order", "to": "sales@example.com" },
        { "type": "entity.update", "entity": "orders", "recordId": "{{new.id}}", "payload": { "flagged": true } }
      ]
    }
  }
}
