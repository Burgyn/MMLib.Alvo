{
  "$schema": "https://alvo.dev/schema/v1/project.json",
  "apiVersion": "alvo.dev/v1",
  "name": "billing-desk",
  "auth": { "roles": ["staff"] },
  "entities": {
    "orders": {
      "fields": {
        "number": { "type": "string", "required": true, "maxLength": 20 },
        "total": { "type": "decimal", "precision": 12, "scale": 2, "required": true }
      },
      "rules": { "list": "'staff' in @user.roles", "get": "'staff' in @user.roles", "create": "'staff' in @user.roles" },
      "hooks": {
        "afterCreate": [
          {
            "condition": "new.total > 0.0",
            "action": {
              "type": "function",
              "name": "issue-invoice",
              "input": { "orderNumber": { "$cel": "new.number" }, "amount": { "$cel": "new.total" }, "currency": "EUR" }
            }
          }
        ]
      }
    }
  }
}
