{
  "stryker-config": {
    "project": "MMLib.Alvo.Data.EntityFrameworkCore.csproj",
    "test-projects": [
      "MMLib.Alvo.Data.Sqlite.Tests/MMLib.Alvo.Data.Sqlite.Tests.csproj",
      "MMLib.Alvo.Accounts.Tests/MMLib.Alvo.Accounts.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "log-to-file": true,
    "additional-timeout": 300000,
    "mutate": [
      "EfCoreAccountStore.cs",
      "EfCoreAccountStore.Sessions.cs",
      "EfCoreAccountStore.Keys.cs",
      "Internal/AuthTables.cs",
      "EfCoreTenantStore.cs",
      "EfCoreTenantStore.Members.cs",
      "Internal/TenantTables.cs",
      "EfCoreTenantStore.Invitations.cs",
      "Internal/InvitationTables.cs",
      "Internal/InvitationAcceptance.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 40,
      "break": 30
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
