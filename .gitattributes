# Line-ending normalization — keeps the dotnet format gate and Git Bash on the
# Windows CI runner stable across platforms.
* text=auto

# Shell scripts MUST stay LF: Git Bash on the Windows runner executes them and
# CRLF breaks the shebang / parsing. scripts/ and .husky/ hold extensionless
# shell scripts (test-ring*, check-brief-freshness, and the Husky hooks
# pre-commit/commit-msg), so pin the whole directories rather than relying on the
# runner's git config. *.ps1 under scripts/ is fine with LF on every platform.
*.sh text eol=lf
scripts/** text eol=lf
.husky/** text eol=lf

# C# sources are CRLF + UTF-8 BOM per .editorconfig; pin the EOL so git does not
# rewrite it under core.autocrlf on Windows.
*.cs text eol=crlf

# Verify snapshots must stay LF on every platform — Verify rejects a verified
# file containing a carriage return (Windows would otherwise check it out CRLF).
*.verified.txt text eol=lf

# Captured Stryker output, kept as evidence for scripts/test-assert-mutation-run.
# NOT normalised: the carriage returns are part of what the tool actually emitted
# (its progress reporter writes \r), and the guard's own \r handling is one of the
# things these fixtures exercise. `scripts/** text eol=lf` above would rewrite them
# to LF and silently retire that case — the same "the test quietly stopped testing"
# failure the guard itself exists to prevent. -text also keeps them byte-identical
# to the capture, which is what their provenance headers claim.
scripts/fixtures/mutation-logs/*.txt -text
