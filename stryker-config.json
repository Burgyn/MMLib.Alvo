{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "MMLib.Alvo.Tests/MMLib.Alvo.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
      "**/*.cs",
      "!**/AssemblyInfo.cs",
      "!**/Internal/AlvoBuilder.cs",
      "!**/Migrations/Internal/FileDescriptorSource.cs",
      "!**/AlvoServiceCollectionExtensions.cs",
      "!**/AlvoBuilderExtensions.cs",
      "!**/Expressions/Setup.cs",
      "!**/Rules/Setup.cs",
      "!**/Auth/Setup.cs",
      "!**/Expressions/**",
      "!**/Api/**",
      "!**/Commands/Internal/CommandEndpointFilter.cs",
      "!**/Commands/Internal/CommandInputs.cs",
      "!**/Commands/Internal/CommandGateCheck.cs",
      "!**/InboundWebhooks/Internal/WebhookReceiver.cs",
      "!**/InboundWebhooks/Internal/LedgerSweeper.cs",
      "!**/Tenants/SelfService/SelfServiceEndpoints.cs",
      "!**/Tenants/SelfService/TenantRoutes.cs",
      "!**/Tenants/SelfService/MemberRoutes.cs",
      "!**/Tenants/SelfService/MemberPatch.cs",
      "!**/Tenants/SelfService/SelfServiceCall.cs",
      "!**/Tenants/SelfService/SelfServicePerson.cs",
      "!**/Tenants/SelfService/SelfServiceBody.cs",
      "!**/Tenants/SelfService/SelfServiceProblems.cs",
      "!**/Tenants/SelfService/SelfServiceMemberships.cs",
      "!**/Tenants/SelfService/MemberResponse.cs",
      "!**/Tenants/SelfService/MembershipResponse.cs",
      "!**/Tenants/SelfService/TenantName.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 57,
      "break": 55
    },
    "reporters": [
      "progress",
      "cleartext",
      "json"
    ]
  }
}
