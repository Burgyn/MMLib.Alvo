{
  "stryker-config": {
    "project": "MMLib.Alvo.csproj",
    "test-projects": [
      "test/MMLib.Alvo.Tests/MMLib.Alvo.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "mutate": [
      "**/*.cs",
      "!**/AssemblyInfo.cs",
      "!**/Schema/SchemaRegistry.cs",
      "!**/Internal/AlvoBuilder.cs",
      "!**/Migrations/Internal/FileDescriptorSource.cs",
      "!**/AlvoServiceCollectionExtensions.cs",
      "!**/AlvoBuilderExtensions.cs",
      "!**/Expressions/Setup.cs",
      "!**/Rules/Setup.cs",
      "!**/Auth/Setup.cs",
      "!**/Expressions/**"
    ],
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 80
    },
    "reporters": [
      "progress",
      "cleartext"
    ]
  }
}
