<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The standalone host (spec §2.14 mode 1, §X.1). Not packable: it is distributed as the
    `mmlib/alvo` container image, not as a NuGet package, so a .nupkg of an entry point would
    publish a surface no consumer references. package-boundary.md records the project and the
    rule that earns it.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mmlib-alvo-host</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Serves /_framework/blazor.web.js.

         The Web SDK turns this on by itself only for a project that contains .razor files
         (Microsoft.NET.Sdk.Web.ProjectSystem.targets: `@(Content->AnyHaveMetadataValue(Extension,
         .razor))`). Every component here lives in MMLib.Alvo.Admin, by design §1.2 — so the host
         maps Blazor's endpoints while owning no component, the heuristic answers "no Blazor", the
         framework's script is left out of the static-web-asset manifest, and the dashboard renders
         once and never becomes interactive. Nothing fails at build time; the symptom is a 404 in
         the browser. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MMLib.Alvo/MMLib.Alvo.csproj" />
    <!-- Both drivers ship in the image: SQLite is the zero-configuration default the deployment
         acceptance criterion names, PostgreSQL is what docker-compose runs. Exactly one is
         *registered*, chosen by configuration in AlvoDatabaseSelector. -->
    <ProjectReference Include="../MMLib.Alvo.Data.Sqlite/MMLib.Alvo.Data.Sqlite.csproj" />
    <ProjectReference Include="../MMLib.Alvo.Data.PostgreSql/MMLib.Alvo.Data.PostgreSql.csproj" />
    <!-- Human identity. A hosting decision, in the one project that is IsPackable=false and
         therefore hands nothing to a NuGet consumer — the same category that already justifies
         Scalar and both database drivers. -->
    <ProjectReference Include="../MMLib.Alvo.Identity/MMLib.Alvo.Identity.csproj" />
    <!-- The dashboard. A hosting decision in the same category as the two above: the standalone
         image ships a console, an embedded host chooses whether to. MMLib.Alvo.Admin itself holds
         no reference to MMLib.Alvo (design §1.2) and an architecture test keeps it that way, so
         this reference is the only place the two halves meet. -->
    <ProjectReference Include="../MMLib.Alvo.Admin/MMLib.Alvo.Admin.csproj" />

    <!-- The schema assistant. The same category again: the standalone image ships one, an embedded
         host chooses whether to. MMLib.Alvo.Ai references only MMLib.Alvo.Abstractions and an
         architecture test keeps it that way, so this reference is where the agent and the core meet.
         Shipping it does not configure it — an image with no AI connection has an assistant that
         resolves to "not configured", and no launcher renders. -->
    <ProjectReference Include="../MMLib.Alvo.Ai/MMLib.Alvo.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct rather than inherited from the core's ProjectReference, because the host calls
         AddOpenApi/MapOpenApi itself. A build target only travels with a direct PackageReference,
         and this package's target is what sets InterceptorsNamespaces for the XML-comment source
         generator AddOpenApi switches on: without the direct reference the generated file is
         emitted and then refused with CS9137. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- The only third-party package the host carries: the docs UI that renders the OpenAPI
         document the core emits. Host-only on purpose — see docs/architecture/host.md, "Docs". -->
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Direct rather than transitive: the host calls UseSqlite/UseNpgsql itself, to configure the
         identity store's DbContext beside the Alvo driver it already selects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
