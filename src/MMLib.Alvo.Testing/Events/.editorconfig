# OutboxStoreContractTests and AlvoEventCriteriaTests are xUnit test code even though they live in src/, not
# test/ — each is inherited by every implementation's own test project, so their [Fact] methods follow the same
# descriptive snake_case convention as test/.editorconfig, for the same reason
# src/MMLib.Alvo.Testing/Migrations/.editorconfig does for DescriptorVersionStoreContractTests. Scoped to those
# files, not the whole folder, so anything else added here still gets the normal naming rule.

[OutboxStoreContractTests.cs]
dotnet_diagnostic.CA1707.severity = none

[AlvoEventCriteriaTests.cs]
dotnet_diagnostic.CA1707.severity = none
