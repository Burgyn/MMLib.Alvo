<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Internal test-support library (fakes, fixtures, and the port contract-suite
    base once ports exist in F3). Referenced only by test projects; not shipped
    yet, so IsPackable=false. Earns a package when external provider authors need
    the contract suite (spec §1.1, package-boundary.md). TFM/Nullable/etc. are
    inherited from Directory.Build.props — do not re-declare here.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The schema-migrator contract-test base (SchemaMigratorContractTests) is a
    public abstract xUnit test class inherited by every provider's own test
    project (Tasks 11-12), so this library needs the test framework and
    assertion library directly — it is not itself covered by
    test/Directory.Build.props, which only applies to projects under test/.
  -->
  <ItemGroup>
    <ProjectReference Include="../MMLib.Alvo.Abstractions/MMLib.Alvo.Abstractions.csproj" />
  </ItemGroup>

  <!--
    InMemoryAlvoData (Task 12) is a reference IAlvoData: it enforces the resolved policy
    predicate per row through the exact same CEL backend a real provider evaluates WITH CHECK
    with — MMLib.Alvo's internal CelInterpreter — rather than re-implementing CEL evaluation a
    second time in this project. A second interpreter would be exactly the kind of divergence
    Task 10's differential suite exists to catch between backends; referencing the one real
    implementation avoids introducing a second one to keep in sync. Granted via
    MMLib.Alvo's own InternalsVisibleTo("MMLib.Alvo.Testing"), the same mechanism
    MMLib.Alvo.Tests already uses to construct PolicyEngine/PolicyCatalogProvider directly.
    This does not weaken the package boundary: neither shared-architecture test constrains this
    project's own dependencies (only MMLib.Alvo's — Abstractions-only — and
    MMLib.Alvo.Abstractions's — nothing), and MMLib.Alvo itself never references this project back.
  -->
  <ItemGroup>
    <ProjectReference Include="../MMLib.Alvo/MMLib.Alvo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!--
    SchemaSqlSnapshotTests (the shared generated-SQL snapshot base) verifies
    against Verify baselines, so this library needs Verify directly — the
    project directory / class-name path derivation still comes from each
    consuming test project's own VerifyModuleInit (test/_shared).
  -->
  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

</Project>
