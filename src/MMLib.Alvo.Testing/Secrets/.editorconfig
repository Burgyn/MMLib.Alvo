# SecretStoreContractTests is xUnit test code even though it lives in src/, not test/ — it is inherited by
# every ISecretStore implementation's own test project, so its [Fact] methods follow the same descriptive
# snake_case convention as test/.editorconfig, for the same reason the Data and Migrations folders do.
# Scoped to that file, so InMemorySecretStore still gets the normal naming rule.

[SecretStoreContractTests.cs]
dotnet_diagnostic.CA1707.severity = none
