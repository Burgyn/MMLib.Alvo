<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Human identity: ASP.NET Core Identity plus its EF stores. Its own package by
    package-boundary.md rule (a) — an embedded host that wants only the Data API must not acquire
    that dependency — and rule (b): identity is a real swap point, already exercised by
    samples/MMLib.Alvo.Samples.EmbeddedHost, which resolves its callers through its own cookie auth
    and IRoleCatalogProvider.
  -->
  <ItemGroup>
    <ProjectReference Include="../MMLib.Alvo.Abstractions/MMLib.Alvo.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

  <!-- The cookie principal and the options/DI surfaces arrive with the framework reference; taking
       Microsoft.Extensions.* as explicit PackageReferences beside it would raise NU1510 ("will not be
       pruned"), which this repository treats as an error — the same reason MMLib.Alvo does not. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
