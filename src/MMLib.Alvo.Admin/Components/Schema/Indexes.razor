@*
    The indexes, and why the list is usually shorter than it looks.

    A unique field carries its own index, so listing it again here would double-count what the
    database actually has.

    It edits the working copy like every other control on this screen — no new write path, the same
    preview and the same apply. Which is the whole design: the one thing an operator reaches for
    after watching a list get slow used to be the one thing they had to leave the dashboard for.
*@
@inject AdminInterop Interop
@inject ManagementGateway Gateway
@inject ILogger<Indexes> Logger
@implements IDisposable

@* A create inside a tab sits in its section's head, right-aligned (spec §3.7), as New field does on Fields. *@
<SectionHead Title="Indexes">
    <Subtitle>
        Declared in the descriptor. A unique field already has one and is not repeated here; a
        single-field index is the <code class="a-mono">index</code> facet on the field itself.
    </Subtitle>
    <Actions>
        @if (Editable)
        {
            <AlvoButton Small="true" data-testid="index-new" OnClick="_ => _adding = true">New index</AlvoButton>
        }
    </Actions>
</SectionHead>

@if (Declared.Count == 0)
{
    <EmptyState Title="No indexes are declared"
                Body="Paging is keyset over the primary key, which is always indexed. Add an index when a filter or a sort runs over a column that is not." />
}
else
{
    @for (var position = 0; position < Declared.Count; position++)
    {
        var index = Declared[position];
        var at = position;

        <ListRow class="a-listrow--inline a-listrow--center" data-testid="index-row" id="@($"index-row-{at}")"
                 data-alvo-new="@(at == _reveal ? "true" : null)">
            @*
                An entry the working copy could not read — an imported or proposed descriptor may carry one,
                and the apply is what refuses it. Shown rather than hidden, and shown in its own position,
                because the only useful thing to do with it is remove it.
            *@
            @if (index.Fields.Count == 0)
            {
                <span class="a-section__sub a-grow a-value" data-testid="index-unreadable">
                    Declared in a shape this screen cannot read. The apply will refuse it — remove it here,
                    or fix it in the descriptor and import it again.
                </span>
            }
            else
            {
                <span class="a-mono a-grow a-value">@string.Join(", ", index.Fields)</span>
            }
            @if (index.Unique)
            {
                <span class="a-badge a-badge--accent">unique</span>
            }
            @if (index.Exclude is { } range)
            {
                <span class="a-badge a-badge--accent" data-testid="index-exclude">no overlap of @range.From–@range.To</span>
            }
            @if (index.Where is { Length: > 0 } where)
            {
                <span class="a-badge a-mono" data-testid="index-where" title="@where">where @Short(where)</span>
            }
            @if (Staged.IsNewIndex(at))
            {
                <span class="a-badge a-badge--accent" data-testid="index-staged">new</span>
            }
            @if (Editable)
            {
                <AlvoButton Tone="AlvoButton.ButtonTone.Ghost" Small="true" data-testid="index-remove"
                            aria-label="@($"Remove the index on {string.Join(", ", index.Fields)}")"
                            OnClick="_ => _removing = index">Remove</AlvoButton>
            }
        </ListRow>
    }
}

@if (_reveal is { } added)
{
    @RevealOnRender.On($"#index-row-{added}", _reveals)
}

@if (_adding)
{
    <AlvoEditor TestId="index-editor" Title="New index" SubmitText="Add to the working copy" SubmitTestId="index-add"
                Subtitle="Pick the fields in the order a query filters on them: an index on (a, b) serves a filter on a, and on a and b, and does nothing for b alone."
                Dirty="@_draft.Dirty" OnSubmit="AddAsync" OnClose="CloseAdding">
        @RefusalPanel.Of(_refusal, "That index cannot be added")

        @*
            The declared fields first — they are what an index is usually for — and the columns Alvo
            maintains after them under their own label, the way the Fields tab lists them. They stay
            pickable: a filter on created_at or tenant_id is exactly what an index serves.
        *@
        <div class="a-stack a-stack--gap-3" data-testid="index-fields">
            <span class="a-label" id="index-fields-label">Fields</span>
            <ChipGroup TValue="string" Items="Names(Declarable)" Selected="_draft.Chosen" Multiple="true"
                       aria-labelledby="index-fields-label" SelectedChanged="Choose" ChipContent="Chip" />

            @if (Maintained.Count > 0)
            {
                <span class="a-label" id="index-maintained-label">Maintained by Alvo</span>
                <ChipGroup TValue="string" Items="Names(Maintained)" Selected="_draft.Chosen" Multiple="true"
                           aria-labelledby="index-maintained-label" data-testid="index-fields-maintained"
                           SelectedChanged="Choose" ChipContent="Chip" />
            }
        </div>

        @* An exclusion already refuses equal fields whose ranges overlap, and the apply refuses the pair. *@
        @if (_draft.UniqueOffered)
        {
            <MudCheckBox T="bool" Value="_draft.Unique" ValueChanged="on => _draft.Unique = on" data-testid="index-unique"
                         Label="Enforce uniqueness across these fields" />
        }

        <MudCheckBox T="bool" Value="_draft.Excludes" ValueChanged="ChooseExcludes" data-testid="index-exclude-overlaps"
                     Label="Exclude overlaps — no two rows with these fields equal may hold overlapping ranges" />

        @if (_draft.Excludes)
        {
            @if (IndexDraft.RangeFields(Entity) is { Count: > 0 } starts)
            {
                <Field Label="Range starts at" LabelId="index-exclude-from">
                    <ChildContent>
                        <ChipGroup TValue="string" Items="starts" Selected="[_draft.From]" aria-labelledby="index-exclude-from"
                                   data-testid="index-exclude-from" SelectedChanged="ChooseFrom" />
                    </ChildContent>
                    <Hint>Inclusive. Offered: the required date and datetime fields a caller writes.</Hint>
                </Field>
                <Field Label="Range ends at" LabelId="index-exclude-to">
                    <ChildContent>
                        <ChipGroup TValue="string" Items="_draft.EndFields(Entity)" Selected="[_draft.To]" aria-labelledby="index-exclude-to"
                                   data-testid="index-exclude-to" SelectedChanged="picked => _draft.To = picked[0]" />
                    </ChildContent>
                    <Hint>
                        Exclusive, and of the start's type: a booking that ends at 12:00 and one that starts at 12:00 do not
                        overlap. A write that would overlap is refused 409; on PostgreSQL the apply needs the btree_gist extension.
                    </Hint>
                </Field>
            }
            else
            {
                <Refusal data-testid="index-exclude-none">
                    <code class="a-mono">@Entity.Name</code> has no required date or datetime field a caller writes, so there is
                    no range to keep from overlapping — add a start and an end on the Fields tab first.
                </Refusal>
            }
        }

        <Field Label="Only where" For="index-where">
            <ChildContent>
                <MudTextField T="string" Variant="Variant.Outlined" Immediate="true" Lines="1" id="index-where"
                              data-testid="index-where-box" Class="a-mono" spellcheck="false"
                              Placeholder="e.g. status != 'cancelled' — leave empty for every row"
                              aria-describedby="@DescribedBy" Value="_draft.Where" ValueChanged="TypeWhere" />
                @Findings
            </ChildContent>
            <Hint>
                CEL over this entity's own fields — only the rows it accepts are indexed, and a unique index is unique among
                them alone. No caller, no now() and no hidden field: the database holds it as DDL.
                @ChordHint.Of("adds the index")
            </Hint>
        </Field>
    </AlvoEditor>
}

<AlvoConfirm Open="_removing is not null" TestId="remove-index" ConfirmTestId="remove-index-run"
             CancelTestId="remove-index-cancel" Title="@RemovalTitle"
             Consequence="It leaves the working copy now; the database drops it when you apply."
             Verb="Remove index" OnConfirm="RemoveAsync" OnCancel="CancelRemoval" />

@code {
    /// <summary>One field to pick, with its position in the index while it is in it.</summary>
    private RenderFragment Chip(string name) => @<text>
        <span class="a-mono">@name</span>
        @if (_draft.Chosen.IndexOf(name) is >= 0 and var order)
        {
            <span class="a-badge">@(order + 1)</span>
        }
    </text>;

    private static List<string> Names(List<FieldSchema> fields) => [.. fields.Select(column => column.Name)];

    private List<FieldSchema> Declarable
        => Entity.Fields.Where(column => !AlvoManagedColumns.For(Entity).Contains(column.Name)).ToList();

    private List<FieldSchema> Maintained
        => Entity.Fields.Where(column => AlvoManagedColumns.For(Entity).Contains(column.Name)).ToList();

    private const string WhereBox = "index-where";
    private const int WhereBadgeLimit = 32;

    private IndexDraft _draft = new();
    private readonly ExpressionCheck _check = new();
    private readonly ComponentLifetime _lifetime = new();
    private readonly RefusalState<string> _refusal = new();
    private bool _adding;
    private IndexSchema? _removing;
    private int? _reveal;
    private int _reveals;

    /// <summary>The entity whose indexes these are — and whose fields an index may cover.</summary>
    [Parameter, EditorRequired]
    public EntitySchema Entity { get; set; } = default!;

    /// <summary>
    /// The indexes to render, as the working copy holds them.
    /// </summary>
    /// <remarks>
    /// Passed in rather than read off <see cref="Entity"/>, because <c>SchemaModel</c> is the
    /// <em>applied</em> schema: an index added here would not appear until the apply, and an editor
    /// whose additions vanish is worse than no editor. The Rules tab records the same finding.
    /// </remarks>
    [Parameter, EditorRequired]
    public IReadOnlyList<IndexSchema> Declared { get; set; } = [];

    /// <summary>Whether this operator has a working copy to edit at all.</summary>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>
    /// What the working copy changed, cascaded by the entity screen — an index only it declares is badged
    /// <c>new</c>, so it reads as staged rather than as already serving queries.
    /// </summary>
    [CascadingParameter]
    private StagedView Staged { get; set; } = StagedView.None;

    /// <summary>
    /// Raised with the index to declare.
    /// </summary>
    /// <remarks>
    /// <see cref="IndexSchema"/> rather than a tuple, because this is a public parameter and a
    /// <c>ValueTuple&lt;IReadOnlyList&lt;string&gt;, bool&gt;</c> in the contract says nothing about which
    /// bool. The record already exists, already means exactly this, and is the shape
    /// <see cref="Declared"/> is read in.
    /// </remarks>
    [Parameter]
    public EventCallback<IndexSchema> OnAdd { get; set; }

    /// <summary>Raised with the position of the index to remove, as <see cref="Declared"/> holds it now.</summary>
    [Parameter]
    public EventCallback<int> OnRemove { get; set; }

    /// <summary>
    /// Takes the fields as the chips now have them, in the order they were picked.
    /// </summary>
    /// <remarks>
    /// A list rather than a set: the schema's <c>fields</c> is ordered and the order is what the index
    /// is for, so the control has to record which was chosen first — which is also why each chip shows
    /// its position rather than only whether it is on. Both groups share the one list, so a maintained
    /// column can follow a declared one.
    /// </remarks>
    private void Choose(IReadOnlyList<string> fields)
    {
        _refusal.Clear();
        _draft.Chosen = [.. fields];
        _ = CheckAsync();
    }

    /// <summary>
    /// Declares the index, or says why it cannot.
    /// </summary>
    /// <remarks>
    /// One refusal, and it is the schema's own <c>minItems: 1</c>. A field named twice cannot be
    /// reached at all — the chips toggle, so picking one again removes it — and everything else is
    /// the apply's to judge, because a second validator in the client is a second set of rules to
    /// disagree with.
    /// </remarks>
    private async Task AddAsync()
    {
        if (_draft.Build(out var refusal) is not { } index)
        {
            _refusal.Show(refusal!);
            return;
        }

        /* The working copy appends, so the new index lands after every row drawn now. */
        var position = Declared.Count;
        await OnAdd.InvokeAsync(index);
        _reveal = position;
        _reveals++;
        CloseAdding();
    }

    /// <summary>Closes the editor and forgets what was picked, so the next one starts empty.</summary>
    private void CloseAdding()
    {
        _draft = new();
        _ = CheckAsync();
        _refusal.Clear();
        _adding = false;
    }

    /// <summary>The confirm's title, naming the index by what it covers, which is all an index is.</summary>
    private string RemovalTitle => _removing is { } index
        ? $"Remove the {(index.Unique ? "unique " : string.Empty)}index on {string.Join(", ", index.Fields)}?"
        : string.Empty;

    /// <summary>
    /// The confirm's verb: asks the entity screen to drop the index that was asked about, found again where it is now.
    /// </summary>
    /// <remarks>
    /// By what the index is, not by where it was: another tab's edit reaching the copy while the confirm is up moves the
    /// rows, and a position captured at the press would then name a different index. One no longer declared is left
    /// alone. Focus then goes to the row that took its place, or to the list's New index (spec §3.2).
    /// </remarks>
    private async Task RemoveAsync()
    {
        if (_removing is not { } index)
        {
            return;
        }

        _removing = null;
        var position = PositionOf(index);
        if (position >= 0)
        {
            /* The rows after it move up, so the lit one would be a different index. */
            _reveal = null;
            await OnRemove.InvokeAsync(position);
        }

        await Interop.FocusFirstOnceClosedAsync(
            [RemoveButton(position), RemoveButton(position - 1), "[data-testid='index-new']"]);
    }

    /// <summary>Cancel and Escape keep the index, and focus goes back to its Remove.</summary>
    private Task CancelRemoval()
    {
        var position = _removing is { } index ? PositionOf(index) : -1;
        _removing = null;
        return Interop.FocusFirstOnceClosedAsync([RemoveButton(position), "[data-testid='index-new']"]);
    }

    /// <summary>Where <paramref name="index"/> is declared now, or -1 when it no longer is.</summary>
    private int PositionOf(IndexSchema index)
    {
        for (var position = 0; position < Declared.Count; position++)
        {
            if (WorkingCopy.SameIndex(Declared[position], index))
            {
                return position;
            }
        }

        return -1;
    }

    private static string RemoveButton(int position) => $"#index-row-{position} [data-testid='index-remove']";

    /// <summary>A filter short enough to sit in a badge; the whole of it is the badge's title.</summary>
    private static string Short(string where) => where.Length <= WhereBadgeLimit ? where : where[..WhereBadgeLimit] + "…";
}
