@*
    What runs on this entity, by when it runs. Up to five lanes. Before the transaction and In the transaction: the host's
    write hooks — validate hooks outside the write's transaction, before/after-write and delete hooks inside it — drawn
    only in a host that registers a write hook (Ruling 29, HX-08 Ruling 57's rule), so the container never shows them.
    After commit: the descriptor's after-hooks, which the On write tab edits (one editor, not two), and the host's event
    handlers. And Commands — the commands the host maps on a row of this entity — drawn only in a host that maps a
    command on some route (HX-08 Ruling 57). Reads, drawn between After commit and Commands — the host's narrowings and
    enrichers — only in a host that registers one (HX-16). Host code is read-only here, marked by the accent badge every piece of host
    code wears, as the function list's "this host" does, and carries this instance's p95 and 24 h rejections when the
    operator may read them.
*@
@if (_showsWriteLanes)
{
    <div data-testid="lifecycle-before-transaction">
        <SectionHead Title="Before the transaction">
            <Subtitle>
                Validate hooks run before a write opens its transaction — they may call another service, so they hold no lock —
                and only for a write no transaction unit is open around. They can only refuse the write.
            </Subtitle>
        </SectionHead>
        @if (_before.Count == 0)
        {
            <div data-testid="lifecycle-before-empty">
                <EmptyState Title="Nothing checks a write before its transaction" Body="The host registers no validate hook for this entity." />
            </div>
        }
        @foreach (var extension in _before)
        {
            @CodeItem(extension)
        }
    </div>

    <div data-testid="lifecycle-in-transaction">
        <SectionHead Title="In the transaction">
            <Subtitle>
                Before- and after-write hooks run inside the write's own transaction, after the descriptor's before-hooks: they
                may refuse, change the row or write other rows, and anything they do rolls back with the write. They never
                leave the process.
            </Subtitle>
        </SectionHead>
        @if (_inside.Count == 0)
        {
            <div data-testid="lifecycle-in-empty">
                <EmptyState Title="No host code runs inside a write to this entity" Body="The host registers no before- or after-write hook for it." />
            </div>
        }
        @foreach (var extension in _inside)
        {
            @CodeItem(extension)
        }
    </div>
}

<div data-testid="lifecycle-after-commit">
    <SectionHead Title="After commit">
        <Subtitle>
            Runs once the write has committed, from the outbox: it can never undo the write, and it may leave the process.
            @(_showsWriteLanes ? "The descriptor's before-hooks are on the On write tab." : "This tab shows what runs after the commit only — before-hooks, which run inside the transaction, are on the On write tab.")
        </Subtitle>
    </SectionHead>

    @if (_hooks.Count == 0 && _extensions.Count == 0)
    {
        <div data-testid="lifecycle-empty">
            <EmptyState Title="Nothing runs after a commit on this entity"
                        Body="No after-hook is declared, and the host registers no event handler for it." />
        </div>
    }

    @foreach (var hook in _hooks)
    {
        <ListRow class="a-listrow--roomy a-listrow--stacked" data-testid="@($"lane-hook-{hook.Point}-{hook.Number}")">
            <div class="a-row">
                <span class="a-badge">descriptor</span>
                <span class="a-mono a-name">@hook.Point</span>
                <span class="a-section__sub">hook @hook.Number</span>
            </div>
            <CodeBlock Json="@hook.Json" />
            <a class="a-link" href="@AdminPaths.Entity(Entity, EntityTabs.FromSlug(EntityTabs.OnWrite))" data-testid="lane-hook-edit">Change it on the On write tab</a>
        </ListRow>
    }

    @foreach (var extension in _extensions)
    {
        @CodeItem(extension)
    }
</div>

@if (_showsReads)
{
    <div data-testid="lifecycle-reads">
        <SectionHead Title="Reads">
            <Subtitle>
                Host code that runs on every read of this entity: a narrowing can only AND a filter into the rules' SQL (never for
                the system); an enricher can only hide a field or fill a virtual one. Writes are not narrowed.
            </Subtitle>
        </SectionHead>
        @if (_reads.Count == 0)
        {
            <div data-testid="lifecycle-reads-empty">
                <EmptyState Title="Nothing shapes a read of this entity" Body="The host registers no narrowing or enricher for it." />
            </div>
        }
        @foreach (var extension in _reads)
        {
            @CodeItem(extension)
        }
    </div>
}

@if (_showsCommands)
{
    <div data-testid="lifecycle-commands">
        <SectionHead Title="Commands">
            <Subtitle>
                Named actions the host's code exposes on a row of this entity. Each runs only for a caller its access rule admits
                — judged before it runs — outside any transaction, and records its completion as an event.
            </Subtitle>
        </SectionHead>

        @if (_commands.Count == 0)
        {
            <div data-testid="lifecycle-commands-empty">
                <EmptyState Title="No command acts on this entity" Body="The host maps no command bound to a row of it." />
            </div>
        }

        @foreach (var command in _commands)
        {
            <ListRow class="a-listrow--roomy a-listrow--stacked" data-testid="@($"lane-command-{command.Id}")">
                <div class="a-row">
                    <span class="a-badge a-badge--accent">⟨/⟩ from code</span>
                    <span class="a-mono a-name">@command.Id</span>
                </div>
                <code class="a-mono" data-testid="lane-command-route">@LifecycleLane.Route(command)</code>
                <code class="a-mono" data-testid="lane-command-access">access @command.Access</code>
                <p class="a-note">Registered in the host's C#: it is changed there, never here.</p>
            </ListRow>
        }
    </div>
}

@code {
    private IReadOnlyList<LaneHook> _hooks = [];
    private IReadOnlyList<ManagementExtension> _extensions = [];
    private IReadOnlyList<ManagementExtension> _commands = [];
    private bool _showsCommands;
    private IReadOnlyList<ManagementExtension> _before = [];
    private IReadOnlyList<ManagementExtension> _inside = [];
    private bool _showsWriteLanes;
    private IReadOnlyList<ManagementExtension> _reads = [];
    private bool _showsReads;

    /// <summary>The entity whose lane this is.</summary>
    [Parameter, EditorRequired]
    public string Entity { get; set; } = string.Empty;

    /// <summary>The entity's hooks in the working copy, by point, as the On write tab reads them.</summary>
    [Parameter]
    public IReadOnlyList<KeyValuePair<string, string>> Hooks { get; set; } = [];

    /// <summary>Every extension this instance registers; the lane keeps the ones that run on <see cref="Entity"/>.</summary>
    [Parameter]
    public IReadOnlyList<ManagementExtension> Extensions { get; set; } = [];

    /// <summary>This instance's numbers per extension over the last day; <see langword="null"/> when they could not be read.</summary>
    [Parameter]
    public ManagementExtensionStats? Stats { get; set; }

    protected override void OnParametersSet()
    {
        _hooks = LifecycleLane.AfterCommitHooks(Hooks);
        _extensions = LifecycleLane.AfterCommit(Entity, Extensions);
        _commands = LifecycleLane.Commands(Entity, Extensions);
        _showsCommands = LifecycleLane.HasMappedCommands(Extensions);
        _before = LifecycleLane.BeforeTransaction(Entity, Extensions);
        _inside = LifecycleLane.InTransaction(Entity, Extensions);
        _showsWriteLanes = LifecycleLane.HasWriteHooks(Extensions);
        _reads = LifecycleLane.Reads(Entity, Extensions);
        _showsReads = LifecycleLane.HasReads(Extensions);
    }

    /// <summary>One piece of host code as every code lane draws it: read-only, with its stage and this instance's numbers.</summary>
    private RenderFragment CodeItem(ManagementExtension extension) => @<ListRow class="a-listrow--roomy a-listrow--stacked" data-testid="@($"lane-extension-{extension.Id}")">
        <div class="a-row a-row--wrap">
            <span class="a-badge a-badge--accent">⟨/⟩ from code</span>
            <span class="a-mono a-name">@extension.Id</span>
            <span class="a-badge" data-testid="lane-extension-stage">@LifecycleLane.StageLabel(extension)</span>
            @if (extension.TopLevelOnly)
            {
                <span class="a-badge" data-testid="lane-extension-top-level">top-level writes only</span>
            }
            @if (!extension.Enabled)
            {
                <span class="a-badge a-badge--warn" data-testid="lane-extension-off">switched off</span>
            }
        </div>
        @if (extension.Description is { } description)
        {
            <span class="a-meta">@description</span>
        }
        <span class="a-section__sub" data-testid="lane-extension-summary">@LifecycleLane.Summary(extension)</span>
        @if (extension.When is { } when)
        {
            <code class="a-mono" data-testid="lane-extension-when">when @when</code>
        }
        @if (LifecycleLane.Numbers(extension, Stats) is { } numbers)
        {
            <span class="a-section__sub" data-testid="lane-extension-numbers">@numbers</span>
        }
        <p class="a-note">Registered in the host's C#: it is changed there, never here.</p>
    </ListRow>;
}
