@page "/admin/transfer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject AdminSession Session
@inject NavigationManager Navigation
@inject AdminInterop Interop
@inject ILogger<Transfer> Logger
@implements IAsyncDisposable

<PageTitle>Import and export · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Eyebrow="Schema" EyebrowHref="@AdminPaths.Schema" Title="Import and export" />

    @if (_problem is not null)
    {
        <CascadingValue Value="_problem">
            <ErrorPanel />
        </CascadingValue>
    }

    <Panel Padded="true" Title="Export">
        <Subtitle>The stored descriptor, byte for byte — exactly what was applied, not a copy rebuilt from it.</Subtitle>
        <ChildContent>
            <div class="a-row">
                <AlvoButton Small="true" Disabled="@(_descriptor is null)" OnClick="_ => DownloadAsync()">
                    Download @(Gateway.Project).alvo.json
                </AlvoButton>
                <span class="a-section__sub">revision @(_descriptor?.Revision.ToString(CultureInfo.InvariantCulture) ?? "…")</span>
            </div>
            @if (_descriptor is not null)
            {
                <CodeBlock Json="@_descriptor.DescriptorJson" />
            }
        </ChildContent>
    </Panel>

    <Panel Padded="true" Title="Import">
        <Subtitle>
            Paste a descriptor to work from. This does not apply anything — it loads the working
            copy, and the next screen is the same dry run every other change goes through.
        </Subtitle>
        <ChildContent>
            @RefusalPanel.Of(_refusal, "The apply would refuse this descriptor", "descriptor-invalid")

            @* The box never sends its text over the circuit (#316). It is a native textarea with no handler and no binding,
               because Blazor sends an input's whole value with every event dispatched from it (its EventFieldInfo), a focus
               or a key included, so a library box would send it on every keystroke whatever it bound. alvo.js stops its
               input events and tells the circuit only its measure (data-alvo-streamed); the page reads the text on submit
               as a stream (ImportStream). It is drawn as every native box is (a-input), and it has no maxlength: the
               library's default (524,288) once cut a longer paste short without a word, so alvo.js measures it against
               ImportLimit instead and refuses what is over it in place. *@
            @* A form, so Ctrl/Cmd+Enter is alvo.js's one chord (data-alvo-chord-submit), as in every multi-line box. *@
            @* data-copy-loaded: the gate's own condition, so an end-to-end scenario waits on what the submit checks. *@
            <form class="a-stack" data-alvo-chord-submit novalidate @onsubmit="Import"
                  data-copy-loaded="@(ImportGate.Loaded(_descriptor, _problem) ? "true" : "false")">
                <Field Label="Descriptor JSON" For="@BoxId">
                    <ChildContent>
                        <textarea class="a-input a-mono" id="@BoxId" rows="12" spellcheck="false" autocomplete="off"
                                  aria-describedby="import-json-hint" data-alvo-streamed
                                  data-alvo-max-chars="@ImportLimit.MaxChars"></textarea>
                    </ChildContent>
                    <Hint>@ImportHint</Hint>
                </Field>

                <AlvoButton Tone="AlvoButton.ButtonTone.Primary" Submit="true" Disabled="@(!ImportGate.Offered(_descriptor, _problem, _measure.Filled))"
                            data-testid="import-run">
                    Load it into the working copy
                </AlvoButton>
            </form>
        </ChildContent>
    </Panel>
</div>

@* A copy with edits in it is asked about first; Cancel keeps both the copy and the pasted text (spec §3.2). *@
<AlvoConfirm Open="_replacing" TestId="import-replace-confirm" ConfirmTestId="import-replace-run"
             CancelTestId="import-replace-cancel" Title="@CopyReplacement.Title(Copy.PendingCount)"
             Consequence="@CopyReplacement.Consequence("The pasted descriptor")" Verb="Discard and import"
             OnConfirm="ReplaceConfirmed" OnCancel="() => _replacing = false" />

@code {
    /// <summary>The box's element id: what alvo.js streams and measures.</summary>
    private const string BoxId = "import-json";

    /// <summary>
    /// This operator's working copy, resolved from the store rather than injected.
    /// </summary>
    /// <remarks>
    /// Empty until the first render has resolved who is signed in — the markup therefore reads it
    /// through <c>Copy.Loaded</c> rather than assuming a document is there.
    /// </remarks>
    private WorkingCopy Copy { get; set; } = new();

    private readonly ComponentLifetime _lifetime = new();
    private ManagementDescriptor? _descriptor;
    private AdminProblem? _problem;
    private readonly RefusalState<string> _refusal = new();
    private readonly List<IAsyncDisposable> _subscriptions = [];

    /// <summary>What the box says it holds, which is all the circuit hears of it until a submit reads its text.</summary>
    private BoxMeasure _measure = BoxMeasure.Empty;

    /// <summary>The text the last submit read, kept while the question before replacing unapplied edits is asked.</summary>
    private string _read = string.Empty;

    /// <summary>Whether the refusal on show is the one for a paste over the limit, which the next edit clears.</summary>
    private bool _oversizeShown;

    /// <summary>Whether a submit is reading the box's text, so a second chord meanwhile does nothing.</summary>
    private bool _reading;

    /// <summary>Whether the page has been disposed, so a subscription that arrives afterwards is given back at once.</summary>
    private bool _disposed;

    /// <summary>Whether the question before an import over unapplied edits is on screen.</summary>
    private bool _replacing;

    protected override async Task OnInitializedAsync()
    {
        var ct = _lifetime.Token;
        try
        {
            Copy = await Session.CopyAsync(ct);
            var descriptor = await Gateway.DescriptorAsync(ct);
            await Session.EnsureLoadedAsync(Copy, ct);
            _descriptor = descriptor;
        }
        catch (Exception exception)
        {
            _problem = AdminProblem.From(exception, Logger);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await KeepAsync(await Interop.SubscribeAsync("oversized", OnOversized));
            await KeepAsync(await Interop.SubscribeAsync("measured", OnMeasured));
            await OnMeasured(await Interop.MeasureOfAsync(BoxId));
        }
    }

    private async Task KeepAsync(IAsyncDisposable subscription)
    {
        if (_disposed)
        {
            await subscription.DisposeAsync();
        }
        else
        {
            _subscriptions.Add(subscription);
        }
    }

    /// <summary>
    /// A paste alvo.js stopped at the box, over the character ceiling: refused in place, naming the limit
    /// (<see cref="ImportLimit"/>, #316).
    /// </summary>
    /// <remarks>Focus stays in the box, which holds its last text within the ceiling, so the paste can be tried again at once.</remarks>
    /// <param name="measured">What alvo.js measured: the paste's characters.</param>
    private Task OnOversized(string? measured) => InvokeAsync(() =>
    {
        ShowOversized(ImportLimit.Refusal(measured));
        StateHasChanged();
    });

    private void ShowOversized(string refusal)
    {
        _refusal.Show(refusal, fromPress: false, title: "That paste is too large to import here");
        _oversizeShown = true;
    }

    /// <summary>What the box holds now, as alvo.js measured it; an edit clears a refusal that only said the last paste was too large.</summary>
    /// <param name="measured">"&lt;lines&gt; &lt;filled&gt;" (<see cref="BoxMeasure"/>), or <see langword="null"/> when the box or the circuit is gone.</param>
    private Task OnMeasured(string? measured) => measured is null ? Task.CompletedTask : InvokeAsync(() =>
    {
        _measure = BoxMeasure.Parse(measured);
        if (_oversizeShown)
        {
            _refusal.Show(null);
            _oversizeShown = false;
        }

        StateHasChanged();
    });

    private async Task DownloadAsync()
    {
        if (_descriptor is not null)
        {
            await Interop.DownloadAsync($"{Gateway.Project}.alvo.json", _descriptor.DescriptorJson);
        }
    }

    /// <summary>
    /// Reads the box's text, then loads it after refusing the names the frozen schema cannot carry.
    /// </summary>
    /// <remarks>
    /// <para>
    /// The text is read here, as a stream, and not before: the box never sends it over the circuit (<see cref="ImportStream"/>).
    /// Reading it at the moment of the submit is also what makes a chord pressed straight after a paste import what was
    /// pasted.
    /// </para>
    /// <para>
    /// A copy that holds unapplied edits is asked about first (<see cref="CopyReplacement"/>); a clean one is replaced
    /// at once. The text is checked before the question, so nobody is asked to discard their edits for a paste that
    /// would then be refused.
    /// </para>
    /// <para>
    /// The check is the boundary, not a validation pass: everything else about the descriptor is
    /// judged by the apply on the next screen, which is the authority. What is refused here is the
    /// class of input that must never reach a renderer — see <see cref="DescriptorNames"/>.
    /// </para>
    /// <para>
    /// The keyboard reaches it without the button, so whatever disables the button — an empty box, or a copy not yet
    /// loaded or failed to load (<see cref="ImportGate"/>) — is refused here as well.
    /// </para>
    /// </remarks>
    private async Task Import()
    {
        if (!ImportGate.Loaded(_descriptor, _problem) || _replacing || _reading)
        {
            return;
        }

        _reading = true;
        try
        {
            if (await ReadBoxAsync() is { } text)
            {
                Judge(text);
            }
        }
        finally
        {
            _reading = false;
        }
    }

    /// <summary>The box's text, or <see langword="null"/> when there is nothing to import or it was refused for its size.</summary>
    private async Task<string?> ReadBoxAsync()
    {
        await using var stream = await Interop.StreamOfAsync(BoxId);
        if (stream is null)
        {
            return null;
        }

        var read = await ImportStream.ReadAsync(stream, _lifetime.Token);
        if (read.Refusal is not null)
        {
            ShowOversized(read.Refusal);
            return null;
        }

        return ImportGate.Ready(_descriptor, _problem, read.Text!) ? read.Text : null;
    }

    private void Judge(string text)
    {
        _oversizeShown = false;
        _refusal.Show(DescriptorNames.FirstRefusal(text)
            ?? (CopyReplacement.IsObject(text) ? null : "That is not a JSON object."));
        if (_refusal.Shown)
        {
            return;
        }

        _read = text;
        if (Copy.IsDirty)
        {
            _replacing = true;
        }
        else
        {
            Load();
        }
    }

    /// <summary>The operator chose to lose the staged edits for the pasted descriptor.</summary>
    private void ReplaceConfirmed()
    {
        _replacing = false;
        Load();
    }

    /// <summary>Loads the text the submit read, already checked, into the copy and opens its plan.</summary>
    private void Load()
    {
        if (!Copy.Replace(_read))
        {
            _refusal.Show("That is not a JSON object.");
            return;
        }

        Navigation.NavigateTo(AdminPaths.Changes);
    }

    /// <summary>
    /// The shortcut, which nothing else on the page names, and the size of the box as it told the circuit: the count is
    /// drawn from the box's own measure, so it is also where a newline typed into it shows the circuit heard it.
    /// </summary>
    private string ImportHint
    {
        get
        {
            var lines = _measure.Lines;
            var size = lines == 1 ? "1 line" : $"{lines.ToString(CultureInfo.InvariantCulture)} lines";
            return $"{ChordHint.Of("loads it")} {size}, of at most {ImportLimit.MaxChars.ToString("N0", CultureInfo.InvariantCulture)} characters.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Dispose();
        foreach (var subscription in _subscriptions)
        {
            await subscription.DisposeAsync();
        }
    }
}
