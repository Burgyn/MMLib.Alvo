@page "/admin/transfer"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject AdminSession Session
@inject NavigationManager Navigation
@inject AdminInterop Interop
@inject ILogger<Transfer> Logger
@implements IAsyncDisposable

<PageTitle>Import and export · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Eyebrow="Schema" EyebrowHref="@AdminPaths.Schema" Title="Import and export" />

    @if (_problem is not null)
    {
        <CascadingValue Value="_problem">
            <ErrorPanel />
        </CascadingValue>
    }

    <Panel Padded="true" Title="Export">
        <Subtitle>The stored descriptor, byte for byte — exactly what was applied, not a copy rebuilt from it.</Subtitle>
        <ChildContent>
            <div class="a-row">
                <AlvoButton Small="true" Disabled="@(_descriptor is null)" OnClick="_ => DownloadAsync()">
                    Download @(Gateway.Project).alvo.json
                </AlvoButton>
                <span class="a-section__sub">revision @(_descriptor?.Revision.ToString(CultureInfo.InvariantCulture) ?? "…")</span>
            </div>
            @if (_descriptor is not null)
            {
                <CodeBlock Json="@_descriptor.DescriptorJson" />
            }
        </ChildContent>
    </Panel>

    <Panel Padded="true" Title="Import">
        <Subtitle>
            Paste a descriptor to work from. This does not apply anything — it loads the working
            copy, and the next screen is the same dry run every other change goes through.
        </Subtitle>
        <ChildContent>
            @RefusalPanel.Of(_refusal, "The apply would refuse this descriptor", "descriptor-invalid")

            @* No browser maxlength: the library's default (524,288) cut a longer paste short without a word. alvo.js measures
               the box against ImportLimit instead, and refuses what is over it in place (#316). *@
            @* A form, so Ctrl/Cmd+Enter is alvo.js's one chord (data-alvo-chord-submit), as in every multi-line box. *@
            <form class="a-stack" data-alvo-chord-submit novalidate @onsubmit="Import">
                <Field Label="Descriptor JSON" For="import-json">
                    <ChildContent>
                        <MudTextField T="string" Variant="Variant.Outlined" Lines="12" Immediate="true" id="import-json"
                                      Class="a-mono" spellcheck="false" aria-describedby="import-json-hint"
                                      data-alvo-max-chars="@ImportLimit.MaxChars" data-alvo-max-bytes="@ImportLimit.MaxSentBytes" MaxLength="int.MaxValue"
                                      Value="_pasted" ValueChanged="Pasted" />
                    </ChildContent>
                    <Hint>@ImportHint</Hint>
                </Field>

                <AlvoButton Tone="AlvoButton.ButtonTone.Primary" Submit="true" Disabled="@(_pasted.Trim().Length == 0)"
                            data-testid="import-run">
                    Load it into the working copy
                </AlvoButton>
            </form>
        </ChildContent>
    </Panel>
</div>

@* A copy with edits in it is asked about first; Cancel keeps both the copy and the pasted text (spec §3.2). *@
<AlvoConfirm Open="_replacing" TestId="import-replace-confirm" ConfirmTestId="import-replace-run"
             CancelTestId="import-replace-cancel" Title="@CopyReplacement.Title(Copy.PendingCount)"
             Consequence="@CopyReplacement.Consequence("The pasted descriptor")" Verb="Discard and import"
             OnConfirm="ReplaceConfirmed" OnCancel="() => _replacing = false" />

@code {
    /// <summary>
    /// This operator's working copy, resolved from the store rather than injected.
    /// </summary>
    /// <remarks>
    /// Empty until the first render has resolved who is signed in — the markup therefore reads it
    /// through <c>Copy.Loaded</c> rather than assuming a document is there.
    /// </remarks>
    private WorkingCopy Copy { get; set; } = new();

    private readonly ComponentLifetime _lifetime = new();
    private ManagementDescriptor? _descriptor;
    private AdminProblem? _problem;
    private string _pasted = string.Empty;
    private readonly RefusalState<string> _refusal = new();
    private IAsyncDisposable? _oversized;

    /// <summary>Whether the refusal on show is the one for a paste over the limit, which the next edit clears.</summary>
    private bool _oversizeShown;

    /// <summary>Whether the page has been disposed, so a subscription that arrives afterwards is given back at once.</summary>
    private bool _disposed;

    /// <summary>Whether the question before an import over unapplied edits is on screen.</summary>
    private bool _replacing;

    protected override async Task OnInitializedAsync()
    {
        var ct = _lifetime.Token;
        try
        {
            Copy = await Session.CopyAsync(ct);
            _descriptor = await Gateway.DescriptorAsync(ct);
            await Session.EnsureLoadedAsync(Copy, ct);
        }
        catch (Exception exception)
        {
            _problem = AdminProblem.From(exception, Logger);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var subscription = await Interop.SubscribeAsync("oversized", OnOversized);
            if (_disposed)
            {
                await subscription.DisposeAsync();
            }
            else
            {
                _oversized = subscription;
            }
        }
    }

    /// <summary>
    /// A paste alvo.js stopped at the box, over what one circuit message may carry: refused in place, naming the limit,
    /// where the circuit would otherwise have closed without a word (<see cref="ImportLimit"/>, #316).
    /// </summary>
    /// <remarks>Focus stays in the box, which holds the text the circuit last heard, so the paste can be tried again at once.</remarks>
    /// <param name="measured">What alvo.js measured: characters, then bytes as sent.</param>
    private Task OnOversized(string? measured) => InvokeAsync(() =>
    {
        ShowOversized(measured);
        StateHasChanged();
    });

    private void ShowOversized(string? measured)
    {
        _refusal.Show(ImportLimit.Refusal(measured), fromPress: false, title: "That paste is too large to import here");
        _oversizeShown = true;
    }

    /// <summary>The box's text, as the circuit heard it; an edit clears a refusal that only said the last paste was too large.</summary>
    /// <param name="text">The new text.</param>
    private void Pasted(string? text)
    {
        _pasted = text ?? string.Empty;
        if (_oversizeShown)
        {
            _refusal.Show(null);
            _oversizeShown = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (_descriptor is not null)
        {
            await Interop.DownloadAsync($"{Gateway.Project}.alvo.json", _descriptor.DescriptorJson);
        }
    }

    /// <summary>
    /// Loads a pasted descriptor, after refusing the names the frozen schema cannot carry.
    /// </summary>
    /// <remarks>
    /// <para>
    /// A copy that holds unapplied edits is asked about first (<see cref="CopyReplacement"/>); a clean one is replaced
    /// at once. The text is checked before the question, so nobody is asked to discard their edits for a paste that
    /// would then be refused.
    /// </para>
    /// <para>
    /// The check is the boundary, not a validation pass: everything else about the descriptor is
    /// judged by the apply on the next screen, which is the authority. What is refused here is the
    /// class of input that must never reach a renderer — see <see cref="DescriptorNames"/>.
    /// </para>
    /// <para>
    /// The keyboard reaches it without the button, so the empty box is refused here as well as by the disabled button.
    /// </para>
    /// </remarks>
    private Task Import()
    {
        if (_pasted.Trim().Length == 0 || _replacing)
        {
            return Task.CompletedTask;
        }

        /* Defence in depth: alvo.js stops a longer paste at the box, but a text that reached the circuit some other way is
           still refused here, in the same words. */
        if (_pasted.Length > ImportLimit.MaxChars)
        {
            ShowOversized(ImportLimit.Measure(_pasted));
            return Task.CompletedTask;
        }

        _oversizeShown = false;

        _refusal.Show(DescriptorNames.FirstRefusal(_pasted)
            ?? (CopyReplacement.IsObject(_pasted) ? null : "That is not a JSON object."));
        if (_refusal.Shown)
        {
            return Task.CompletedTask;
        }

        if (Copy.IsDirty)
        {
            _replacing = true;
        }
        else
        {
            Load();
        }

        return Task.CompletedTask;
    }

    /// <summary>The operator chose to lose the staged edits for the pasted descriptor.</summary>
    private void ReplaceConfirmed()
    {
        _replacing = false;
        Load();
    }

    /// <summary>Loads the pasted descriptor, already checked, into the copy and opens its plan.</summary>
    private void Load()
    {
        if (!Copy.Replace(_pasted))
        {
            _refusal.Show("That is not a JSON object.");
            return;
        }

        Navigation.NavigateTo(AdminPaths.Changes);
    }

    /// <summary>
    /// The shortcut, which nothing else on the page names, and the size of what the circuit holds: the count is drawn
    /// from the server's copy of the text, so it is also where a newline typed into it shows it arrived.
    /// </summary>
    private string ImportHint
    {
        get
        {
            var lines = _pasted.Length == 0 ? 0 : _pasted.Count(c => c == '\n') + 1;
            var size = lines == 1 ? "1 line" : $"{lines.ToString(CultureInfo.InvariantCulture)} lines";
            return $"{ChordHint.Of("loads it")} {size}, of at most {ImportLimit.MaxChars.ToString("N0", CultureInfo.InvariantCulture)} characters.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Dispose();
        if (_oversized is not null)
        {
            await _oversized.DisposeAsync();
        }
    }
}
