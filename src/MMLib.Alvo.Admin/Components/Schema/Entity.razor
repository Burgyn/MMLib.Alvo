@page "/admin/schema/{EntityName}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject AdminSession Session
@inject NavigationManager Navigation
@inject ILogger<Entity> Logger
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@EntityName · Schema · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Eyebrow="Schema" EyebrowHref="@AdminPaths.Schema" Title="@EntityName" Mono="true"
                Subtitle="@(_entity is null ? null : _entity.Description ?? "This entity has no description in the descriptor.")">
        <Secondary>
            <AlvoButton Small="true" Href="@AdminPaths.Records(EntityName)">Browse records</AlvoButton>
            @if (Copy.Loaded)
            {
                <AlvoButton Small="true" data-testid="rename-entity" OnClick="_ => OpenRename()">Rename</AlvoButton>
            }
        </Secondary>
    </PageHeader>

    @*
        Renaming is its own control rather than an editable title: it is the one edit where the name in
        the descriptor and the name in the database come apart, and it needs a sentence saying so before
        the operator commits to it.
    *@
    @if (_renaming)
    {
        <AlvoEditor TestId="rename-sheet" Title="@($"Rename {EntityName}")"
                    Subtitle="The apply moves the table. Its rows come with it."
                    SubmitText="@(UnsavedRules ? "Discard the unsaved rule and rename" : "Rename in the working copy")"
                    SubmitTestId="rename-save" Dirty="@(!string.Equals(_newName, EntityName, StringComparison.Ordinal))"
                    OnSubmit="RenameAsync" OnClose="CloseRename">
            @RefusalPanel.Of(_renameRefusal, "That name cannot be used")
            @* Asked here, before anything is staged: the rename moves this screen to a new address, and a rule typed on
               the Rules tab and not saved would not come with it. *@
            @if (UnsavedRules)
            {
                <AlvoAlert Tone="AlvoAlert.AlertTone.Warning" Title="A rule on this entity is not saved" TestId="rename-unsaved-rules">
                    Renaming discards it. Cancel and save it first to keep it.
                </AlvoAlert>
            }
            <Field Label="New name" For="rename-entity-name">
                <ChildContent>
                    <MudTextField T="string" Value="_newName" ValueChanged="name => _newName = name ?? string.Empty"
                                  Immediate="true" Variant="Variant.Outlined" id="rename-entity-name"
                                  autocomplete="off" Class="a-mono" aria-describedby="rename-entity-name-hint" />
                </ChildContent>
                <Hint>
                    @DescriptorNames.Hint The change is carried by <code class="a-mono">renamedFrom</code>, so the apply
                    moves the table instead of dropping it.
                </Hint>
            </Field>
        </AlvoEditor>
    }

    @*
        Every removal asks, not only one something names (spec §3.2): the confirm lists what names the field, and
        refuses while one of those would leave a descriptor the apply refuses.
    *@
    <AlvoConfirm Open="_removal is not null" TestId="remove-field-sheet" ConfirmTestId="remove-field-anyway"
                 CancelTestId="remove-field-cancel" Title="@($"Remove {_removal?.Field}?")"
                 Consequence="It leaves the working copy now; the column and its data are dropped only when you apply."
                 Verb="Remove field" Allowed="@(_removal?.References.Any(reference => reference.Blocks) != true)"
                 OnConfirm="RemoveAnyway" OnCancel="CloseRemoval">
        @foreach (var reference in _removal?.References ?? [])
        {
            <ListRow data-testid="field-reference">
                <code class="a-mono a-listrow__key">@reference.Place</code>
                <span class="@($"a-badge {(reference.Blocks ? "a-badge--danger" : "a-badge--warn")}")">
                    @(reference.Blocks ? "names it" : "may name it")
                </span>
            </ListRow>
        }
        @if (_removal?.References.Any(reference => reference.Blocks) == true)
        {
            <Refusal data-testid="remove-field-blocked">Change or remove the places that name it first.</Refusal>
        }
    </AlvoConfirm>

    @if (_problem is not null)
    {
        <CascadingValue Value="_problem">
            <ErrorPanel />
        </CascadingValue>
    }
    else if (_entity is null)
    {
        @if (_schema is null)
        {
            <Skeleton Size="Skeleton.SkeletonSize.Lg" />
        }
        else
        {
            <EmptyState Title="@($"There is no entity called {EntityName}")"
                        Body="The schema this project serves does not declare it. It may have been renamed, or removed by a later revision." />
        }
    }
    else
    {
        <div class="a-row a-row--gap-2 a-row--wrap">
            @if (_pending)
            {
                <span class="a-badge a-badge--warn">not applied yet</span>
            }
            <span class="a-badge">@(_entity.Tenancy == TenancyMode.Scoped ? "tenancy: scoped" : "tenancy: global")</span>
            <span class="a-badge">@(_entity.Audit ? "audited" : "not audited")</span>
            @if (_entity.SoftDelete)
            {
                <span class="a-badge">soft delete</span>
            }
            <span class="a-badge">@(_entity.Storage == EntityStorage.Physical ? "physical table" : "dynamic")</span>
        </div>

        @*
            MudTabs owns the WAI-ARIA tabs pattern now: the arrows move focus along the strip, Enter or Space opens
            the focused tab. The open tab is still the address's ?tab=, so a reload, a link and Back all agree.
            Only the open tab's body is drawn.
        *@
        <MudTabs ActivePanelIndex="@ActiveIndex" OnPreviewInteraction="OpenAsync"
                 Elevation="0" Ripple="false" KeepPanelsAlive="false" Class="a-entitytabs"
                 id="entity-tabs">
            @foreach (var tab in EntityTabs.All)
            {
                <MudTabPanel Text="@tab.Title" ID="@tab.Slug">
                    @if (tab == _tab)
                    {
                        @* The staged rows' badges reach the tabs as a cascade, which keeps their model internal. *@
                        <CascadingValue Value="_staged">
                            <CascadingValue Value="_ruleDrafts">
                                <Panel data-testid="entity-tabpanel">@TabContent(tab)</Panel>
                            </CascadingValue>
                        </CascadingValue>
                    }
                </MudTabPanel>
            }
        </MudTabs>
        @TablistName.On("#entity-tabs", $"{EntityName} sections")

        @*
            The editor is a sheet now, so it is on the page only while somebody is editing. As a
            permanent panel it was something to scroll past on every visit, and on a phone a second
            thing competing with the list for the screen.
        *@
        @if (_tab == EntityTabs.First && _editorOpen)
        {
            <CascadingValue Value="_rollupSources">
                <FieldEditor Entity="@EntityName" Targets="_entities" OnAdd="AddFieldAsync"
                             Editing="@_editing" EditingJson="@EditedJson" OnClose="CloseEditor"
                             Siblings="_fieldNames" Refused="_refused" />
            </CascadingValue>
        }
    }
</div>

@*
    Leaving the entity with a rule typed and not saved asks first (spec §3.1: nothing is saved on blur, so nothing is
    saved on the way out either). Moving between this entity's tabs does not ask: the drafts belong to the screen, not
    to the tab, and the Rules tab still shows them marked unsaved on the way back.
*@
<NavigationLock OnBeforeInternalNavigation="GuardRules" ConfirmExternalNavigation="@UnsavedRules" />
<AlvoConfirm Open="_leavingTo is not null" TestId="unsaved-rules" ConfirmTestId="unsaved-rules-discard"
             CancelTestId="unsaved-rules-keep" Title="Discard the unsaved rules?"
             Consequence="A rule you typed on this entity has not been saved to the working copy, and leaving loses it."
             Verb="Discard and leave" OnConfirm="LeaveDiscardingRules" OnCancel="() => _leavingTo = null" />

@code {
    /// <summary>The open tab's body.</summary>
    private RenderFragment TabContent(EntityTab tab) => @<text>
        @switch (tab.Slug)
        {
            case EntityTabs.Fields:
                <text>@FieldsTab</text>
                break;
            case EntityTabs.Relationships:
                <Relationships Entity="@(_entity!)" Schema="_schema!"
                               DescriptorJson="@(Copy.Loaded ? Copy.Json : null)"
                               AppliedJson="@(Copy.Loaded ? Copy.AppliedJson : null)" />
                break;
            case EntityTabs.Rules:
                <RulesTab Rules="_working" Entity="@EntityName" Editable="true" OnChanged="SetRule" />
                break;
            case EntityTabs.OnWrite:
                <HooksTab Hooks="@_hooks" Editable="Copy.Loaded" Refused="_refused"
                          OnAdd="AddHook" OnRemove="RemoveHook" />
                break;
            case EntityTabs.Indexes:
                <Indexes Entity="@(_entity!)" Declared="_indexes" Editable="Copy.Loaded"
                         OnAdd="AddIndex" OnRemove="RemoveIndex" />
                break;
            case EntityTabs.Api:
                <ApiTab Entity="@(_entity!)" />
                break;
        }
    </text>;

    /// <summary>The Fields tab: its head with the add control, a rename's leftovers, and the list.</summary>
    /// <remarks>
    /// The control sits with the list's own heading rather than as a green block above the first row, where it
    /// outweighed every field on the screen.
    /// </remarks>
    private RenderFragment FieldsTab => @<text>
        <SectionHead Title="Declared fields">
            <Actions>
                @if (Copy.Loaded)
                {
                    <AlvoButton Small="true" data-testid="add-field" OnClick="_ => AddField()">Add a field</AlvoButton>
                }
            </Actions>
        </SectionHead>
        @if (_renameLeftovers is { Uncarried.Count: > 0 } leftovers)
        {
            <p class="a-note" data-testid="rename-leftovers">
                <code class="a-mono">@leftovers.From</code> is renamed, and these still name it — the
                rename could not rewrite them safely, and the apply refuses them until they are edited:
                <span class="a-mono">@string.Join(", ", leftovers.Uncarried.Select(reference => reference.Place))</span>
            </p>
        }
        <Fields Entity="@FieldsView(_entity!)" Editable="DeclaredHere" OnEdit="EditField" OnRemove="RemoveField" />
    </text>;
}
