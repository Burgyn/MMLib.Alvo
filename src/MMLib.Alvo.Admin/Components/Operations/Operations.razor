@page "/admin/operations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject OperationsGateway Gateway
@inject ILogger<Operations> Logger
@inject AdminInterop Interop
@inject ISnackbar Snackbar
@inject IServiceProvider Services

<PageTitle>Operations · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="Operations"
                Subtitle="What the handlers this host registers did after each commit, and when its schedules run: pause a handler, run a dead delivery again, replay what failed, run a schedule now. Run counts are this instance's, over the last 24 hours.">
        <Primary>
            <AlvoButton Small="true" data-testid="ops-refresh" Busy="Loading" OnClick="_ => LoadAsync()">Refresh</AlvoButton>
        </Primary>
    </PageHeader>

    @if (_problem.Shown)
    {
        @RefusalPanel.Of(_problem)
    }

    @if (_handlers is null)
    {
        if (!_problem.Shown)
        {
            <Skeleton Size="Skeleton.SkeletonSize.Lg" />
        }
    }
    else if (_handlers.Count == 0 && _jobs is { Count: 0 })
    {
        <EmptyState Title="This host registers no event handlers"
                    Body="Handlers are registered in the host's code with Entity(…).OnCreated and their kin, schedules with AddSchedule; the standalone image registers none." />
    }
    else
    {
        @if (_handlers.Count > 0)
        {
            <Panel Title="Handlers">
                @foreach (var handler in _handlers)
                {
                    <div class="a-listrow a-listrow--stacked a-listrow--roomy" data-testid="@($"ops-handler-{handler.Id}")">
                        <div class="a-stack a-stack--gap-3">
                            <div class="a-row a-row--wrap">
                                <span class="a-mono">@handler.Id</span>
                                <span class="a-badge a-badge--accent">⟨/⟩ from code</span>
                                @if (handler.Paused)
                                {
                                    <span class="a-badge a-badge--warn" data-testid="@($"ops-handler-paused-{handler.Id}")">paused</span>
                                }
                                @if (OperationsView.ConcurrencyLine(handler) is { } concurrency)
                                {
                                    <span class="a-badge" title="At most this many of its deliveries run at once" data-testid="@($"ops-handler-concurrency-{handler.Id}")">@concurrency</span>
                                }
                            </div>
                            @if (handler.Description is { } description)
                            {
                                <span class="a-section__sub">@description</span>
                            }
                            <span class="a-section__sub" data-testid="@($"ops-runs-{handler.Id}")">@OperationsView.RunsLine(Stat(handler.Id))</span>
                            <div class="a-row a-row--wrap">
                                @if (handler.Paused)
                                {
                                    <AlvoButton Small="true" data-testid="@($"ops-resume-{handler.Id}")" Busy="_busy.Busy" OnClick="_ => ResumeAsync(handler.Id)">Resume</AlvoButton>
                                }
                                else
                                {
                                    <AlvoButton Small="true" data-testid="@($"ops-pause-{handler.Id}")" Busy="_busy.Busy" OnClick="_ => AskPause(handler.Id)">Pause…</AlvoButton>
                                }
                                <AlvoButton Small="true" data-testid="@($"ops-replay-{handler.Id}")" Busy="_busy.Busy" OnClick="_ => PlanReplayAsync(handler.Id)">Replay dead…</AlvoButton>
                            </div>
                        </div>
                    </div>
                }
            </Panel>
        }

        @if (_jobs is { Count: > 0 } jobs)
        {
            <Panel Title="Schedules">
                @foreach (var job in jobs)
                {
                    <div class="a-listrow a-listrow--stacked a-listrow--roomy" data-testid="@($"ops-job-{job.Id}")">
                        <div class="a-stack a-stack--gap-3">
                            <div class="a-row a-row--wrap">
                                <span class="a-mono">@job.Id</span>
                                <span class="a-badge a-badge--accent">@(job.Kind == AlvoExtensionKind.DataMigration ? "data migration" : "schedule")</span>
                                @if (job.LastOutcome is { } outcome)
                                {
                                    <span class="@OperationsView.BadgeClass(outcome)" data-testid="@($"ops-job-outcome-{job.Id}")">@outcome</span>
                                }
                            </div>
                            @if (job.Description is { } description)
                            {
                                <span class="a-section__sub">@description</span>
                            }
                            <span class="a-section__sub a-mono">@OperationsView.When(job)</span>
                            @if (OperationsView.CanRunNow(job))
                            {
                                <span class="a-section__sub" data-testid="@($"ops-job-runs-{job.Id}")">next @OperationsView.NextRun(job, Now) · last @OperationsView.LastRun(job, Now)</span>
                                <div class="a-row a-row--wrap">
                                    <AlvoButton Small="true" data-testid="@($"ops-run-now-{job.Id}")" Busy="_busy.Busy" OnClick="_ => AskRunNow(job.Id)">Run now</AlvoButton>
                                </div>
                            }
                        </div>
                    </div>
                }
            </Panel>
        }

        <div class="a-card" data-testid="timer-counts">
            <span class="a-section__title">Timers</span>
            <span class="a-section__sub">@OperationsView.TimersLine(_timers)</span>
        </div>

        <div class="a-split">
            <Panel class="a-split__main a-grow" Title="Deliveries">
                @RefreshBar.While(Loading)
                <div class="a-row a-row--wrap a-panel__body" role="group" aria-label="Filter by status">
                    <AlvoButton Small="true" Tone="@FilterTone(null)" data-testid="ops-status-filter-all" OnClick="_ => FilterAsync(null)">All</AlvoButton>
                    @foreach (var status in OperationsView.StatusFilters)
                    {
                        <AlvoButton Small="true" Tone="@FilterTone(status)" data-testid="@($"ops-status-filter-{status}")" OnClick="_ => FilterAsync(status)">@status</AlvoButton>
                    }
                </div>
                <div data-testid="ops-delivery-list">
                    @if (_deliveries is { Count: 0 })
                    {
                        <p class="a-section__sub a-panel__body">No deliveries@(_status is null ? string.Empty : $" {_status}") yet.</p>
                    }
                    @foreach (var delivery in _deliveries ?? [])
                    {
                        <ListRow class="@($"a-listrow--stacked{(delivery.Id == _selected?.Id ? " a-listrow--accent" : string.Empty)}")"
                                 data-testid="@($"ops-row-{delivery.Id}")" OnClick="() => OpenAsync(delivery.Id)">
                            <div class="a-row a-row--wrap">
                                <span class="@OperationsView.BadgeClass(delivery, Now)" data-testid="ops-delivery-status">@OperationsView.StatusLabel(delivery, Now)</span>
                                <span class="a-mono">@delivery.Subscriber</span>
                                <span class="a-section__sub a-mono">@delivery.PartitionKey</span>
                            </div>
                            <span class="a-section__sub">attempts @delivery.Attempts@(delivery.LastErrorType is { } error ? $" · {error}" : string.Empty)</span>
                        </ListRow>
                    }
                </div>
            </Panel>

            <SplitHandle Controls="ops-delivery" />

            <div class="a-split__aside a-stack" id="ops-delivery">
                @if (_selected is null)
                {
                    <div class="a-card">
                        <span class="a-section__title">Pick a delivery</span>
                        <span class="a-section__sub">Its attempts are shown here; a finished one can be run again or taken away as a redacted fixture.</span>
                    </div>
                }
                else
                {
                    <div class="a-card a-card--roomy">
                        <div class="a-row">
                            <span class="@OperationsView.BadgeClass(_selected, Now)" data-testid="ops-selected-status">
                                @if (OperationsView.IsSleeping(_selected, Now))
                                {
                                    <Icon Path="@Icons.History" Size="12" />
                                }
                                @OperationsView.StatusLabel(_selected, Now)
                            </span>
                            <span class="a-mono">@_selected.Subscriber</span>
                        </div>
                        <ol class="a-stack" aria-label="Attempts" data-testid="ops-delivery-history">
                            @foreach (var attempt in _selected.History)
                            {
                                <li class="a-section__sub">@OperationsView.AttemptLine(attempt)</li>
                            }
                        </ol>
                        <span class="a-section__title">Steps</span>
                        @if (OperationsView.Steps(_selected) is { Count: > 0 } steps)
                        {
                            <ol class="a-stack" aria-label="Steps" data-testid="ops-delivery-steps">
                                @foreach (var step in steps)
                                {
                                    <li class="a-section__sub a-mono">@step</li>
                                }
                            </ol>
                        }
                        else
                        {
                            <span class="a-section__sub" data-testid="ops-delivery-no-steps">No steps recorded</span>
                        }
                        <div class="a-row a-actions">
                            @if (OperationsView.CanRedeliver(_selected))
                            {
                                <AlvoButton Small="true" data-testid="ops-redeliver" Busy="_busy.Busy" OnClick="_ => RedeliverAsync(_selected.Id)">Run again</AlvoButton>
                            }
                            <AlvoButton Small="true" data-testid="ops-fixture" Busy="_busy.Busy" OnClick="_ => FixtureAsync(_selected.Id)">Fixture</AlvoButton>
                        </div>
                        @if (_fixture is { } fixture)
                        {
                            <p class="a-section__sub">
                                Every value that is not a key is redacted. Save it as JSON and pass it to
                                <code class="a-mono">AlvoTestHost.DeliverAsync</code> to reproduce this delivery.
                            </p>
                            <div data-testid="ops-fixture-json"><CodeBlock Json="@fixture" /></div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<AlvoConfirm Open="_confirming is not null" TestId="ops-confirm" ConfirmTestId="ops-confirm-run" CancelTestId="ops-confirm-cancel"
             Title="@(_confirming?.Title ?? string.Empty)" Consequence="@(_confirming?.Consequence ?? string.Empty)"
             Verb="@(_confirming?.Verb ?? string.Empty)" Busy="_busy.Busy" OnConfirm="ConfirmedAsync" OnCancel="() => _confirming = null">
    @* A form of one box, so Enter confirms as the verb would (spec §3.4). *@
    @if (_confirming?.AsksReason ?? true)
    {
        <form novalidate @onsubmit="ConfirmedAsync">
            <Field Label="Reason (kept in the audit)" For="ops-reason">
                <MudTextField T="string" @bind-Value="_reason" Variant="Variant.Outlined" MaxLength="500"
                              id="ops-reason" autocomplete="off" data-testid="ops-reason" />
            </Field>
        </form>
    }
</AlvoConfirm>
