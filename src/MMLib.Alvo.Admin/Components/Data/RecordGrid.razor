@*
    One page of records: a table on a desktop, a card per row on a phone, and the pager under both.

    Out of the Data screen (docs/architecture/admin-dashboard-review.md, F-13), which keeps what it
    reads and when; this draws a page it is handed. Deliberately not a generic grid: there is one grid,
    and the review rejects generalising it before a second one exists.

    It owns the rows' keyboard (design §5.5): `j`/`k` move the selected row and Enter opens it. alvo.js
    reads the keys and keeps them from a sheet or the palette; this keeps which row is selected.
*@
@implements IAsyncDisposable
@inject AdminInterop Interop
@inject IScrollManager Scroll

<div class="a-grid-wrap a-only-desktop-block">
    @* `data-alvo-keyboard` says the rows' keys have a listener, for the markKeyboardReady reason: a `j` pressed
       before this grid has subscribed reaches nobody. The table is the library's (plan V6); the rows are Alvo's,
       because the library's rows take no focus and have no row cursor (study §4.1). `scope="col"` because the
       library's table rules set each cell's display, and Chromium then exposes a bare <th> as a cell, not a header. *@
    <div data-testid="record-grid" data-alvo-keyboard="@(_listening ? "ready" : null)">
        <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Elevation="0" Class="a-grid">
            <thead>
                <tr>
                    @foreach (var column in Scope.Columns)
                    {
                        <th scope="col" class="@(IsNumeric(column) ? "a-num" : null)" title="@column.Name"
                            aria-sort="@AriaSort(column)">
                            @if (GridQuery.Sortable(column, Scope.Masks))
                            {
                                <button type="button" class="a-grid__sort" @onclick="() => OnSort.InvokeAsync(column)">
                                    @GridColumns.Header(column)<span class="a-grid__arrow" aria-hidden="true">@Arrow(column)</span>
                                </button>
                            }
                            else
                            {
                                @GridColumns.Header(column)
                            }
                        </th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody @ref="_body">
                @*
                    The whole row opens the record, because that is what a reader reaching for a
                    row means; the Edit button stays as the same action for Tab, which a clickable
                    row alone does not give — a <tr> is not a control. The row takes focus only
                    from `j`/`k` (tabindex -1), so Tab still walks the controls and nothing else.
                *@
                @{ var selected = Selected; }
                @foreach (var (row, index) in Scope.Page.Items.Select((row, index) => (row, index)))
                {
                    <tr class="a-grid__row" data-testid="grid-row" tabindex="-1"
                        aria-selected="@(index == selected ? "true" : null)" data-alvo-new="@Arrived(row)"
                        @onclick="() => OpenAsync(index)">
                        @foreach (var column in Scope.Columns)
                        {
                            <td class="@CellClass(column, row)">@Value(column, row)</td>
                        }
                        <td class="a-cell--actions">
                            @* The span keeps the press from reaching the row, which would open the record twice. *@
                            <span @onclick:stopPropagation="true">
                                <AlvoButton Tone="AlvoButton.ButtonTone.Ghost" Small="true"
                                            OnClick="_ => OpenAsync(index)">Edit</AlvoButton>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
</div>

@*
    The 375 px substitute for the table above, which the stylesheet hides at that width.
    Both render the same rows from the same page — this is a second *layout*, never a second
    query, and never a second idea of which rows exist.
*@
<div class="a-grid-wrap a-only-mobile-block">
    @foreach (var row in Scope.Page.Items)
    {
        <div class="a-row-card" data-testid="row-card" data-alvo-new="@Arrived(row)">
            <div class="a-row-card__head">
                <span class="a-row-card__title">@CardTitle(row)</span>
                <AlvoButton Tone="AlvoButton.ButtonTone.Ghost" Small="true"
                            OnClick="_ => OnOpen.InvokeAsync(row)">Edit</AlvoButton>
            </div>
            @*
                Label above value for every column the head does not already carry. The
                label field is the card's title, so repeating it underneath would be the
                same value twice with one of them labelled.
            *@
            <dl class="a-row-card__meta">
                @foreach (var column in Scope.Columns.Where(column => Scope.Label?.Covers(column.Name) != true))
                {
                    <div class="a-row-card__pair">
                        <dt title="@column.Name">@GridColumns.Header(column)</dt>
                        <dd>@Value(column, row)</dd>
                    </div>
                }
            </dl>
        </div>
    }
</div>

<div class="a-row">
    @*
        The count is what a reader needs; how the paging works is a property of the
        product, not of this screen's data, and at body weight it was the loudest text
        under the list. It is a title on the count now.
    *@
    <span class="a-note"
          title="Keyset paging over an opaque cursor, stable under concurrent writes.">
        showing @Scope.Page.Items.Count@(Scope.Page.TotalCount is { } total ? $" of {total}" : string.Empty)
    </span>
    <span class="a-spacer"></span>
    @if (Scope.HasPrevious)
    {
        <AlvoButton Small="true" OnClick="_ => OnPrevious.InvokeAsync()">Previous</AlvoButton>
    }
    @if (Scope.Page.NextCursor is { Length: > 0 })
    {
        <AlvoButton Small="true" OnClick="_ => OnNext.InvokeAsync()">Next</AlvoButton>
    }
</div>
@code {
    private readonly List<IAsyncDisposable> _subscriptions = [];
    private ElementReference _body;
    private readonly FocusReturn _focusReturn = new();
    private Guid? _selected;
    private bool _listening;
    private bool _focusPending;
    private Guid? _revealed;
    private bool _revealPending;
    private RowFocus? _rowFocused;
    private int _refusalsSeen;

    /// <summary>What to draw; see <see cref="RecordGridScope"/>.</summary>
    [CascadingParameter]
    private RecordGridScope Scope { get; set; } = default!;

    /// <summary>Raised with the row the operator opened.</summary>
    [Parameter]
    public EventCallback<AlvoRecord> OnOpen { get; set; }

    /// <summary>Raised with the column whose header was pressed.</summary>
    [Parameter]
    public EventCallback<FieldSchema> OnSort { get; set; }

    /// <summary>Raised to read the next page.</summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>Raised to read the previous page.</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _subscriptions.Add(await Interop.SubscribeAsync("move", OnMove));
            _subscriptions.Add(await Interop.SubscribeAsync("open", OnOpenSelected));
            _listening = true;
            StateHasChanged();
        }

        await ReturnFocusAsync();

        if (_revealPending)
        {
            _revealPending = false;
            await RevealSelectedAsync();
        }
        else if (SelectCreated())
        {
            _revealPending = true;
            StateHasChanged();
        }

        if (SelectFocusRow())
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Focuses the selected row when its sheet or confirm has closed, or when a key or the screen asked for it. Not
    /// after a refusal drawn in the same render: its alert takes focus (spec §3.3), and two claims on focus race.
    /// </summary>
    private async Task ReturnFocusAsync()
    {
        var refused = Scope.Refusals != _refusalsSeen;
        _refusalsSeen = Scope.Refusals;
        if ((_focusReturn.Observe(Scope.SheetOpen) && !refused) || _focusPending)
        {
            _focusPending = false;
            await Interop.FocusSelectedAsync(_body);
        }
    }

    /// <summary>Selects the row the screen asked to focus, once it is on the page; the focus follows the next render.</summary>
    private bool SelectFocusRow()
    {
        if (Scope.FocusRow is not { } target || ReferenceEquals(target, _rowFocused)
            || !Scope.Page.Items.Any(row => IdOf(row) == target.Id))
        {
            return false;
        }

        _rowFocused = target;
        _selected = target.Id;
        _focusPending = true;
        return true;
    }

    /// <summary>
    /// Selects the record the operator just created, once it is on the page drawn: the page is read again after the
    /// sheet closes, so the first render after a create still holds the rows from before it. The scroll waits for
    /// the next render, which draws the row as selected.
    /// </summary>
    private bool SelectCreated()
    {
        if (Scope.Created is not { } created || created == _revealed
            || !Scope.Page.Items.Any(row => IdOf(row) == created))
        {
            return false;
        }

        _revealed = created;
        _selected = created;
        return true;
    }

    /// <summary>
    /// Scrolls the selected row into view without taking focus, which the closed sheet gave back to its trigger
    /// (spec §3.4, §3.5).
    /// </summary>
    private async Task RevealSelectedAsync()
    {
        try
        {
            await Scroll.ScrollIntoViewAsync("[data-testid='record-grid'] [aria-selected='true']", ScrollBehavior.Auto);
        }
        catch (JSDisconnectedException)
        {
            /* The circuit has gone, and the page with it. */
        }
    }

    /// <summary>
    /// The selected row's place on the page drawn now, or <see langword="null"/>.
    /// </summary>
    /// <remarks>
    /// Held as the record's id rather than a position, so a save that re-reads the page keeps the row it saved
    /// selected, and a new page — new rows — has none.
    /// </remarks>
    private int? Selected
    {
        get
        {
            for (var index = 0; _selected is not null && index < Scope.Page.Items.Count; index++)
            {
                if (IdOf(Scope.Page.Items[index]) == _selected)
                {
                    return index;
                }
            }

            return null;
        }
    }

    private void Select(int? index) => _selected = index is { } at ? IdOf(Scope.Page.Items[at]) : null;

    private static Guid? IdOf(AlvoRecord row) => RefLabels.IdOf(row[AlvoManagedColumns.Id]);

    /// <summary>
    /// The wash on the record the operator just created, the one every created item gets (spec §3.5); the grid also
    /// selects it, so <c>j</c>/<c>k</c> go on from there.
    /// </summary>
    private string? Arrived(AlvoRecord row) => Scope.Created is { } created && IdOf(row) == created ? "true" : null;

    /// <summary><c>j</c> or <c>k</c>: moves the selection, then focuses the row once it is drawn as selected.</summary>
    private Task OnMove(string? direction) => InvokeAsync(() =>
    {
        Select(RowCursor.Move(Selected, direction, Scope.Page.Items.Count));
        _focusPending = Selected is not null;
        StateHasChanged();
    });

    /// <summary>Enter, when no control has focus: opens the selected row, if there is one.</summary>
    private Task OnOpenSelected(string? _) => InvokeAsync(() =>
        Selected is { } index && index < Scope.Page.Items.Count ? OpenAsync(index) : Task.CompletedTask);

    /// <summary>
    /// Opens a row, and makes it the selected one — so <c>j</c> goes on from the row last opened, and focus
    /// returns to it when its sheet closes.
    /// </summary>
    private Task OpenAsync(int index)
    {
        Select(index);
        _focusReturn.Opened();
        return OnOpen.InvokeAsync(Scope.Page.Items[index]);
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var subscription in _subscriptions)
        {
            await subscription.DisposeAsync();
        }
    }

    private static bool IsNumeric(FieldSchema column)
        => column.Type is FieldType.Integer or FieldType.Decimal;

    private string? AriaSort(FieldSchema column)
        => Scope.Sort is { } sort && string.Equals(sort.Field, column.Name, StringComparison.Ordinal)
            ? sort.Descending ? "descending" : "ascending"
            : null;

    private string Arrow(FieldSchema column) => AriaSort(column) switch
    {
        "ascending" => "↑",
        "descending" => "↓",
        _ => string.Empty,
    };

    /// <summary>A cell's class: numbers right-aligned, and short values kept on one line.</summary>
    private string? CellClass(FieldSchema column, AlvoRecord row)
    {
        var classes = new List<string>(2);
        if (IsNumeric(column))
        {
            classes.Add("a-num");
        }

        if (Shown(column, row).Short)
        {
            classes.Add("a-cell--short");
        }

        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    /// <summary>What a reference cell reads as: its label when there is one, else the short id.</summary>
    private GridCell Shown(FieldSchema column, AlvoRecord row)
    {
        var value = row[column.Name];
        return column.Reference is not null && RefLabels.IdOf(value) is { } id && LabelOf(column, id) is { } label
            ? GridCell.Plain(label)
            : GridCell.Of(column, value);
    }

    private string? LabelOf(FieldSchema column, Guid id)
        => column.Reference is { } reference
            && Scope.Labels.TryGetValue(reference.TargetEntity, out var labels)
            && labels.TryGetValue(id, out var label)
                ? label
                : null;

    private RenderFragment Value(FieldSchema column, AlvoRecord row)
        => column.Reference is not null && RefLabels.IdOf(row[column.Name]) is { } id
            ? Reference(column, id)
            : Drawn(GridCell.Of(column, row[column.Name]));

    /// <summary>
    /// A reference cell: the target row's label, linked to that row on its own Data screen.
    /// </summary>
    /// <remarks>
    /// The link stops the click there, so following it does not also open the row it sits in.
    /// </remarks>
    private RenderFragment Reference(FieldSchema column, Guid id)
    {
        var href = AdminPaths.Records(column.Reference!.TargetEntity, id);
        var cell = LabelOf(column, id) is { } label ? GridCell.Plain(label) : GridCell.Identifier(id);
        var style = cell.Kind == CellKind.Identifier ? "a-link a-ident" : cell.Short ? "a-link" : "a-link a-cell__clip";
        return @<a class="@style" href="@href" title="@(cell.Title ?? id.ToString())" data-testid="ref-cell"
                   @onclick:stopPropagation="true">@cell.Text</a>;
    }

    private static RenderFragment Drawn(GridCell cell) => cell.Kind switch
    {
        CellKind.Value => @<span class="a-badge a-badge--value">@cell.Text</span>,
        CellKind.Flag => @<span role="img" aria-label="@cell.Title" title="@cell.Title">@cell.Text</span>,
        CellKind.Identifier => @<span class="a-ident" title="@cell.Title">@cell.Text</span>,
        CellKind.Text when !cell.Short => @<span class="a-cell__clip" title="@cell.Title">@cell.Text</span>,
        _ => @<text>@cell.Text</text>,
    };

    /// <summary>A phone card's title: the row's label, else its short id.</summary>
    private RenderFragment CardTitle(AlvoRecord row) => Scope.Label?.Of(row) is { } label
        ? Drawn(GridCell.Plain(label))
        : Drawn(GridCell.Of(new FieldSchema { Name = AlvoManagedColumns.Id, Type = FieldType.Uuid }, row[AlvoManagedColumns.Id]));
}
