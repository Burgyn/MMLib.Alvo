@*
    The layout for the screens that exist before there is anybody to show a sidebar to.

    No navigation, because nothing behind it is reachable yet; the shell's chrome would be five
    links to five refusals.
*@
@inherits LayoutComponentBase

<div style="min-height:100vh;background:var(--bg)">
    <div class="a-content">
        @Body
    </div>
</div>
