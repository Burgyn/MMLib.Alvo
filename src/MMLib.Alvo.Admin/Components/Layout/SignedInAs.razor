@*
    Who is signed in, and the way out.

    The tenant is shown because §2.7 makes it the reason half the Data screen works or does not: an
    operator with no tenant reads a tenant-scoped entity as a 403 before any rule is consulted, and
    an operator who cannot see which tenant they hold has no way to understand that refusal.

    Signing out is a form post, not a link. A sign-out reachable by GET is triggered by any page
    that embeds an image pointing at it.
*@
<AuthorizeView>
    <Authorized>
        <div class="a-switcher" style="cursor:default;align-items:flex-start">
            <span class="a-brand-mark" style="background:var(--panel2);color:var(--dim)">@Initial(context.User.Identity?.Name)</span>
            <span style="min-width:0;flex:1">
                <span class="a-switcher-name" style="overflow-wrap:anywhere">@context.User.Identity?.Name</span>
                <span class="a-switcher-meta">@Roles(context) · @Tenant(context)</span>
            </span>
        </div>
        @* data-enhance="false", for the reason the sign-in form carries: the answer to this post
           is a cleared cookie and a redirect, and an enhanced post would patch the DOM instead of
           navigating — leaving the operator on a dashboard they are no longer signed into. *@
        <form method="post" action="@AlvoAdmin.SignOutEndpoint" style="margin-top:var(--space-2)"
              data-enhance="false">
            <AntiforgeryToken />
            <button type="submit" class="a-btn a-btn--ghost a-btn--sm" style="width:100%">Sign out</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a class="a-btn a-btn--sm" href="@AdminPaths.SignIn" style="width:100%">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string Initial(string? name)
        => (name is { Length: > 0 } ? name[..1] : "?").ToUpperInvariant();

    private static string Roles(AuthenticationState state)
    {
        var roles = state.User.Claims
            .Where(claim => claim.Type == System.Security.Claims.ClaimTypes.Role)
            .Select(claim => claim.Value)
            .ToArray();

        return roles.Length > 0 ? string.Join(", ", roles) : "no role";
    }

    /// <summary>
    /// An operator carries one tenant (§2.7). "No tenant" is stated rather than left blank,
    /// because it is the whole explanation for a 403 the Data screen is about to show.
    /// </summary>
    private static string Tenant(AuthenticationState state)
    {
        var tenant = state.User.FindFirst(AlvoAdminClaims.Tenant)?.Value;
        return tenant is { Length: > 0 } ? $"tenant {Shorten(tenant)}" : "no tenant";
    }

    private static string Shorten(string tenant)
        => tenant.Length > 13 ? $"{tenant[..4]}…{tenant[^4..]}" : tenant;
}
