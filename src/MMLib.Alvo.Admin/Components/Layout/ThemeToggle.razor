@*
    The theme toggle.

    The theme itself is applied by alvo.js before the first paint, from localStorage — so this
    button's only job is to flip it and to say which way it flips next. It reads the resolved theme
    after the first render rather than during it: on the server there is no `prefers-color-scheme`
    to read, and a label rendered from a guess would be wrong for every viewer whose system is dark.

    An icon of the theme it switches to, and the action spelled out in the label and the tooltip. A
    bare "Light" read as either the state or the action, and nothing on the button said which.
*@
@implements IAsyncDisposable
@inject IJSRuntime Js

<button type="button" class="a-btn a-btn--ghost a-btn--sm" @onclick="Toggle"
        aria-label="@Label" title="@Label" data-testid="theme-toggle">
    <Icon Path="@(_theme == "dark" ? Icons.Sun : Icons.Moon)" />
</button>

@code {
    private IJSObjectReference? _module;
    private string _theme = string.Empty;

    private string Label => _theme == "dark" ? "Switch to light theme" : "Switch to dark theme";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", AlvoAdminAssets.Module);
        _theme = await _module.InvokeAsync<string>("theme");
        StateHasChanged();
    }

    private async Task Toggle()
    {
        if (_module is not null)
        {
            _theme = await _module.InvokeAsync<string>("toggleTheme");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                /* The circuit went away before the module could be released; there is nothing left
                   to release it in. Blazor raises this on every navigation away, so swallowing it
                   here is the documented pattern rather than a hidden failure. */
            }
        }
    }
}
