@*
    ⌘K.

    It is the keyboard's front door, so it is held to the keyboard's standard: focus moves into the
    input when it opens and returns to where it came from when it closes, the arrow keys and Enter
    work without a pointer, and Escape always dismisses. The list is the navigation plus every
    entity in the schema, because "go to the customers entity" is the query an operator actually
    has — and a palette that only listed sections would send them to Schema to look for it.
*@
@implements IAsyncDisposable
@inject ManagementGateway Gateway
@inject NavigationManager Navigation
@inject IJSRuntime Js

@if (_open)
{
    <div class="a-scrim" style="display:grid;place-items:start center;padding-top:12vh;z-index:40"
         @onclick="Close">
        <div class="a-palette" role="dialog" aria-modal="true" aria-label="Search"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            <input class="a-palette__input" placeholder="Go to a section or an entity…"
                   @ref="_input" @bind="_query" @bind:event="oninput" aria-label="Search" />
            <div role="listbox">
                @if (Matches.Count == 0)
                {
                    <div class="a-palette__item" style="color:var(--dim)">
                        Nothing matches “@_query”. Sections and entities are what this searches.
                    </div>
                }
                @foreach (var (match, index) in Matches.Select((match, index) => (match, index)))
                {
                    <button type="button" role="option" aria-selected="@(index == _active)"
                            class="@($"a-palette__item{(index == _active ? " a-palette__item--active" : string.Empty)}")"
                            @onclick="() => Go(match)">
                        <Icon Path="@match.Icon" />
                        <span>@match.Title</span>
                        <span style="margin-left:auto;color:var(--faint);font-size:var(--text-2xs)">@match.Kind</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Entry> _entries = [];
    private IJSObjectReference? _module;
    private DotNetObjectReference<CommandPalette>? _self;
    private ElementReference _input;
    private bool _open;
    private bool _focusPending;
    private string _query = string.Empty;
    private int _active;

    private List<Entry> Matches => _entries
        .Where(entry => _query.Length == 0
            || entry.Title.Contains(_query, StringComparison.OrdinalIgnoreCase))
        .Take(12)
        .ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", AlvoAdminAssets.Module);
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("subscribe", "palette", _self, nameof(OnPaletteRequested));
            await _module.InvokeVoidAsync("subscribe", "goto", _self, nameof(OnGoto));
            await _module.InvokeVoidAsync("subscribe", "dismiss", _self, nameof(OnDismiss));
        }

        if (_focusPending && _module is not null)
        {
            _focusPending = false;
            await _module.InvokeVoidAsync("focusAndSelect", _input);
        }
    }

    /// <summary>Opens the palette, from the header button or from ⌘K.</summary>
    public async Task OpenAsync()
    {
        await LoadEntriesAsync();
        _open = true;
        _active = 0;
        _focusPending = true;
        StateHasChanged();
    }

    /// <summary>⌘K, forwarded from alvo.js.</summary>
    [JSInvokable]
    public Task OnPaletteRequested(string? _) => OpenAsync();

    /// <summary>Escape, forwarded from alvo.js.</summary>
    [JSInvokable]
    public Task OnDismiss(string? _)
    {
        Close();
        return Task.CompletedTask;
    }

    /// <summary>
    /// <c>g</c> then a letter. The letters are the navigation's own (§5.5), so the shortcut and the
    /// sidebar cannot disagree about where <c>g s</c> goes.
    /// </summary>
    [JSInvokable]
    public Task OnGoto(string? key)
    {
        var target = AdminNavigation.All.FirstOrDefault(
            candidate => candidate.GoKey is { } go && key is { Length: 1 } && go == key[0]);

        if (target is not null)
        {
            Navigation.NavigateTo(target.Path);
        }

        return Task.CompletedTask;
    }

    private async Task LoadEntriesAsync()
    {
        _entries.Clear();
        foreach (var entry in AdminNavigation.All)
        {
            _entries.Add(new Entry(entry.Title, entry.Path, entry.Icon,
                entry.NotYet ? "not yet" : "section"));
        }

        try
        {
            var schema = await Gateway.SchemaAsync(CancellationToken.None);
            foreach (var entity in schema.Entities)
            {
                _entries.Add(new Entry(entity.Name, $"{AlvoAdmin.BasePath}/schema/{entity.Name}",
                    Icons.Schema, "entity"));
            }
        }
        catch (ManagementForbiddenException)
        {
            /* A viewer who may not read the schema still gets a working palette over the sections
               they can reach. Refusing to open it would be a second, worse way to say "forbidden". */
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowDown":
                _active = Math.Min(_active + 1, Math.Max(Matches.Count - 1, 0));
                break;
            case "ArrowUp":
                _active = Math.Max(_active - 1, 0);
                break;
            case "Enter" when Matches.Count > 0:
                Go(Matches[Math.Min(_active, Matches.Count - 1)]);
                break;
            case "Escape":
                Close();
                break;
            default:
                _active = 0;
                break;
        }
    }

    private void Go(Entry entry)
    {
        Close();
        Navigation.NavigateTo(entry.Path);
    }

    private void Close()
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        _query = string.Empty;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unsubscribe", "palette", nameof(OnPaletteRequested));
                await _module.InvokeVoidAsync("unsubscribe", "goto", nameof(OnGoto));
                await _module.InvokeVoidAsync("unsubscribe", "dismiss", nameof(OnDismiss));
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                /* The circuit is already gone; the listeners went with the document. */
            }
        }

        _self?.Dispose();
    }

    private sealed record Entry(string Title, string Path, string Icon, string Kind);
}
