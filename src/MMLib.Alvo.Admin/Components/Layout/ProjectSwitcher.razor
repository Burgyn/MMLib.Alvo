@*
    The project, and today it is not a switcher.

    `GET {m}/projects` answers with exactly one project (§2.6), so a control offering a choice would
    be offering a choice that does not exist — the drawing's dropdown is drawn here as what it
    really is: the project's name, its revision, and the data provider under it. The day the API
    answers with two, this is the one place that changes.
*@
@implements IDisposable
@inject ManagementGateway Gateway
@inject NavigationManager Navigation

<div class="a-switcher" style="cursor:default">
    <span class="a-brand-mark">@Initial</span>
    <span style="min-width:0">
        <span class="a-switcher-name">@(_project?.Name ?? (_refused ? "No project" : "…"))</span>
        <span class="a-switcher-meta">@Meta</span>
    </span>
</div>

@code {
    private ManagementProject? _project;
    private ManagementInfo? _info;
    private bool _refused;

    private string Initial => (_project?.Name is { Length: > 0 } name ? name[..1] : "?").ToUpperInvariant();

    private string Meta => (_project, _info) switch
    {
        ({ Revision: { } revision }, { } info) => $"revision {revision} · {info.DataProvider}",
        ({ Revision: null }, { } info) => $"not applied yet · {info.DataProvider}",
        _ => _refused ? "not admitted to this project" : "loading",
    };

    /// <summary>
    /// A refusal here is rendered, never thrown.
    /// </summary>
    /// <remarks>
    /// This sits in the layout, so an exception escaping it takes every screen with it — including
    /// the one that would have explained the refusal. An operator whose account is admitted to
    /// nothing must still get a dashboard that says so, which is exactly the failure mode design
    /// §5.5 has in mind when it says an error lands where it happened and stays.
    /// </remarks>
    protected override void OnInitialized() => Navigation.LocationChanged += Reload;

    /// <summary>
    /// Re-reads on navigation, because this sits in the layout and the layout is not re-initialised.
    /// </summary>
    /// <remarks>
    /// Without it the revision in the sidebar is whatever it was when the session started, and an
    /// operator who has just applied a change reads a number that contradicts the screen they are
    /// looking at. The gateway's own cache is what makes this cheap: after an apply it has been
    /// invalidated, and on every other navigation the read is already in hand.
    /// </remarks>
    private void Reload(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var projects = await Gateway.ProjectsAsync(CancellationToken.None);
            _project = projects.Count > 0 ? projects[0] : null;
            _info = await Gateway.InfoAsync(CancellationToken.None);
        }
        catch (Exception exception) when (exception is ManagementForbiddenException
            or ManagementRequestException or ManagementProjectNotFoundException)
        {
            _refused = true;
        }
    }

    public void Dispose() => Navigation.LocationChanged -= Reload;
}
