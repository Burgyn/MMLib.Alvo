@page "/admin/rules"
@page "/admin/rules/{EntityName}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject AdminSession Session
@inject NavigationManager Navigation
@inject ILogger<Rules> Logger
@implements IDisposable

<PageTitle>Rules · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="Rules" />

    @if (_problem is not null)
    {
        <CascadingValue Value="_problem">
            <ErrorPanel />
        </CascadingValue>
    }
    else if (_schema is null)
    {
        <Skeleton Size="Skeleton.SkeletonSize.Lg" />
    }
    else
    {
        @*
            A strip reads at a glance while it fits; past a handful of entities it scrolls sideways and
            the one somebody wants is off the edge, so it becomes a select.
        *@
        @if (_names.Count > TabStripLimit)
        {
            <Field Label="Entity" LabelId="rules-entity-label" class="a-field--narrow">
                <MudSelect T="string" Value="Selected" ValueChanged="Choose" Variant="Variant.Outlined"
                           aria-labelledby="rules-entity-label" data-testid="rules-entity" Class="a-mono">
                    @foreach (var name in _names)
                    {
                        <MudSelectItem Value="@name">@name</MudSelectItem>
                    }
                </MudSelect>
            </Field>
        }
        else
        {
            <MudTabs ActivePanelIndex="@SelectedIndex" OnPreviewInteraction="ChooseAsync"
                     Elevation="0" Ripple="false" KeepPanelsAlive="false" Class="a-ruletabs" id="rules-entities">
                @foreach (var name in _names)
                {
                    <MudTabPanel Text="@name" />
                }
            </MudTabs>
            @TablistName.On("#rules-entities", "Entity")
        }

        <div class="a-split">
            <Panel class="a-split__main a-grow">
                @if (SelectedIsPending)
                {
                    <p class="a-note" data-testid="rules-pending">
                        <span class="a-badge a-badge--warn">not applied yet</span>
                        These are the working copy's rules for <code class="a-mono">@Selected</code>. Edit them on
                        <a href="@AdminPaths.Entity(Selected)">its schema screen</a>.
                    </p>
                }
                <RulesTab Rules="_rules" Entity="@Selected" />
            </Panel>

            <SplitHandle Controls="rules-simulator" />

            @* The aside's own width, and full width once the split stacks — a fixed minimum here made the
               simulator narrower or wider than the rules card above it on a phone. *@
            <div class="a-split__aside" id="rules-simulator">
                <div class="a-card a-card--roomy">
                    <div>
                        <span class="a-section__title">Simulate a policy</span>
                        <p class="a-section__sub">
                            Pick a caller and an operation; the verdict comes from the same rule engine the
                            Data API uses.
                        </p>
                        <span class="a-ident">API: POST …/policy/simulate</span>
                    </div>

                    <Field Label="Signed in as" LabelId="rules-caller">
                        <ChildContent>
                            <ChipGroup TValue="Caller" Items="_callers" Selected="[_caller]" aria-labelledby="rules-caller"
                                       Label="caller => caller.Label" SelectedChanged="callers => Pick(callers[0])" />
                        </ChildContent>
                        <Hint>
                            roles: @(_caller.Roles.Count == 0 ? "none" : string.Join(", ", _caller.Roles)) ·
                            tenant: @(_caller.Tenant is { } tenant ? tenant.ToString() : "none")
                        </Hint>
                    </Field>

                    <Field Label="Operation" LabelId="rules-operation">
                        <ChipGroup TValue="string" Items="_operations" Selected="[_operation]" aria-labelledby="rules-operation"
                                   SelectedChanged="operations => SetOperation(operations[0])" />
                    </Field>

                    @* Keyed per refusal by RefusalState, so a second failure after a press takes focus and is read again. *@
                    @if (SelectedIsPending)
                    {
                        <p class="a-note" data-testid="simulate-pending">
                            The engine serves the applied schema, and <code class="a-mono">@Selected</code> is not in it
                            yet, so there is nothing to ask. Preview and apply the working copy to simulate it.
                        </p>
                    }
                    else if (_simulationProblem.Shown)
                    {
                        @RefusalPanel.Of(_simulationProblem, RetryAction)
                    }
                    else if (_verdict is { } verdict)
                    {
                        <PolicyVerdictView Verdict="verdict" Operation="@_operation" Entity="@Selected" />
                    }

                    <p class="a-note a-note--ruled">
                        <strong>Why there is no record picker.</strong>
                        Checking a rule against one stored row needs a read of that row, which this screen does
                        not make — scoring it here would make it a second policy evaluator that could disagree
                        with the engine. To check one row, open it in Data as yourself.
                        @if (!SelectedIsPending)
                        {
                            <AlvoButton Small="true" class="a-actions"
                                        Href="@AdminPaths.Records(Selected)">Open @Selected in Data</AlvoButton>
                        }
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] _operations = ["list", "get", "create", "update", "delete"];

    /// <summary>The most entities the picker draws as a tab strip before it becomes a select.</summary>
    private const int TabStripLimit = 6;

    private readonly List<Caller> _callers = [];
    private SchemaModel? _schema;

    /// <summary>
    /// The entities the picker offers: the applied ones in the schema's order, then the ones only the working copy
    /// declares, as the schema list draws them — a pending entity with no tab here read as one with no rules at all.
    /// </summary>
    private IReadOnlyList<string> _names = [];
    private IReadOnlySet<string> _pending = new HashSet<string>();

    /// <summary>This operator's working copy, followed so a pending tab comes and goes as the copy changes.</summary>
    private WorkingCopy? _copy;
    private string _appliedJson = "{}";
    private readonly ComponentLifetime _lifetime = new();
    private IReadOnlyList<KeyValuePair<string, string>> _rules = [];
    private ManagementPolicyVerdict? _verdict;
    private AdminProblem? _problem;
    private readonly RefusalState<AdminProblem> _simulationProblem = new();

    private RenderFragment RetryAction => @<AlvoButton Small="true" data-testid="simulate-retry"
                                                      OnClick="_ => SimulateAsync()">Try again</AlvoButton>;
    private int _simulation;
    private Caller _caller = new("anonymous", null, [], null);
    private string _operation = "list";

    /// <summary>The entity whose rules are shown, from the route.</summary>
    [Parameter]
    public string? EntityName { get; set; }

    /// <summary>Where the selected entity sits in the strip, which is the order the schema lists them in.</summary>
    private int SelectedIndex
    {
        get
        {
            for (var index = 0; index < _names.Count; index++)
            {
                if (_names[index] == Selected)
                {
                    return index;
                }
            }

            return 0;
        }
    }

    private string Selected => EntityName ?? _names.FirstOrDefault() ?? string.Empty;

    /// <summary>Whether the selected entity is only in the working copy, so the engine cannot be asked about it.</summary>
    private bool SelectedIsPending => _pending.Contains(Selected);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _schema = await Gateway.SchemaAsync(CancellationToken.None);
            var descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _appliedJson = descriptor.DescriptorJson;
            await FollowCopyAsync();
            ReadEntities();

            if (_callers.Count == 0)
            {
                await BuildCallersAsync(descriptor.DescriptorJson);
            }

            await SimulateAsync(pressed: false);
        }
        catch (Exception exception)
        {
            _problem = AdminProblem.From(exception, Logger);
        }
    }

    /// <summary>
    /// The callers worth asking about.
    /// </summary>
    /// <remarks>
    /// <b>You, anonymous, and one caller per declared role.</b> "You" is the honest default because
    /// it is the only caller whose answer an operator can go and verify in Data; anonymous is the
    /// one every default-deny argument turns on; and the per-role callers come from
    /// <c>auth.roles</c> rather than from a list here, so a role added to the descriptor appears
    /// without anybody editing this screen.
    /// </remarks>
    private async Task BuildCallersAsync(string descriptorJson)
    {
        var mine = await Session.CallerAsync(CancellationToken.None);
        _caller = new Caller("you", mine.User == default ? null : mine.User.Value,
            [.. mine.Roles.Select(role => role.Name)], mine.Tenant?.Value);

        _callers.Add(_caller);
        _callers.Add(new Caller("anonymous", null, [], null));

        /* A synthetic id per role, because a rule can name @user.id and the engine needs *a*
           subject to compile against. It is not a real account and cannot be: the point of these
           callers is the predicate they produce, and a predicate over @user.id renders with
           whatever id it was given. Your own caller, above, is the one whose answer can be checked
           against Data. */
        foreach (var role in DescriptorLens.DeclaredRoles(descriptorJson))
        {
            _callers.Add(new Caller(role, Guid.NewGuid(), [role, "authenticated"], mine.Tenant?.Value));
        }
    }

    /// <inheritdoc />
    public void Dispose() => _lifetime.Dispose();

    /// <summary>
    /// Takes this operator's copy and follows it, once: the parameters are set again on every move to another
    /// entity, and the copy is the same across all of them (Entity's and Preview's idiom).
    /// </summary>
    private async Task FollowCopyAsync()
    {
        if (_copy is null)
        {
            _copy = await Session.WorkingCopyAsync(_lifetime.Token);
            Session.Follow(_copy, InvokeAsync, OnCopyChanged, _lifetime.Token);
        }
    }

    /// <summary>
    /// The applied entities and, after them, the ones only the working copy declares (§8d item 28's rule), with the
    /// selected entity's rules from whichever of the two it is in.
    /// </summary>
    private void ReadEntities()
    {
        var applied = _schema!.Entities.Select(entity => entity.Name).ToList();
        var declared = _copy?.Entities ?? [];
        _pending = declared.Where(name => !applied.Contains(name, StringComparer.Ordinal)).ToHashSet(StringComparer.Ordinal);
        _names = [.. applied, .. declared.Where(_pending.Contains)];
        _rules = DescriptorLens.Rules(SelectedIsPending ? _copy!.Json : _appliedJson, Selected);
    }

    /// <summary>
    /// Redraws the picker and a pending entity's rules when the copy changes — a Discard or a removal in another tab
    /// takes its tab away, and an entity that is gone leaves for the first one rather than drawing rules for nothing.
    /// </summary>
    private void OnCopyChanged()
    {
        if (_schema is null)
        {
            return;
        }

        ReadEntities();
        if (EntityName is { } named && !_names.Contains(named, StringComparer.Ordinal))
        {
            Navigation.NavigateTo(AdminPaths.Rules(), replace: true);
            return;
        }

        StateHasChanged();
    }

    private void Choose(string entity) => Navigation.NavigateTo(AdminPaths.Rules(entity));

    /// <summary>
    /// Opens the entity whose tab the operator activated.
    /// </summary>
    /// <remarks>
    /// On the operator's interaction rather than on <c>ActivePanelIndexChanged</c>: MudTabs also moves its active index
    /// as it removes its panels, which it does when the page is disposed after a prerender and when the circuit
    /// closes. Followed there, the index change navigated away from a page nobody was looking at, which throws while
    /// prerendering and fails once the circuit is gone.
    /// </remarks>
    private Task ChooseAsync(TabInteractionEventArgs interaction)
    {
        if (interaction.PanelIndex >= 0 && interaction.PanelIndex < _names.Count && _names[interaction.PanelIndex] != Selected)
        {
            Choose(_names[interaction.PanelIndex]);
        }

        return Task.CompletedTask;
    }

    private async Task Pick(Caller caller)
    {
        _caller = caller;
        await SimulateAsync();
    }

    private async Task SetOperation(string operation)
    {
        _operation = operation;
        await SimulateAsync();
    }

    /// <summary>
    /// Asks the engine for the verdict on the caller and operation chosen now.
    /// </summary>
    /// <remarks>
    /// <b>Only the latest question is answered.</b> The arrow keys choose as they move, so three chips
    /// can be passed in as many keystrokes and the answers can arrive in any order; an answer to a
    /// question that is no longer the one on screen is dropped rather than drawn under the wrong chips.
    /// </remarks>
    /// <param name="pressed">Whether an operator's choice asked it, so a refusal takes focus; the page's own first ask does not.</param>
    private async Task SimulateAsync(bool pressed = true)
    {
        /* A pending entity is not in the schema the engine serves; asking would only be refused. */
        if (Selected.Length == 0 || SelectedIsPending)
        {
            _verdict = null;
            _simulationProblem.Clear();
            return;
        }

        var asked = ++_simulation;

        try
        {
            var verdict = await Gateway.SimulateAsync(
                new ManagementPolicySimulation(
                    Selected, _operation,
                    new ManagementSimulatedCaller(_caller.User, _caller.Roles, _caller.Tenant)),
                CancellationToken.None);

            if (asked == _simulation)
            {
                _simulationProblem.Clear();
                _verdict = verdict;
            }
        }
        catch (Exception exception)
        {
            var problem = AdminProblem.From(exception, Logger);
            if (asked == _simulation)
            {
                _simulationProblem.Show(problem, pressed);
                _verdict = null;
            }
        }
    }

    /// <summary>One caller to ask the engine about.</summary>
    private sealed record Caller(string Label, Guid? User, IReadOnlyList<string> Roles, Guid? Tenant);
}
