@*
    The fields, with the facets the frozen schema admits for each type.

    Every badge here is a value read off FieldSchema, never a guess: the schema's own if/then rules
    decide which facets a type may carry, so a renderer that invented one would be showing a
    descriptor the apply would refuse.
*@
@foreach (var field in Declared)
{
    var staged = Staged.FieldChange(field.Name);
    var removed = staged == StagedChange.Removed;

    <ListRow class="@(removed ? "a-listrow--removed" : null)" data-testid="@($"field-row-{field.Name}")">
        <span class="a-mono a-listrow__key a-listrow__key--strong">@field.Name</span>
        <span class="a-ident a-listrow__type">@Type(field)</span>
        <span class="a-listrow__rest">
            @if (staged != StagedChange.None)
            {
                <span class="@($"a-badge {(removed ? "a-badge--danger" : "a-badge--accent")}")"
                      data-testid="@($"staged-{field.Name}")">@Word(staged)</span>
            }
            @foreach (var facet in Facets(field))
            {
                <span class="a-badge">@facet</span>
            }
        </span>
        @*
            The controls are a sibling of the facets, not the last item inside them. Inside, a row
            with three badges pushed them onto a second line and a row with one kept them inline —
            so the same list drew its own controls in two different places.
        *@
        @if (Editable && removed)
        {
            <span class="a-listrow__actions">
                <button type="button" class="a-btn a-btn--ghost a-btn--sm"
                        data-testid="@($"restore-field-{field.Name}")"
                        @onclick="() => Staged.Restore.InvokeAsync(field.Name)">Undo</button>
            </span>
        }
        else if (Editable)
        {
            <span class="a-listrow__actions">
                <button type="button" class="a-btn a-btn--ghost a-btn--sm"
                        data-testid="@($"edit-field-{field.Name}")"
                        @onclick="() => OnEdit.InvokeAsync(field.Name)">Edit</button>
                <button type="button" class="a-btn a-btn--ghost a-btn--sm"
                        data-testid="@($"remove-field-{field.Name}")"
                        @onclick="() => OnRemove.InvokeAsync(field.Name)">Remove</button>
            </span>
        }
    </ListRow>
}

<div class="a-section a-section--spaced">
    <span class="a-section-title">Maintained by Alvo</span>
    <span class="a-section-sub">
        Not declared in the descriptor and not writable by a caller — an audit trail a caller can
        author is not an audit trail. They are shown because they are real columns a filter can
        name and a response carries.
    </span>
</div>

@foreach (var field in Managed)
{
    <ListRow class="a-listrow--dim">
        <span class="a-mono a-listrow__key">@field.Name</span>
        <span class="a-ident a-listrow__type">@Type(field)</span>
        <span class="a-listrow__rest">
            <span class="a-badge">@(AlvoManagedColumns.IsCallerWritable(field.Name, isUpdate: false)
                ? "supplied on create only" : "framework writes it")</span>
        </span>
    </ListRow>
}

@code {
    /// <summary>The entity whose fields these are.</summary>
    [Parameter, EditorRequired]
    public EntitySchema Entity { get; set; } = default!;

    /// <summary>
    /// Whether a declared field can be changed or dropped from here.
    /// </summary>
    /// <remarks>
    /// The managed columns are never editable, whatever this says: an audit stamp a caller can
    /// author is not an audit stamp, and the rows below the second heading are rendered without
    /// these controls for that reason rather than by omission.
    /// </remarks>
    [Parameter]
    public bool Editable { get; set; }

    /// <summary>Raised with the field an operator asked to change.</summary>
    [Parameter]
    public EventCallback<string> OnEdit { get; set; }

    /// <summary>Raised with the field an operator asked to drop.</summary>
    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    /// <summary>
    /// What the working copy changed, cascaded by the entity screen.
    /// </summary>
    /// <remarks>
    /// <b>The rows themselves come from <see cref="Entity"/>, which the caller builds from the working copy</b>
    /// with the removed fields still in it — so a field staged here appears here, where it was staged, and
    /// not only in the preview. A removed row offers Undo rather than Edit and Remove. Cascaded and private
    /// rather than a parameter, so the staging model stays out of the package's public surface.
    /// </remarks>
    [CascadingParameter]
    private StagedView Staged { get; set; } = StagedView.None;

    /// <summary>The word a staged row's badge reads.</summary>
    private static string Word(StagedChange change) => change switch
    {
        StagedChange.New => "new",
        StagedChange.Changed => "changed",
        _ => "removed",
    };

    /// <summary>The fields the descriptor declares.</summary>
    private IEnumerable<FieldSchema> Declared
        => Entity.Fields.Where(column => !AlvoManagedColumns.For(Entity).Contains(column.Name));

    /// <summary>The columns Alvo adds — id, the tenant, the audit stamps, the soft-delete mark.</summary>
    private IEnumerable<FieldSchema> Managed
        => Entity.Fields.Where(column => AlvoManagedColumns.For(Entity).Contains(column.Name));

    private const int LiteralBadgeLimit = 24;

    /// <summary>
    /// The declared default as the descriptor holds it, short enough to sit in a badge.
    /// </summary>
    /// <remarks>
    /// The raw JSON rather than the .NET rendering, so a string default reads as <c>"unnamed"</c> and a
    /// number as <c>0</c> — the badge is telling the reader what is in the descriptor, and a quoted string
    /// that lost its quotes is a different declaration.
    /// </remarks>
    private static string Literal(System.Text.Json.JsonElement literal)
    {
        var text = literal.GetRawText();

        return text.Length <= LiteralBadgeLimit ? text : text[..LiteralBadgeLimit] + "…";
    }

    private static string Type(FieldSchema field)
        => field.Type == FieldType.Ref && field.Reference is { } reference
            ? $"ref → {reference.TargetEntity}"
            : field.Type.ToString().ToLowerInvariant();

    /// <summary>
    /// The facets this field actually carries.
    /// </summary>
    /// <remarks>
    /// Ordered so the ones that change what a caller may send come first: a reader scanning the
    /// column is looking for "what will this reject", not for the storage detail.
    /// </remarks>
    private static IEnumerable<string> Facets(FieldSchema field)
    {
        if (field.Required)
        {
            yield return "required";
        }

        if (field.Default is { } literal)
        {
            yield return $"default {Literal(literal)}";
        }

        if (field.Unique)
        {
            yield return "unique";
        }

        if (field.Format is { Length: > 0 } format)
        {
            yield return format;
        }

        if (field.MaxLength is { } max)
        {
            yield return $"max {max}";
        }

        if (field.Precision is { } precision)
        {
            yield return field.Scale is { } scale ? $"{precision},{scale}" : $"precision {precision}";
        }

        if (field.EnumValues is { Count: > 0 } values)
        {
            yield return $"{values.Count} values";
        }

        if (field.Reference is { } reference)
        {
            yield return $"on delete {reference.OnDelete.ToString().ToLowerInvariant()}";
        }

        if (field.ComputedExpression is { Length: > 0 })
        {
            yield return "computed";
        }

        if (field.Rollup is not null)
        {
            yield return "rollup";
        }

        if (field.Indexed)
        {
            yield return "indexed";
        }
    }
}
