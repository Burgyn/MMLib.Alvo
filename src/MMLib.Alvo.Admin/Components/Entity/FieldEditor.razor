@*
    Adding a field.

    The controls change with the type, because the frozen schema's if/then rules decide which
    facets a type may carry — `decimal` needs precision and scale, `enum` needs values, `ref` needs
    an entity, and `string` may have a maxLength that `boolean` may not. Offering every facet for
    every type would be offering a descriptor the apply refuses.

    Nothing here writes to the database. The field lands in the working copy and goes through the
    same dry run as every other change.
*@
<div class="a-panel" style="margin-top:var(--space-4)">
    <div class="a-section">
        <span class="a-section-title">@(IsEditing ? $"Edit {Editing}" : "Add a field")</span>
        <span class="a-section-sub">
            @(IsEditing
                ? "The change joins the working copy. Preview shows what it does to the table before anything runs."
                : "It joins the working copy. Preview shows what it does to the table before anything runs.")
        </span>
    </div>

    <div class="a-stack" style="padding:var(--space-5)">
        @if (_refusal is { Length: > 0 })
        {
            <ErrorPanel Heading="@(IsEditing ? "That change cannot be saved" : "That field cannot be added")"
                        Fix="@_refusal" />
        }

        <div class="a-field">
            <label class="a-label" for="new-field-name">Name</label>
            <input class="a-input" id="new-field-name" value="@_name" placeholder="scheduled_for"
                   @oninput="args => _name = args.Value?.ToString() ?? string.Empty" autocomplete="off"
                   disabled="@IsEditing" />
            <span class="a-section-sub">
                @if (IsEditing)
                {
                    <text>
                        A rename is carried by <code class="a-mono">renamedFrom</code>, so that the column
                        moves instead of being dropped and recreated — rename in the descriptor and import it.
                    </text>
                }
                else
                {
                    <text>Lower case, digits and underscores — <code class="a-mono">@DescriptorNames.Member</code></text>
                }
            </span>
        </div>

        <div class="a-field">
            <span class="a-label">Type</span>
            <div class="a-choice">
                @foreach (var type in Enum.GetValues<FieldType>())
                {
                    <button type="button" class="@($"a-chip{(type == _type ? " a-chip--on" : string.Empty)}")"
                            @onclick="() => _type = type">@type.ToString().ToLowerInvariant()</button>
                }
            </div>
        </div>

        <div class="a-field">
            <span class="a-label">Constraints</span>
            <div class="a-check-row">
                <label class="a-check">
                    <input type="checkbox" checked="@_required" @onchange="args => _required = args.Value is true" />
                    <span>required</span>
                </label>
                @if (_type is FieldType.String or FieldType.Integer or FieldType.Uuid or FieldType.Date or FieldType.DateTime)
                {
                    <label class="a-check">
                        <input type="checkbox" checked="@_unique" @onchange="args => _unique = args.Value is true" />
                        <span>unique</span>
                    </label>
                }
            </div>
        </div>

        @switch (_type)
        {
            case FieldType.String:
                <div class="a-field">
                    <label class="a-label" for="new-field-max">Max length</label>
                    <input class="a-input" id="new-field-max" type="number" value="@_maxLength"
                           @oninput="args => _maxLength = Number(args.Value, 120)" />
                </div>
                break;
            case FieldType.Decimal:
                <div class="a-field-row">
                    <div class="a-field">
                        <label class="a-label" for="new-field-precision">Precision</label>
                        <input class="a-input" id="new-field-precision" type="number" value="@_precision"
                               @oninput="args => _precision = Number(args.Value, 10)" />
                        <span class="a-section-sub">Total digits, not the ones before the point.</span>
                    </div>
                    <div class="a-field">
                        <label class="a-label" for="new-field-scale">Scale</label>
                        <input class="a-input" id="new-field-scale" type="number" value="@_scale"
                               @oninput="args => _scale = Number(args.Value, 2)" />
                        <span class="a-section-sub">Digits after the point.</span>
                    </div>
                </div>
                break;
            case FieldType.Enum:
                <div class="a-field">
                    <label class="a-label" for="new-field-values">Values</label>
                    <input class="a-input" id="new-field-values" value="@_values" placeholder="scheduled, in_progress, completed"
                           @oninput="args => _values = args.Value?.ToString() ?? string.Empty" />
                    <span class="a-section-sub">Comma separated. An enum with no values is refused by the schema.</span>
                </div>
                break;
            case FieldType.Ref:
                <div class="a-field">
                    <span class="a-label">Points at</span>
                    <div class="a-choice">
                        @foreach (var target in Targets)
                        {
                            <button type="button" class="@($"a-chip{(target == _target ? " a-chip--on" : string.Empty)}")"
                                    @onclick="() => _target = target">@target</button>
                        }
                    </div>
                </div>
                break;
        }

        <div class="a-row" style="gap:var(--space-2)">
            <button type="button" class="a-btn a-btn--primary" @onclick="Add" data-testid="field-save">
                @(IsEditing ? "Save to the working copy" : "Add to the working copy")
            </button>
            @if (IsEditing)
            {
                <button type="button" class="a-btn" @onclick="Cancel">Cancel</button>
            }
        </div>
    </div>

    @* The facets the frozen schema declares and this build refuses. Without this the editor's
       silence about `default` and `validation` is indistinguishable from an oversight — the
       question every reader of this panel asks is "where is the default value", and the answer
       exists, in the framework's own words. Served verbatim (§2.3): a second wording of a refusal
       is a third spelling of one truth. *@
    @if (Refused.Count > 0)
    {
        <div class="a-section">
            <span class="a-section-title">Facets this build refuses</span>
            <span class="a-section-sub">
                Declared by the schema, refused at apply — so there is no control for them here.
            </span>
        </div>

        @foreach (var refusal in Refused)
        {
            <div class="a-listrow" data-testid="@($"refused-{refusal.Slot}")">
                <code class="a-mono a-listrow__key">@refusal.Slot</code>
                <span class="a-listrow__rest" style="flex-direction:column;align-items:flex-start;gap:var(--space-1)">
                    <span class="a-section-sub">@refusal.Consequence</span>
                    <span class="a-section-sub">@refusal.Fix</span>
                </span>
            </div>
        }
    }
</div>

@code {
    private string _name = string.Empty;
    private string _values = string.Empty;
    private string _target = string.Empty;
    private string? _refusal;
    private FieldType _type = FieldType.String;
    private bool _required;
    private bool _unique;
    private int _maxLength = 120;
    private int _precision = 10;
    private int _scale = 2;

    /// <summary>The entity the field is added to.</summary>
    [Parameter, EditorRequired]
    public string Entity { get; set; } = string.Empty;

    /// <summary>The entities a ref may point at.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Targets { get; set; } = [];

    /// <summary>Raised with the field to add, once it is one the schema can carry.</summary>
    [Parameter]
    public EventCallback<NewField> OnAdded { get; set; }

    /// <summary>
    /// The declared field being edited, or <see langword="null"/> when the panel adds a new one.
    /// </summary>
    /// <remarks>
    /// One control for both, because an edit is the same document change as an addition: the facets
    /// are written under the field's own key, and a key that already exists is replaced. A second
    /// component would be a second set of refusals to keep in step with the frozen schema.
    /// </remarks>
    [Parameter]
    public string? Editing { get; set; }

    /// <summary>The edited field's current facets, as they stand in the working copy.</summary>
    [Parameter]
    public string? EditingJson { get; set; }

    /// <summary>Raised when an edit is abandoned.</summary>
    [Parameter]
    public EventCallback OnCancelled { get; set; }

    /// <summary>What this build refuses, as <c>capabilities</c> reports it.</summary>
    [Parameter]
    public IReadOnlyList<ManagementRefusedFeature> Capabilities { get; set; } = [];

    /// <summary>
    /// The refusals that belong to a field, which are the ones a reader of this panel is missing a
    /// control for.
    /// </summary>
    private IReadOnlyList<ManagementRefusedFeature> Refused =>
        [.. Capabilities.Where(refusal => refusal.Slot.StartsWith("field.", StringComparison.Ordinal))];

    private bool IsEditing => Editing is { Length: > 0 };

    private string? _prefilled;

    protected override void OnParametersSet()
    {
        if (!IsEditing)
        {
            _prefilled = null;
            return;
        }

        /* Only when the target changes: re-reading the parameters on every render would overwrite
           what the operator is in the middle of typing with what the document still says. */
        if (_prefilled == Editing)
        {
            return;
        }

        _prefilled = Editing;
        Prefill(EditingJson);
    }

    private void Prefill(string? json)
    {
        _refusal = null;
        _name = Editing ?? string.Empty;
        var facets = Parse(json);

        _type = Enum.TryParse<FieldType>(facets["type"]?.GetValue<string>(), ignoreCase: true, out var type)
            ? type : FieldType.String;
        _required = facets["required"]?.GetValue<bool>() ?? false;
        _unique = facets["unique"]?.GetValue<bool>() ?? false;
        _maxLength = facets["maxLength"]?.GetValue<int>() ?? 120;
        _precision = facets["precision"]?.GetValue<int>() ?? 10;
        _scale = facets["scale"]?.GetValue<int>() ?? 2;
        _target = facets["entity"]?.GetValue<string>() ?? string.Empty;
        _values = facets["values"] is System.Text.Json.Nodes.JsonArray values
            ? string.Join(", ", values.Select(value => value?.GetValue<string>()))
            : string.Empty;
    }

    /// <summary>
    /// The facets as an object, or an empty one — a field whose declaration this component cannot
    /// read is one it must not silently rewrite, so the refusal surfaces when Save builds it.
    /// </summary>
    private static System.Text.Json.Nodes.JsonObject Parse(string? json)
    {
        try
        {
            return json is { Length: > 0 }
                ? System.Text.Json.Nodes.JsonNode.Parse(json) as System.Text.Json.Nodes.JsonObject ?? []
                : [];
        }
        catch (System.Text.Json.JsonException)
        {
            return [];
        }
    }

    private Task Cancel() => OnCancelled.InvokeAsync();

    private static void Toggle(System.Text.Json.Nodes.JsonObject facets, string facet, bool on)
    {
        if (on)
        {
            facets[facet] = true;
            return;
        }

        facets.Remove(facet);
    }

    /// <summary>
    /// Drops the facets that belong to a type this field no longer has.
    /// </summary>
    /// <remarks>
    /// A <c>maxLength</c> left behind on a field retyped to <c>integer</c>, or a <c>format</c> on
    /// one retyped away from <c>string</c>, is a descriptor the apply refuses — and it would be
    /// refused for a facet nobody typed, which is the worst kind of refusal to read. The facets the
    /// current type needs are written back immediately after.
    /// </remarks>
    private void ClearFacetsOfOtherTypes(System.Text.Json.Nodes.JsonObject facets)
    {
        foreach (var facet in new[] { "maxLength", "precision", "scale", "values", "entity" })
        {
            facets.Remove(facet);
        }

        if (_type is not FieldType.Ref)
        {
            facets.Remove("onDelete");
        }

        if (_type is not FieldType.String)
        {
            facets.Remove("format");
        }
    }

    /// <summary>A field the editor built, in the schema's own shape.</summary>
    /// <param name="Name">The field's name.</param>
    /// <param name="Facets">Its type and facets.</param>
    public sealed record NewField(string Name, System.Text.Json.Nodes.JsonObject Facets);

    private static int Number(object? value, int fallback)
        => int.TryParse(value?.ToString(), CultureInfo.InvariantCulture, out var parsed) ? parsed : fallback;

    /// <summary>
    /// Builds the field in the schema's own shape, or says why it cannot.
    /// </summary>
    /// <remarks>
    /// The refusals here are the frozen schema's own required facets — a <c>decimal</c> with no
    /// precision, an <c>enum</c> with no values, a <c>ref</c> with no entity. Each is a descriptor
    /// the apply rejects, so the control refuses it rather than producing one.
    /// </remarks>
    private async Task Add()
    {
        _refusal = null;

        if (!DescriptorNames.IsMember(_name))
        {
            _refusal = $"A field name must match {DescriptorNames.Member}.";
            return;
        }

        /* An edit starts from the declaration that is there, not from an empty object. The controls
           here cover the facets they can draw; a field may also carry `description`, `format`,
           `default`, `nullable`, `index`, `renamedFrom` or an `x-` extension, and rebuilding from
           scratch would drop every one of them — the same silent narrowing design §4.6 forbids of
           the export, arriving through the editor instead. */
        var facets = IsEditing ? Parse(EditingJson) : [];
        facets["type"] = _type.ToString().ToLowerInvariant();

        Toggle(facets, "required", _required);
        Toggle(facets, "unique", _unique);
        ClearFacetsOfOtherTypes(facets);

        switch (_type)
        {
            case FieldType.String:
                facets["maxLength"] = _maxLength;
                break;
            case FieldType.Decimal:
                facets["precision"] = _precision;
                facets["scale"] = _scale;
                break;
            case FieldType.Enum:
                var values = _values.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (values.Length == 0)
                {
                    _refusal = "An enum needs at least one value — the schema requires it.";
                    return;
                }

                facets["values"] = new System.Text.Json.Nodes.JsonArray(
                    [.. values.Select(value => System.Text.Json.Nodes.JsonValue.Create(value))]);
                break;
            case FieldType.Ref:
                if (_target.Length == 0)
                {
                    _refusal = "A ref needs the entity it points at — the schema requires it.";
                    return;
                }

                facets["entity"] = _target;
                facets["onDelete"] ??= "restrict";
                break;
        }

        await OnAdded.InvokeAsync(new NewField(_name, facets));

        if (!IsEditing)
        {
            _name = string.Empty;
            _values = string.Empty;
        }
    }
}
