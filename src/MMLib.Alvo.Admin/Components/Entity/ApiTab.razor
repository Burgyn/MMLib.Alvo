@*
    The routes this entity already publishes.

    A rendering of what the Data API serves, not a second document (§4.2). The shapes come from the
    entity itself, so an entity with no rule for an operation still shows the route — and says that
    the route answers 403 for everyone, which is the fact an operator is actually looking for.
*@
@inject Microsoft.Extensions.Options.IOptions<AlvoAdminOptions> Options

<div class="a-section">
    <span class="a-section-title">Generated API</span>
    <span class="a-section-sub">
        Alvo generates exactly these five from the entity. The OpenAPI document this host serves is the
        same thing, formally.
    </span>
</div>

@*
    The contract, one click from the schema that changed it — and only where it exists. The route comes
    from the host through AlvoAdminOptions, because serving a document is a hosting decision and this
    package cannot see the host's constants. Before this the sentence above named `/openapi/v1.json` in
    prose on every deployment, including those that serve nothing there.
*@
@if (Docs is { Length: > 0 } || Document is { Length: > 0 })
{
    <div class="a-row" style="padding:var(--space-3) var(--space-5);gap:var(--space-3)">
        @if (Docs is { Length: > 0 } docs)
        {
            <a class="a-btn a-btn--sm" href="@docs" target="_blank" rel="noopener"
               data-testid="api-docs">Open the API documentation</a>
        }
        @if (Document is { Length: > 0 } document)
        {
            <a class="a-btn a-btn--sm a-btn--ghost" href="@document" target="_blank" rel="noopener"
               data-testid="api-document">
                <code class="a-mono">@document</code>
            </a>
        }
    </div>
}

@foreach (var route in Routes)
{
    <div class="a-row" style="padding:var(--space-3) var(--space-5);border-bottom:1px solid var(--border);gap:var(--space-4)">
        <span class="a-badge" style="flex:none;min-width:64px">@route.Method</span>
        <code class="a-mono" style="flex:1;font-size:var(--text-xs)">@route.Path</code>
        <span class="a-section-sub" style="flex:none">@route.Note</span>
    </div>
}

<div class="a-notyet-panel" style="margin:var(--space-4)">
    <div class="a-section">
        <span class="a-section-title">An entity added at runtime is served after a restart</span>
        <span class="a-section-sub">
            The Data API's route literals are the entity names, and the endpoint table materialises
            on the first request a host serves. An apply takes effect immediately for policy and
            validation — and for this dashboard, which reaches rows through the data port — but it
            cannot add a route to a table that has already materialised (#103). So an entity created
            here answers <code class="a-mono">404</code> on <code class="a-mono">/api</code> until
            the host restarts, and the Data screen keeps working in the meantime.
        </span>
    </div>
</div>

<div class="p-note" style="padding:var(--space-4);color:var(--dim);font-size:var(--text-xs)">
    @(Entity.Tenancy == TenancyMode.Scoped
        ? "This entity is tenancy: scoped, so a caller with no tenant is refused with 403 before any rule is consulted."
        : "This entity is global, so no tenant is required to reach it.")
</div>

@code {
    /// <summary>The entity whose routes these are.</summary>
    [Parameter, EditorRequired]
    public EntitySchema Entity { get; set; } = default!;

    /// <summary>Where this host's documentation UI is, when it maps one.</summary>
    private string? Docs => Options.Value.DocsPath;

    /// <summary>Where this host's OpenAPI document is, when it serves one.</summary>
    private string? Document => Options.Value.OpenApiPath;

    private IEnumerable<(string Method, string Path, string Note)> Routes
    {
        get
        {
            yield return ("GET", $"/api/{Entity.Name}", "keyset paged");
            yield return ("GET", $"/api/{Entity.Name}/{{id}}", "one record");
            yield return ("POST", $"/api/{Entity.Name}", "create");
            yield return ("PATCH", $"/api/{Entity.Name}/{{id}}", Entity.Audit ? "If-Match honoured" : "partial update");
            yield return ("DELETE", $"/api/{Entity.Name}/{{id}}", Entity.SoftDelete ? "soft delete" : "removes the row");
        }
    }
}
