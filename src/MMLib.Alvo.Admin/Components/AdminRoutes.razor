@*
    The router.

    `AdminLayout` is the default layout for every routable component in this assembly, and
    `AppAssembly` is this assembly rather than the host's: the dashboard's routes are its own, and
    a host that also serves Razor pages of its own does not want them merged into this router's
    table.

    `AuthorizeRouteView`, not `RouteView`, and it is a security property rather than a nicety.
    `[Authorize]` on a page becomes endpoint metadata, which closes the door on the HTTP request
    that first renders it — but navigation inside a live circuit never touches an endpoint, so a
    plain `RouteView` would render every later screen with no authorization check at all. An
    operator disabled or stripped of their roles mid-session would keep navigating. This re-asks on
    every navigation, off the cascaded authentication state.
*@
<Router AppAssembly="@typeof(AdminRoutes).Assembly">
    <Found Context="route">
        <AuthorizeRouteView RouteData="@route" DefaultLayout="@typeof(AdminLayout)">
            <NotAuthorized>
                <RedirectToSignIn />
            </NotAuthorized>
            <Authorizing>
                <div class="a-content"><div class="a-empty"><div class="a-empty__title">Checking…</div></div></div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@route" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(AdminLayout)">
            <div class="a-content">
                <div class="a-empty">
                    <div class="a-empty__title">There is no screen at this address</div>
                    <div class="a-empty__body">
                        The dashboard is served under <code class="a-mono">@AlvoAdmin.BasePath</code>.
                        <a class="a-btn a-btn--sm" href="@AdminPaths.Overview">Go to Overview</a>
                    </div>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
