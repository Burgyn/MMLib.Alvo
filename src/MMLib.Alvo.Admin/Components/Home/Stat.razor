@*
    One number, with what it counts and what that means.

    The note is not decoration: "3" on a card labelled Entities is ambiguous between the descriptor
    and the database, and the whole dashboard exists to keep that distinction visible.
*@
<div class="a-card">
    <span class="a-label">@Label</span>
    <span class="a-stat">@Value</span>
    <span class="a-section-sub">@Note</span>
</div>

@code {
    /// <summary>What is being counted.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>The number, already formatted.</summary>
    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    /// <summary>What the number means.</summary>
    [Parameter, EditorRequired]
    public string Note { get; set; } = string.Empty;
}
