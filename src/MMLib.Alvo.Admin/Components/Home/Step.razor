@*
    One step of the first run, reporting its own state.
*@
<Panel Padded="true">
    <div class="a-step">
        <span class="@($"a-badge a-step__state {(Done ? "a-badge--ok" : "a-badge--warn")}")">
            @(Done ? "done" : "to do")
        </span>
        <span class="a-grow">
            <span class="a-section__title">@Title</span>
            <p class="a-section__sub a-then">@ChildContent</p>
        </span>
    </div>
</Panel>

@code {
    /// <summary>Whether the project is already in this state.</summary>
    [Parameter]
    public bool Done { get; set; }

    /// <summary>What the step is.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Why it matters, and what to do about it.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
