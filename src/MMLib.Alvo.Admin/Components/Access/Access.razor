@page "/admin/access"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject ILogger<Access> Logger
@inject ISnackbar Snackbar
@inject AdminInterop Interop

<PageTitle>Access · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="Access"
                Subtitle="Two different things live here and they take effect at different times. Membership — who exists, what roles they have, which tenant they act in — is the identity store, and a change applies at once. The role catalogue and the three management levels are the descriptor, and a change to either waits for an apply." />

    @* A refusal while an editor is open is drawn inside it (EditorProblem); only the others land here. *@
    @if (_problem is not null && !EditorOpen)
    {
        @ProblemPanel(_problemFromWrite)
    }

    <Panel Title="People">
        <Subtitle>
            @(Gateway.CanAdministerPeople
                ? "From the identity store. Changes here take effect on the next request."
                : "This deployment registered no membership store.")
        </Subtitle>
        <ChildContent>
            @if (!Gateway.CanAdministerPeople)
            {
                <Refusal>
                    This deployment has no membership store, so there is nobody to administer here. An
                    embedded host provides one over its own directory; the standalone image ships with one.
                </Refusal>
            }
            else if (_people is null)
            {
                <Skeleton />
            }
            else
            {
                @foreach (var person in _people.Users)
                {
                    @* The wrapper carries the new-item wash, so the row's own contract stays who it is and Change. *@
                    <div @key="person.Id" data-alvo-new="@(person.Id == _arrived ? "true" : null)">
                        <PersonRow Person="person" OnOpen="() => Open(person)" />
                    </div>
                }

                @if (_arrived is { } arrived)
                {
                    @RevealOnRender.On($"#person-{arrived.Value}", _reveals)
                }

                @* Under the list, where a new person appears: the editor hands focus back here on close. *@
                <div class="a-row a-row--inset">
                    <AlvoButton Small="true" data-testid="person-new" OnClick="_ => OpenCreate()">Add a person</AlvoButton>
                </div>
            }
        </ChildContent>
    </Panel>

    <Panel Title="Management levels">
        <Subtitle>
            From the descriptor's <code class="a-mono">access</code> block. Three independent
            predicates, not a hierarchy: all three are evaluated and the highest match wins.
            Changing one is an apply, and an apply that touches this block re-qualifies to admin.
        </Subtitle>
        <ChildContent>
            @if (_levels.Count == 0)
            {
                <EmptyState Title="This descriptor declares no access block"
                            Body="Only the bootstrap administrator can manage the project — which is default-deny working, and is usable: the first-run flow needs nobody else." />
            }
            else
            {
                @foreach (var level in _levels)
                {
                    <ListRow class="a-listrow--roomy a-listrow--stacked">
                        <span class="a-badge a-badge--accent">@level.Key</span>
                        <pre class="a-code a-then"><code>@level.Value</code></pre>
                    </ListRow>
                }
            }
        </ChildContent>
    </Panel>

    <Panel Title="Role catalogue">
        <Subtitle>
            <code class="a-mono">auth.roles</code> — the names a rule may name. A membership row
            naming a role this list does not declare is never minted into a caller's context.
        </Subtitle>
        <ChildContent>
            <div class="a-row a-row--gap-2 a-row--wrap a-row--inset">
                @foreach (var role in _roles)
                {
                    <span class="a-badge a-mono">@role</span>
                }
                <span class="a-badge">anon</span>
                <span class="a-badge">authenticated</span>
                <span class="a-badge">admin</span>
            </div>
            <span class="a-hint a-hint--inset">
                The last three are built in and never declared.
            </span>
        </ChildContent>
    </Panel>
</div>

@if (_creating)
{
    <AlvoEditor TestId="person-create" Title="New person" SubmitText="Create person" SubmitTestId="person-create-run"
                Subtitle="No password field, deliberately: a credential that travels as a value is readable by whoever handles it. The account is created without one and you hand over a single-use token."
                Dirty="@(_newEmail.Trim().Length > 0)"
                OnSubmit="CreateAsync" OnClose="CloseCreate">
        @EditorProblem
        <Field Label="Email" For="@EmailField">
            <MudTextField @ref="_emailField" T="string" Value="_newEmail" ValueChanged="TypeEmail"
                          Immediate="true" Variant="Variant.Outlined" InputType="InputType.Email"
                          id="@EmailField" Placeholder="dispatcher@example.com"
                          Error="@_fields.Has(EmailField)" aria-describedby="@_fields.DescribedBy(EmailField)" />
            @_fields.Under(EmailField, () => _emailField!.FocusAsync())
        </Field>
    </AlvoEditor>
}

@if (_editing is { } editing)
{
    <PersonEditor Person="editing" Roles="_roles" IsSelf="editing.Id == _self"
                  Token="@(_tokenFor == editing.Id ? _token : null)" Busy="_busy" Problem="EditorProblem"
                  OnSave="change => SaveAsync(editing, change)" OnIssueToken="() => IssueTokenAsync(editing)"
                  OnRequestDisable="() => AskToDisable(editing)" OnLetBackIn="() => LetBackInAsync(editing)"
                  OnCopyToken="CopyTokenAsync" OnClose="CloseEditor" />
}

<AlvoConfirm Open="_disabling is not null" TestId="disable-person" ConfirmTestId="disable-person-run"
             CancelTestId="disable-person-cancel" Title="@($"Disable {_disabling?.Email}?")"
             Consequence="They can no longer sign in, and every session they hold stops at its next request. You can let them back in later."
             Verb="Disable person" OnConfirm="DisableConfirmedAsync" OnCancel="() => _disabling = null" />

@code {
    private AlvoUserPage? _people;
    private IReadOnlyList<string> _roles = [];
    private IReadOnlyList<KeyValuePair<string, string>> _levels = [];
    private AlvoCredentialToken? _token;
    private UserId? _tokenFor;
    private AdminProblem? _problem;
    private bool _problemFromWrite;
    private int _problemsDrawn;
    private string _newEmail = string.Empty;
    private bool _creating;
    private bool _busy;
    private AlvoUser? _editing;
    private AlvoUser? _disabling;
    private UserId? _self;
    private UserId? _arrived;
    private int _reveals;
    private readonly FieldRefusals _fields = new();
    private MudTextField<string>? _emailField;

    private const string EmailField = "new-person-email";

    /// <summary>Whether an editor is on screen, which is then where a refusal is drawn.</summary>
    private bool EditorOpen => _creating || _editing is not null;

    /// <summary>The refusal, drawn inside whichever editor is open, where the operator is looking.</summary>
    private RenderFragment? EditorProblem => _problem is null ? null : ProblemPanel(true);

    /// <summary>
    /// The page's one refusal panel. Keyed by the attempt, so every refusal draws a new panel that takes focus again
    /// (spec §3.3); a lost race also offers Reload, the one way to see the person as they now are.
    /// </summary>
    private RenderFragment ProblemPanel(bool takeFocus) => @<CascadingValue Value="_problem">
        @if (_problem?.Exception is AlvoPreconditionFailedException)
        {
            <ErrorPanel @key="_problemsDrawn" TakeFocus="takeFocus" Title="This person changed while the screen was open">
                <Actions>
                    <AlvoButton Small="true" data-testid="person-reload" OnClick="_ => ReloadAsync()">Reload</AlvoButton>
                </Actions>
            </ErrorPanel>
        }
        else
        {
            <ErrorPanel @key="_problemsDrawn" TakeFocus="takeFocus" />
        }
    </CascadingValue>;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Reads the descriptor's roles and levels, the operator's own id, and the people.</summary>
    private async Task LoadAsync()
    {
        try
        {
            var descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _roles = DescriptorLens.DeclaredRoles(descriptor.DescriptorJson);
            _levels = DescriptorLens.AccessLevels(descriptor.DescriptorJson);
            _self ??= await Gateway.SelfAsync(CancellationToken.None);

            if (Gateway.CanAdministerPeople)
            {
                _people = await Gateway.PeopleAsync(new AlvoUserQuery(), CancellationToken.None);
            }
        }
        catch (Exception exception)
        {
            Refused(exception);
        }
    }

    /// <summary>After a lost race: closes the editor and reads the list again, so the next change starts from it.</summary>
    private async Task ReloadAsync()
    {
        CloseEditor();
        await LoadAsync();
    }

    /// <summary>Opens a person's editor, from their row's Change.</summary>
    private void Open(AlvoUser person)
    {
        _problem = null;
        _editing = person;
    }

    /// <summary>Opens the Add a person editor.</summary>
    private void OpenCreate()
    {
        _problem = null;
        _creating = true;
    }

    /// <summary>Closes the person's editor, and with it the token it was showing: a token is shown once.</summary>
    private void CloseEditor()
    {
        _editing = null;
        _token = null;
        _tokenFor = null;
        _problem = null;
    }

    /// <summary>Closes the Add a person editor and forgets what was typed, so the next one starts empty.</summary>
    private void CloseCreate()
    {
        _creating = false;
        _newEmail = string.Empty;
        _problem = null;
        _fields.ClearAll();
    }

    /// <summary>Takes the address as typed, which answers any refusal it had.</summary>
    private void TypeEmail(string? email)
    {
        _newEmail = email ?? string.Empty;
        _fields.Clear(EmailField);
    }

    /// <summary>Writes the parts of the draft that changed, says so, and closes the editor.</summary>
    /// <remarks>
    /// The tenant is parsed before anything is written, so a mistyped one refuses the whole save rather than half
    /// of it. The roles go as a grant and a revoke against the roles this editor was opened on, which the gateway
    /// applies to the person as stored now: a whole set written back from a stale screen would restore a role
    /// somebody else revoked (ManagementGateway.ChangeRolesAsync).
    /// </remarks>
    private async Task SaveAsync(AlvoUser person, (IReadOnlyList<string>? Roles, string? Tenant, bool ClearTenant) change)
    {
        TenantId? tenant = null;
        if (change.Tenant is { } typed && !TryTenant(typed, out tenant))
        {
            return;
        }

        await BusyAsync(async () =>
        {
            if (change.Roles is { } roles)
            {
                var (grant, revoke) = ManagementGateway.RoleChange(person.RoleNames, roles);
                await Gateway.ChangeRolesAsync(person, grant, revoke, CancellationToken.None);
            }

            if (tenant is not null || change.ClearTenant)
            {
                await Gateway.SetTenantAsync(person.Id, tenant, CancellationToken.None);
            }

            CloseEditor();
            await LoadAsync();
            Snackbar.Confirm($"Saved {person.Email}");
        });
    }

    /// <summary>Parses a typed tenant, or says in the editor why it is not one.</summary>
    /// <remarks>
    /// The editor already refuses a mistyped tenant under its field before raising Save; this is the page's own
    /// guard, for a caller that did not.
    /// </remarks>
    private bool TryTenant(string typed, out TenantId? tenant)
    {
        if (TenantId.TryParse(typed, null, out var parsed))
        {
            tenant = parsed;
            return true;
        }

        tenant = null;
        Show(AdminProblem.From(new ManagementRequestException("That is not a tenant id."))! with
        {
            Fix = "A tenant is a uuid. Copy it from a row's tenant_id, or from the caller you are modelling.",
        });
        return false;
    }

    /// <summary>Mints a token and keeps it in the person's editor, the one place it is shown.</summary>
    private Task IssueTokenAsync(AlvoUser person) => BusyAsync(async () =>
    {
        _token = await Gateway.IssueCredentialTokenAsync(person.Id, CancellationToken.None);
        _tokenFor = person.Id;
        _problem = null;
    });

    /// <summary>Copies the token; a clipboard the browser withholds is said in place, beside the token itself.</summary>
    private async Task CopyTokenAsync()
    {
        if (_token is not { } token)
        {
            return;
        }

        try
        {
            await Interop.CopyAsync(token.Token);
            Snackbar.Confirm("Token copied");
        }
        catch (JSException exception)
        {
            Show(new AdminProblem("The token could not be copied", "The browser did not let this page use the clipboard.",
                "Select the token above and copy it by hand.", exception, IsFault: false));
        }
    }

    /// <summary>Closes the editor, then asks: a confirm never opens over a dialog (spec §3.1).</summary>
    private void AskToDisable(AlvoUser person)
    {
        CloseEditor();
        _disabling = person;
    }

    /// <summary>Disables the person the confirm names; the confirm stays busy until the write returns.</summary>
    private async Task DisableConfirmedAsync()
    {
        if (_disabling is not { } person)
        {
            return;
        }

        await WriteAsync(() => Gateway.SetDisabledAsync(person.Id, true, CancellationToken.None), $"Disabled {person.Email}");
        _disabling = null;
    }

    /// <summary>Lets a disabled person sign in again: not destructive, so it asks nothing.</summary>
    private Task LetBackInAsync(AlvoUser person)
    {
        CloseEditor();
        return WriteAsync(() => Gateway.SetDisabledAsync(person.Id, false, CancellationToken.None),
            $"{person.Email} can sign in again");
    }

    /// <summary>Creates the person, closes the editor, and brings their new row into view, lit.</summary>
    /// <remarks>
    /// Create is never disabled for an empty box: Enter pressed straight after typing reaches the browser before the
    /// render that would have enabled the button, and implicit submission does nothing on a disabled default button.
    /// An empty address is refused here instead, under the field, which takes focus (spec §3.3).
    /// </remarks>
    private async Task CreateAsync()
    {
        var email = _newEmail.Trim();
        if (email.Length == 0)
        {
            _fields.Refuse(EmailField, "Type the address they will sign in with, such as dispatcher@example.com.");
            return;
        }

        try
        {
            var created = await Gateway.CreatePersonAsync(new AlvoUserCreation(email, []), CancellationToken.None);
            CloseCreate();
            await LoadAsync();
            _arrived = created.Id;
            _reveals++;
            Snackbar.Confirm($"Created {email}");
        }
        catch (Exception exception)
        {
            RefusedWrite(exception);
        }
    }

    /// <summary>Runs one write from the page, says it worked, and reads the list again.</summary>
    private async Task WriteAsync(Func<Task<AlvoUser>> write, string done)
    {
        try
        {
            await write();
            _problem = null;
            await LoadAsync();
            Snackbar.Confirm(done);
        }
        catch (Exception exception)
        {
            RefusedWrite(exception);
        }
    }

    /// <summary>Runs <paramref name="work"/> with the editor busy, and draws a refusal from it in place.</summary>
    private async Task BusyAsync(Func<Task> work)
    {
        _busy = true;
        try
        {
            await work();
        }
        catch (Exception exception)
        {
            RefusedWrite(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A refusal from something the operator did: a new panel, which takes focus.</summary>
    private void RefusedWrite(Exception exception)
        => Show(AdminProblem.From(exception, Logger, ProblemSite.People));

    /// <summary>Draws <paramref name="problem"/> as a new panel that takes focus.</summary>
    private void Show(AdminProblem? problem)
    {
        _problem = problem;
        _problemFromWrite = true;
        _problemsDrawn++;
    }

    /// <summary>A refusal while reading: drawn, but not handed focus, which the router gave the heading.</summary>
    private void Refused(Exception exception)
    {
        _problem = AdminProblem.From(exception, Logger, ProblemSite.People);
        _problemFromWrite = false;
    }
}
