@page "/admin/access"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject ILogger<Access> Logger
@inject ISnackbar Snackbar
@inject AdminInterop Interop
@inject NavigationManager Navigation

<PageTitle>Access · Alvo</PageTitle>

@* Learns the operator's offset from UTC once, so a lockout's end reads in their own time (LockoutWords). *@
@OperatorClock.On(StateHasChanged)

<div class="a-stack">
    @* The screen's create action is its header's primary one (spec §3.7). *@
    <PageHeader Title="Access"
                Subtitle="Two different things live here and they take effect at different times. Membership — who exists, what roles they have, which tenant they act in — is the identity store, and a change applies at once. The role catalogue and the three management levels are the descriptor, and a change to either waits for an apply.">
        <Primary>
            @if (Gateway.CanAdministerPeople && _people is not null)
            {
                <AlvoButton Tone="AlvoButton.ButtonTone.Primary" Small="true" data-testid="person-new"
                            OnClick="_ => OpenCreate()">New person</AlvoButton>
            }
        </Primary>
    </PageHeader>

    @* A refusal while an editor is open is drawn inside it (EditorProblem); only the others land here. *@
    @if (!EditorOpen)
    {
        @ProblemPanel
    }

    <Panel Title="People">
        <Subtitle>
            @(Gateway.CanAdministerPeople
                ? "From the identity store. Changes here take effect on the next request."
                : "This deployment registered no membership store.")
        </Subtitle>
        <ChildContent>
            @if (!Gateway.CanAdministerPeople)
            {
                <Refusal>
                    This deployment has no membership store, so there is nobody to administer here. An
                    embedded host provides one over its own directory; the standalone image ships with one.
                </Refusal>
            }
            else if (_people is null)
            {
                <Skeleton />
            }
            else
            {
                @RefreshBar.While(_refreshing)
                @* A search over the list, so it is named by its placeholder and aria-label, not a label above it
                   (spec §3.8). Outside every branch below, so a search that finds nobody, or everybody again, never
                   unmounts the box being typed into. 254 is the longest address a mailbox can have (RFC 5321). *@
                <div class="a-row a-row--inset">
                    <MudTextField T="string" Value="_searchText" ValueChanged="SearchTyped" Immediate="true"
                                  Variant="Variant.Outlined" InputType="InputType.Search" MaxLength="254"
                                  Placeholder="Find by address" aria-label="Find a person by address"
                                  data-testid="people-search" autocomplete="off" Class="a-filter" />
                </div>

                @if (_paging.Revealing)
                {
                    @* The reveal replaced whatever the operator had searched for, so it says so, with the way back. *@
                    <div class="a-row a-row--gap-2 a-row--inset" data-testid="people-revealing">
                        <span class="a-note">Showing the person you created.</span>
                        <AlvoButton Tone="AlvoButton.ButtonTone.Ghost" Small="true" OnClick="_ => ClearSearchAsync()">Clear the search</AlvoButton>
                    </div>
                }

                @if (_people.Users.Count == 0 && _paging.Search.Length > 0)
                {
                    <EmptyState Title="@($"Nobody’s address contains “{_paging.Search}”")"
                                Body="The search looks in the address each person signs in with.">
                        <AlvoButton Tone="AlvoButton.ButtonTone.Primary" Small="true" data-testid="people-search-clear"
                                    OnClick="_ => ClearSearchAsync()">Clear the search</AlvoButton>
                    </EmptyState>
                }

                @foreach (var person in _people.Users)
                {
                    @* The wrapper carries the new-item wash, so the row's own contract stays who it is and Change. *@
                    <div @key="person.Id" data-alvo-new="@(person.Id == _arrived ? "true" : null)">
                        <PersonRow Person="person" OnOpen="() => Open(person)" />
                    </div>
                }

                @if (_paging.HasEarlier || _people.NextCursor is not null)
                {
                    <div class="a-row a-row--gap-2 a-row--inset">
                        <span class="a-spacer"></span>
                        @if (_paging.HasEarlier)
                        {
                            <AlvoButton Small="true" data-testid="people-previous" OnClick="_ => PreviousAsync()">Previous</AlvoButton>
                        }
                        @if (_people.NextCursor is { } next)
                        {
                            <AlvoButton Small="true" data-testid="people-next" OnClick="_ => NextAsync(next)">Next</AlvoButton>
                        }
                    </div>
                }

                @if (_arrived is { } arrived)
                {
                    @RevealOnRender.On($"#person-{arrived.Value}", _reveals)
                }

                @if (_focusAfterRender is { } focus)
                {
                    @FocusFirstOnRender.On(focus, _focusMoves, () => _focusAfterRender = null)
                }
            }
        </ChildContent>
    </Panel>

    <Panel Title="Management levels">
        <Subtitle>
            From the descriptor's <code class="a-mono">access</code> block. Three independent
            predicates, not a hierarchy: all three are evaluated and the highest match wins.
            Changing one is an apply, and an apply that touches this block re-qualifies to admin.
        </Subtitle>
        <ChildContent>
            @if (_levels.Count == 0)
            {
                <EmptyState Title="This descriptor declares no access block"
                            Body="Only the bootstrap administrator can manage the project — which is default-deny working, and is usable: the first-run flow needs nobody else." />
            }
            else
            {
                @foreach (var level in _levels)
                {
                    <ListRow class="a-listrow--roomy a-listrow--stacked">
                        <span class="a-badge a-badge--accent">@level.Key</span>
                        <pre class="a-code a-then"><code>@level.Value</code></pre>
                    </ListRow>
                }
            }
        </ChildContent>
    </Panel>

    <Panel Title="Role catalogue">
        <Subtitle>
            <code class="a-mono">auth.roles</code> — the names a rule may name. A membership row
            naming a role this list does not declare is never minted into a caller's context.
        </Subtitle>
        <ChildContent>
            <div class="a-row a-row--gap-2 a-row--wrap a-row--inset">
                @foreach (var role in _roles)
                {
                    <span class="a-badge a-mono">@role</span>
                }
                <span class="a-badge">anon</span>
                <span class="a-badge">authenticated</span>
                <span class="a-badge">admin</span>
            </div>
            <span class="a-hint a-hint--inset">
                The last three are built in and never declared.
            </span>
        </ChildContent>
    </Panel>
</div>

@if (_creating)
{
    <AlvoEditor TestId="person-create" Title="New person" SubmitText="Create person" SubmitTestId="person-create-run"
                Subtitle="No password field, deliberately: a credential that travels as a value is readable by whoever handles it. The account is created without one and you hand over a single-use token."
                Dirty="@(_newEmail.Trim().Length > 0)"
                OnSubmit="CreateAsync" OnClose="CloseCreate">
        @EditorProblem
        <Field Label="Email" For="@EmailField">
            <MudTextField @ref="_emailField" T="string" Value="_newEmail" ValueChanged="TypeEmail"
                          Immediate="true" Variant="Variant.Outlined" InputType="InputType.Email"
                          id="@EmailField" Placeholder="dispatcher@example.com"
                          Error="@_fields.Has(EmailField)" aria-describedby="@_fields.DescribedBy(EmailField)" />
            @_fields.Under(EmailField, () => _emailField!.FocusAsync())
        </Field>
    </AlvoEditor>
}

@if (_editing is { } editing)
{
    @* A token shown once and not yet copied is what every way out of the editor would lose, so it asks (M14). *@
    <CascadingValue Value="@(_token is not null && !_tokenCopied ? EditorLeaveQuestion.UncopiedToken : null)">
        <PersonEditor Person="editing" Roles="_roles" IsSelf="editing.Id == _self"
                      Token="@(_tokenFor == editing.Id ? _token : null)" Busy="_busy" Problem="EditorProblem"
                      OnSave="change => SaveAsync(editing, change)" OnIssueToken="() => IssueTokenAsync(editing)"
                      OnRequestDisable="() => AskToDisable(editing)" OnLetBackIn="() => LetBackInAsync(editing)"
                      OnRequestUnlock="() => AskToUnlock(editing)"
                      OnCopyToken="CopyTokenAsync" OnClose="CloseEditor" />
    </CascadingValue>
}

<AlvoConfirm Open="_disabling is not null" TestId="disable-person" ConfirmTestId="disable-person-run"
             CancelTestId="disable-person-cancel" Title="@($"Disable {_disabling?.Email}?")"
             Consequence="They can no longer sign in, every session they hold stops at its next request, and a credential token already issued to them stops working. You can let them back in later; they then sign in again."
             Verb="Disable person" OnConfirm="DisableConfirmedAsync" OnCancel="CancelDisable" />

@* Not destructive, and still asked (spec §3.2's shape, deliberately): the lockout is the account's guard against
   somebody guessing its password, so ending it early is a decision, and the body says what it does and does not. *@
<AlvoConfirm Open="_unlocking is not null" TestId="unlock-person" ConfirmTestId="unlock-person-run"
             CancelTestId="unlock-person-cancel" Title="@($"Unlock {_unlocking?.Email}?")"
             Consequence="@LockoutWords.Consequence" Verb="Unlock" OnConfirm="UnlockConfirmedAsync"
             OnCancel="CancelUnlock" />


@code {
    private AlvoUserPage? _people;
    private IReadOnlyList<string> _roles = [];
    private IReadOnlyList<KeyValuePair<string, string>> _levels = [];
    private AlvoCredentialToken? _token;

    /// <summary>Whether the token on screen reached the clipboard, after which the editor may close without asking.</summary>
    private bool _tokenCopied;
    private UserId? _tokenFor;
    private readonly RefusalState<AdminProblem> _problem = new();
    private string _newEmail = string.Empty;
    private bool _creating;
    private bool _busy;
    private AlvoUser? _editing;
    private AlvoUser? _disabling;

    /// <summary>The person the Unlock confirm names, while it is open.</summary>
    private AlvoUser? _unlocking;
    private UserId? _self;
    private UserId? _arrived;
    private int _reveals;
    private readonly FieldRefusals _fields = new();

    /// <summary>Whether the people already on screen are being read again, after a write (spec §3.6).</summary>
    private bool _refreshing;
    private MudTextField<string>? _emailField;

    /// <summary>The search and the cursors that led to the page of people on screen.</summary>
    private readonly PeoplePaging _paging = new();

    /// <summary>What is in the search box, which becomes the search once typing pauses.</summary>
    private string _searchText = string.Empty;

    /// <summary>Numbers each keystroke's search, so only the last one reads.</summary>
    private int _searchVersion;

    /// <summary>Numbers each read of the people, so a slower earlier one never lands last.</summary>
    private int _peopleVersion;

    /// <summary>Where focus goes once the next render is on screen, the first of these that is drawn.</summary>
    private IReadOnlyList<string>? _focusAfterRender;

    /// <summary>Counts focus moves, so each one draws its own <see cref="FocusFirstOnRender"/>.</summary>
    private int _focusMoves;

    private static readonly string[] _nextThenPrevious = ["[data-testid='people-next']", "[data-testid='people-previous']"];
    private static readonly string[] _previousThenNext = ["[data-testid='people-previous']", "[data-testid='people-next']"];
    private static readonly string[] _search = ["[data-testid='people-search']"];

    /// <summary>The pause in typing after which a search runs: the Data grid's.</summary>
    private static readonly TimeSpan _searchDelay = TimeSpan.FromMilliseconds(250);

    private const string EmailField = "new-person-email";

    /// <summary>Whether an editor is on screen, which is then where a refusal is drawn.</summary>
    private bool EditorOpen => _creating || _editing is not null;

    /// <summary>The refusal, drawn inside whichever editor is open, where the operator is looking.</summary>
    private RenderFragment? EditorProblem => _problem.Shown ? ProblemPanel : null;

    /// <summary>
    /// The page's one refusal panel, a new one per refusal (spec §3.3); a lost race also offers Reload, the one way to
    /// see the person as they now are.
    /// </summary>
    private RenderFragment ProblemPanel => RefusalPanel.Of(_problem, LostRace ? ReloadAction : null);

    private bool LostRace => _problem.Current?.Exception is AlvoPreconditionFailedException;

    private RenderFragment ReloadAction => @<AlvoButton Small="true" data-testid="person-reload"
                                                       OnClick="_ => ReloadAsync()">Reload</AlvoButton>;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>Reads the descriptor's roles and levels, the operator's own id, and the people.</summary>
    private async Task LoadAsync()
    {
        try
        {
            var descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _roles = DescriptorLens.DeclaredRoles(descriptor.DescriptorJson);
            _levels = DescriptorLens.AccessLevels(descriptor.DescriptorJson);
            _self ??= await Gateway.SelfAsync(CancellationToken.None);
        }
        catch (Exception exception)
        {
            Refused(exception);
            return;
        }

        await LoadPeopleAsync();
    }

    /// <summary>Reads the page of people the search and the cursors say (<see cref="PeoplePaging"/>).</summary>
    /// <remarks>
    /// Numbered, like the Data grid's read: a search fires a read per pause in typing, and a slower earlier read must
    /// not land after a faster later one — the list would show the people for a search no longer in the box.
    /// </remarks>
    private async Task LoadPeopleAsync()
    {
        if (!Gateway.CanAdministerPeople)
        {
            return;
        }

        var version = ++_peopleVersion;
        _refreshing = _people is not null;
        try
        {
            var people = await Gateway.PeopleAsync(_paging.Query, CancellationToken.None);
            if (version == _peopleVersion)
            {
                _people = people;
            }
        }
        catch (Exception exception)
        {
            /* A later read has already superseded this one, and its answer, not this refusal, is what is drawn. */
            if (version == _peopleVersion)
            {
                Refused(exception);
            }
        }
        finally
        {
            if (version == _peopleVersion)
            {
                _refreshing = false;
            }
        }
    }

    /// <summary>Takes what was typed into the search, and runs it once typing pauses, from the first page.</summary>
    /// <remarks>
    /// Typing ends a reveal at once, not after the pause: the line saying the list shows the person just created would
    /// otherwise sit beside text it no longer describes. It also drops a focus move still waiting to be drawn.
    /// </remarks>
    private async Task SearchTyped(string? search)
    {
        _searchText = search ?? string.Empty;
        _paging.StopRevealing();
        _focusAfterRender = null;
        var version = ++_searchVersion;
        await Task.Delay(_searchDelay);
        if (version == _searchVersion)
        {
            _paging.Find(_searchText);
            await LoadPeopleAsync();
        }
    }

    /// <summary>Moves to the page after this one; focus stays on Next, or goes to Previous on the last page.</summary>
    private async Task NextAsync(string cursor)
    {
        _paging.Next(cursor);
        await LoadPeopleAsync();
        FocusAfterRender(_nextThenPrevious);
    }

    /// <summary>Moves back to the page before this one; focus stays on Previous, or goes to Next on the first page.</summary>
    private async Task PreviousAsync()
    {
        _paging.Previous();
        await LoadPeopleAsync();
        FocusAfterRender(_previousThenNext);
    }

    /// <summary>Moves focus, after the render that draws what the last action read, to the first of these drawn.</summary>
    private void FocusAfterRender(IReadOnlyList<string> selectors)
    {
        _focusAfterRender = selectors;
        _focusMoves++;
    }

    /// <summary>Empties the search, from the no-match state or the reveal line, and gives focus to the box.</summary>
    /// <remarks>Both controls that call it are gone once the list is back, so focus would otherwise fall to the page.</remarks>
    private async Task ClearSearchAsync()
    {
        _searchVersion++;
        _searchText = string.Empty;
        _paging.Find(string.Empty);
        await LoadPeopleAsync();
        FocusAfterRender(_search);
    }

    /// <summary>
    /// Reads the list once so the person just created is on it, where §3.5 reveals them: the same page when it is the
    /// whole directory, else the list narrowed to their address — on any other page they may sort elsewhere or fall
    /// outside the search, and knowing which would take a second read.
    /// </summary>
    private async Task ShowCreatedAsync(AlvoUser created)
    {
        if (_people is not null && !_paging.ShowsEverybody(_people))
        {
            _searchVersion++;
            _searchText = created.Email;
            _paging.Reveal(created.Email);
        }

        await LoadPeopleAsync();
    }

    /// <summary>After a lost race: closes the editor and reads the list again, so the next change starts from it.</summary>
    private async Task ReloadAsync()
    {
        CloseEditor();
        await LoadAsync();
    }

    /// <summary>Opens a person's editor, from their row's Edit.</summary>
    private void Open(AlvoUser person)
    {
        _problem.Clear();
        _editing = person;
    }

    /// <summary>Opens the New person editor.</summary>
    private void OpenCreate()
    {
        _problem.Clear();
        _creating = true;
    }

    /// <summary>Closes the person's editor, and with it the token it was showing: a token is shown once.</summary>
    private void CloseEditor()
    {
        _editing = null;
        _token = null;
        _tokenCopied = false;
        _tokenFor = null;
        _problem.Clear();
    }

    /// <summary>Closes the New person editor and forgets what was typed, so the next one starts empty.</summary>
    private void CloseCreate()
    {
        _creating = false;
        _newEmail = string.Empty;
        _problem.Clear();
        _fields.ClearAll();
    }

    /// <summary>Takes the address as typed, which answers any refusal it had.</summary>
    private void TypeEmail(string? email)
    {
        _newEmail = email ?? string.Empty;
        _fields.Clear(EmailField);
    }

    /// <summary>Writes the parts of the draft that changed, says so, and closes the editor.</summary>
    /// <remarks>
    /// The tenant is parsed before anything is written, so a mistyped one refuses the whole save rather than half
    /// of it. The roles go as a grant and a revoke against the roles this editor was opened on, which the gateway
    /// applies to the person as stored now: a whole set written back from a stale screen would restore a role
    /// somebody else revoked (ManagementGateway.ChangeRolesAsync).
    /// </remarks>
    private async Task SaveAsync(AlvoUser person, (IReadOnlyList<string>? Roles, string? Tenant, bool ClearTenant) change)
    {
        TenantId? tenant = null;
        if (change.Tenant is { } typed && !TryTenant(typed, out tenant))
        {
            return;
        }

        await BusyAsync(async () =>
        {
            if (change.Roles is { } roles)
            {
                var (grant, revoke) = ManagementGateway.RoleChange(person.RoleNames, roles);
                await Gateway.ChangeRolesAsync(person, grant, revoke, CancellationToken.None);
            }

            if (tenant is not null || change.ClearTenant)
            {
                await Gateway.SetTenantAsync(person.Id, tenant, CancellationToken.None);
            }

            CloseEditor();
            await LoadAsync();
            Snackbar.Confirm($"Saved {person.Email}");
        });
    }

    /// <summary>Parses a typed tenant, or says in the editor why it is not one.</summary>
    /// <remarks>
    /// The editor already refuses a mistyped tenant under its field before raising Save; this is the page's own
    /// guard, for a caller that did not.
    /// </remarks>
    private bool TryTenant(string typed, out TenantId? tenant)
    {
        if (TenantId.TryParse(typed, null, out var parsed))
        {
            tenant = parsed;
            return true;
        }

        tenant = null;
        Show(AdminProblem.From(new ManagementRequestException("That is not a tenant id."))! with
        {
            Fix = "A tenant is a uuid. Copy it from a row's tenant_id, or from the caller you are modelling.",
        });
        return false;
    }

    /// <summary>Mints a token and keeps it in the person's editor, the one place it is shown.</summary>
    private Task IssueTokenAsync(AlvoUser person) => BusyAsync(async () =>
    {
        _token = await Gateway.IssueCredentialTokenAsync(person.Id, CancellationToken.None);
        _tokenCopied = false;
        _tokenFor = person.Id;
        _problem.Clear();
    });

    /// <summary>
    /// Copies the set-password link the panel shows (CredentialHandover); a clipboard the browser withholds is said in
    /// place, beside the link itself.
    /// </summary>
    private async Task CopyTokenAsync()
    {
        if (_token is not { } token || _editing is not { } person)
        {
            return;
        }

        try
        {
            await Interop.CopyAsync(CredentialHandover.For(Navigation, person, token, Interop.UtcOffset).Clipboard);
            _tokenCopied = true;
            Snackbar.Confirm("Link copied");
        }
        catch (JSException exception)
        {
            Show(new AdminProblem("The link could not be copied", "The browser did not let this page use the clipboard.",
                "Select the link above and copy it by hand.", exception, IsFault: false));
        }
    }

    /// <summary>Closes the editor, then asks: a confirm never opens over a dialog (spec §3.1).</summary>
    private void AskToDisable(AlvoUser person)
    {
        CloseEditor();
        _disabling = person;
    }

    /// <summary>Disables the person the confirm names, and gives focus to their row.</summary>
    private async Task DisableConfirmedAsync()
    {
        if (_disabling is not { } person)
        {
            return;
        }

        /* Closed first, then written, then focused: the order every confirm follows (spec §3.2). */
        _disabling = null;
        await WriteAsync(() => Gateway.SetDisabledAsync(person.Id, true, CancellationToken.None), $"Disabled {person.Email}");
        await FocusRowOfAsync(person);
    }

    /// <summary>Cancel and Escape keep the person as they are; the Disable that asked is gone with its editor.</summary>
    private Task CancelDisable()
    {
        var person = _disabling;
        _disabling = null;
        return person is null ? Task.CompletedTask : FocusRowOfAsync(person);
    }

    /// <summary>
    /// Focus on the person's row once the editor or the confirm has closed and the list is drawn again (spec §3.2): the
    /// control that asked was inside the editor, which is gone. A refusal's panel takes focus instead, when there is one.
    /// </summary>
    private Task FocusRowOfAsync(AlvoUser person)
        => _problem.Shown
            ? Task.CompletedTask
            : Interop.FocusFirstOnceClosedAsync([$"#change-{person.Id.Value}", "[data-testid='person-new']"]);

    /// <summary>Closes the editor, then asks whether the lockout should end: never a confirm over a dialog.</summary>
    private void AskToUnlock(AlvoUser person)
    {
        CloseEditor();
        _unlocking = person;
    }

    /// <summary>Ends the lockout of the person the confirm names, says so once the list is read again, and focuses their row.</summary>
    private async Task UnlockConfirmedAsync()
    {
        if (_unlocking is not { } person)
        {
            return;
        }

        /* Closed first, then written, then focused: the order every confirm follows (spec §3.2). */
        _unlocking = null;
        await WriteAsync(() => Gateway.ClearLockoutAsync(person.Id, CancellationToken.None),
            $"{person.Email} can try to sign in again");
        await FocusRowOfAsync(person);
    }

    /// <summary>Cancel and Escape leave the lockout standing; the Unlock that asked is gone with its editor.</summary>
    private Task CancelUnlock()
    {
        var person = _unlocking;
        _unlocking = null;
        return person is null ? Task.CompletedTask : FocusRowOfAsync(person);
    }

    /// <summary>Lets a disabled person sign in again: not destructive, so it asks nothing.</summary>
    private async Task LetBackInAsync(AlvoUser person)
    {
        CloseEditor();
        await WriteAsync(() => Gateway.SetDisabledAsync(person.Id, false, CancellationToken.None),
            $"{person.Email} can sign in again");
        await FocusRowOfAsync(person);
    }

    /// <summary>Creates the person, closes the editor, and brings their new row into view, lit.</summary>
    /// <remarks>
    /// Create is never disabled for an empty box: Enter pressed straight after typing reaches the browser before the
    /// render that would have enabled the button, and implicit submission does nothing on a disabled default button.
    /// An empty address is refused here instead, under the field, which takes focus (spec §3.3).
    /// </remarks>
    private async Task CreateAsync()
    {
        var email = _newEmail.Trim();
        if (email.Length == 0)
        {
            _fields.Refuse(EmailField, "Type the address they will sign in with, such as dispatcher@example.com.");
            return;
        }

        try
        {
            var created = await Gateway.CreatePersonAsync(new AlvoUserCreation(email, []), CancellationToken.None);
            CloseCreate();
            await ShowCreatedAsync(created);
            _arrived = created.Id;
            _reveals++;
            Snackbar.Confirm($"Created {email}");
        }
        catch (Exception exception)
        {
            RefusedWrite(exception);
        }
    }

    /// <summary>Runs one write from the page, says it worked, and reads the list again.</summary>
    private async Task WriteAsync(Func<Task<AlvoUser>> write, string done)
    {
        try
        {
            await write();
            _problem.Clear();
            await LoadAsync();
            Snackbar.Confirm(done);
        }
        catch (Exception exception)
        {
            RefusedWrite(exception);
        }
    }

    /// <summary>Runs <paramref name="work"/> with the editor busy, and draws a refusal from it in place.</summary>
    private async Task BusyAsync(Func<Task> work)
    {
        _busy = true;
        try
        {
            await work();
        }
        catch (Exception exception)
        {
            RefusedWrite(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A refusal from something the operator did: a new panel, which takes focus.</summary>
    private void RefusedWrite(Exception exception)
        => Show(AdminProblem.From(exception, Logger, ProblemSite.People));

    /// <summary>Draws <paramref name="problem"/> as a new panel that takes focus.</summary>
    private void Show(AdminProblem? problem, bool fromPress = true)
        => _problem.Show(problem, fromPress, problem?.Exception is AlvoPreconditionFailedException
            ? "This person changed while the screen was open"
            : null);

    /// <summary>A refusal while reading: drawn, but not handed focus, which the router gave the heading.</summary>
    private void Refused(Exception exception)
        => Show(AdminProblem.From(exception, Logger, ProblemSite.People), fromPress: false);
}
