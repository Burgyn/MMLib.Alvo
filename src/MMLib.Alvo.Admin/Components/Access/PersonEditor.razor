@*
    One person's roles and tenant, edited in an AlvoEditor and written on Save (spec §3.1), in place of the row that
    expanded under itself (inventory §2a.2). A credential token issued from here stays here, with a Copy button,
    until the editor closes (inventory defect #10): a token is shown once, so it is never only a snackbar.

    Disable and Let them back in leave the editor first (AlvoEditor.LeaveAsync, which asks "Discard your changes?"
    when there are any): Disable is confirmed in an AlvoConfirm, and a confirm never opens over a dialog.

    The page writes everything. This holds only the draft, and says on Save which parts of it changed: the roles as
    the chips now have them, which the page turns into a grant or a revoke against the person as stored now
    (ManagementGateway.ChangeRolesAsync), never a whole set written back.
*@
<AlvoEditor @ref="_editor" TestId="person-editor" Title="@($"Edit {Person.Email}")" SubmitText="Save changes"
            SubmitTestId="person-save" Dirty="_draft.Dirty" Busy="Busy" OnSubmit="SaveAsync"
            OnClose="OnClose">
    <ExtraActions>
        <AlvoButton Small="true" data-testid="person-issue-token" Disabled="Busy"
                    OnClick="_ => OnIssueToken.InvokeAsync()">Issue a credential token</AlvoButton>
        @if (Person.IsDisabled)
        {
            <AlvoButton Small="true" data-testid="person-let-in" Disabled="Busy"
                        OnClick="_ => LeaveForAsync(OnLetBackIn)">Let them back in</AlvoButton>
        }
        else
        {
            <AlvoButton Tone="AlvoButton.ButtonTone.Danger" Small="true" data-testid="person-disable" Disabled="Busy"
                        OnClick="_ => LeaveForAsync(OnRequestDisable)">Disable</AlvoButton>
        }
    </ExtraActions>
    <ChildContent>
        @Problem

        @if (Token is { } token)
        {
            <AlvoAlert Tone="AlvoAlert.AlertTone.Info" Title="Credential token" TestId="person-token-panel">
                <ChildContent>
                    <p class="a-section__sub">
                        Hand this over out of band: this build sends no email. It works once, until
                        @token.ExpiresAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture).
                    </p>
                    <pre class="a-code" data-testid="person-token"><code>@token.Token</code></pre>
                </ChildContent>
                <Actions>
                    <AlvoButton Small="true" data-testid="person-token-copy"
                                OnClick="_ => OnCopyToken.InvokeAsync()">Copy</AlvoButton>
                </Actions>
            </AlvoAlert>
        }

        <Field Label="Roles" LabelId="@($"roles-{Person.Id.Value}")" class="a-field--spaced">
            <ChildContent>
                <ChipGroup TValue="string" Items="Roles" Selected="_draft.Roles" Multiple="true"
                           aria-labelledby="@($"roles-{Person.Id.Value}")" SelectedChanged="_draft.SetRoles" />
            </ChildContent>
            <Hint>
                @if (Roles.Count == 0)
                {
                    <text>
                        This descriptor declares no roles in <code class="a-mono">auth.roles</code>.
                        A role nothing declares is never minted, so assigning one would do nothing.
                    </text>
                }
                else
                {
                    <text>A highlighted role is assigned. Press one to change it.</text>
                }
            </Hint>
        </Field>

        @*
            The operator's own editor offers no tenant control. The core refuses a person granting themselves a
            tenant (§3.7 U3.2), and a control whose only outcome is that refusal is worse than the sentence that
            says who can. Remove is allowed by the core; it is hidden with the box so the editor carries no tenant
            control.
        *@
        @if (IsSelf)
        {
            <Field Label="Tenant">
                <span class="@(Person.Tenant is null ? "a-value" : "a-mono a-value")">
                    @(Person.Tenant?.Value.ToString() ?? "No tenant")
                </span>
                <span class="a-hint" data-testid="tenant-self">
                    You cannot grant yourself a tenant — another administrator can.
                </span>
            </Field>
        }
        else
        {
            <div class="a-stack a-stack--gap-3">
                <Field Label="Tenant" For="@TenantField">
                    <ChildContent>
                        <MudTextField @ref="_tenantField" T="string" Value="_tenantText" ValueChanged="TypeTenant"
                                      Immediate="true" Variant="Variant.Outlined" id="@TenantField" Class="a-mono"
                                      autocomplete="off" spellcheck="false" Error="@_fields.Has(TenantField)"
                                      aria-describedby="@_fields.DescribedBy(TenantField, TenantHint)" />
                        @_fields.Under(TenantField, () => _tenantField!.FocusAsync())
                    </ChildContent>
                    <Hint>
                        A tenant id (a uuid). One tenant, not a set: a tenant-scoped entity refuses a person with none
                        before any rule runs.
                    </Hint>
                </Field>
                <div class="a-row a-row--gap-2">
                    <AlvoButton Tone="AlvoButton.ButtonTone.Ghost" Small="true"
                                id="@($"clear-tenant-{Person.Id.Value}")" Disabled="@(_draft.Tenant.Length == 0)"
                                OnClick="_ => TypeTenant(string.Empty)">Remove tenant</AlvoButton>
                </div>
            </div>
        }
    </ChildContent>
</AlvoEditor>

@code {
    private AlvoEditor? _editor;
    private PersonDraft _draft = new([], null);
    private string _tenantText = string.Empty;
    private AlvoUser? _opened;
    private readonly FieldRefusals _fields = new();
    private MudTextField<string>? _tenantField;

    private string TenantField => $"tenant-{Person.Id.Value}";

    /// <summary>The Field's hint under the tenant box, which the box is described by.</summary>
    private string TenantHint => $"{TenantField}-hint";

    /// <summary>The person being edited, as the list last read them.</summary>
    [Parameter, EditorRequired]
    public AlvoUser Person { get; set; } = default!;

    /// <summary>The roles the descriptor declares, which are the only ones an assignment can name.</summary>
    [Parameter]
    public IReadOnlyList<string> Roles { get; set; } = [];

    /// <summary>Whether this is the signed-in operator, who is offered no tenant control.</summary>
    [Parameter]
    public bool IsSelf { get; set; }

    /// <summary>The credential token just issued for this person, shown until the editor closes.</summary>
    [Parameter]
    public AlvoCredentialToken? Token { get; set; }

    /// <summary>
    /// Raised on Save with what changed: the roles the chips now have when they differ, the tenant typed when it
    /// differs and is not empty, and whether the tenant is to be removed.
    /// </summary>
    [Parameter]
    public EventCallback<(IReadOnlyList<string>? Roles, string? Tenant, bool ClearTenant)> OnSave { get; set; }

    /// <summary>Raised to issue the person a single-use credential token.</summary>
    [Parameter]
    public EventCallback OnIssueToken { get; set; }

    /// <summary>Raised, once the editor may close, to ask whether the person should be disabled.</summary>
    [Parameter]
    public EventCallback OnRequestDisable { get; set; }

    /// <summary>Raised, once the editor may close, to let a disabled person sign in again.</summary>
    [Parameter]
    public EventCallback OnLetBackIn { get; set; }

    /// <summary>Raised when the operator closes the editor, once any discard question has been answered.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Raised by the token's Copy button.</summary>
    [Parameter]
    public EventCallback OnCopyToken { get; set; }

    /// <summary>Whether the page is still writing something this editor started.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// The refusal the page classified, drawn as the editor's first content; a fragment because the problem type is
    /// internal and a component's public parameter may not name it.
    /// </summary>
    [Parameter]
    public RenderFragment? Problem { get; set; }

    /// <summary>Starts a new draft when a different person, or the same person read again, is handed in.</summary>
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_opened, Person))
        {
            _opened = Person;
            _draft = new PersonDraft(Person.RoleNames, Person.Tenant?.Value.ToString());
            _tenantText = _draft.Tenant;
            _fields.ClearAll();
        }
    }

    /// <summary>Takes the tenant box's text as typed, and the draft's trimmed copy of it.</summary>
    private void TypeTenant(string? text)
    {
        _tenantText = text ?? string.Empty;
        _draft.SetTenant(_tenantText);
        _fields.Clear(TenantField);
    }

    /// <summary>
    /// Hands the page the parts of the draft that differ from the person as they were opened; with none, Save only
    /// closes.
    /// </summary>
    /// <remarks>
    /// Save stays enabled on a clean draft: Enter pressed straight after typing reaches the browser before the render
    /// that would enable it, and implicit submission does nothing on a disabled default button. A mistyped tenant is
    /// refused here, under its field, before anything is written (spec §3.3).
    /// </remarks>
    private Task SaveAsync()
    {
        if (!_draft.Dirty)
        {
            return OnClose.InvokeAsync();
        }

        var tenant = _draft.TenantChanged && _draft.Tenant.Length > 0 ? _draft.Tenant : null;
        if (tenant is not null && !TenantId.TryParse(tenant, null, out _))
        {
            _fields.Refuse(TenantField, "That is not a tenant id. A tenant is a uuid: copy it from a row's tenant_id, or from the caller you are modelling.");
            return Task.CompletedTask;
        }

        return OnSave.InvokeAsync((_draft.RolesChanged ? _draft.Roles : null, tenant,
            _draft.TenantChanged && _draft.Tenant.Length == 0));
    }

    /// <summary>Leaves the editor for <paramref name="next"/>, asking first when the draft holds unsaved changes.</summary>
    private Task LeaveForAsync(EventCallback next)
        => _editor is null ? next.InvokeAsync() : _editor.LeaveAsync(() => next.InvokeAsync());
}
