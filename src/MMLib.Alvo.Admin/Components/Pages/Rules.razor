@page "/admin/rules"
@page "/admin/rules/{EntityName}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject DataGateway Records
@inject NavigationManager Navigation

<PageTitle>Rules · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="Rules" />

    @if (_error is not null)
    {
        <ErrorPanel Problem="@_error" />
    }
    else if (_schema is null)
    {
        <div class="a-skeleton" style="height:260px"></div>
    }
    else
    {
        <div class="a-tabs">
            @foreach (var entity in _schema.Entities)
            {
                <button type="button" class="@($"a-tab{(entity.Name == Selected ? " a-tab--active" : string.Empty)}")"
                        @onclick="() => Choose(entity.Name)">@entity.Name</button>
            }
        </div>

        <div class="a-split">
            <div class="a-panel" style="flex:1;min-width:0">
                <RulesTab Rules="_rules" Entity="@Selected" />
            </div>

            <div class="a-split__aside" style="min-width:340px;max-width:420px">
                <div class="a-card" style="gap:var(--space-4)">
                    <div>
                        <span class="a-section-title">Simulate a policy</span>
                        <p class="a-section-sub">
                            An entity, an operation and a caller in; the engine's own verdict out. This is
                            <code class="a-mono">POST /management/projects/{project}/policy/simulate</code>,
                            answered by the same <code class="a-mono">IPolicyEngine</code> the Data API uses.
                        </p>
                    </div>

                    <div class="a-field">
                        <span class="a-label">Signed in as</span>
                        <div class="a-choice">
                            @foreach (var caller in _callers)
                            {
                                <button type="button"
                                        class="@($"a-chip{(caller.Label == _caller.Label ? " a-chip--on" : string.Empty)}")"
                                        @onclick="() => Pick(caller)">@caller.Label</button>
                            }
                        </div>
                        <span class="a-section-sub">
                            roles: @(_caller.Roles.Count == 0 ? "none" : string.Join(", ", _caller.Roles)) ·
                            tenant: @(_caller.Tenant is { } tenant ? tenant.ToString() : "none")
                        </span>
                    </div>

                    <div class="a-field">
                        <span class="a-label">Operation</span>
                        <div class="a-choice">
                            @foreach (var operation in _operations)
                            {
                                <button type="button"
                                        class="@($"a-chip{(operation == _operation ? " a-chip--on" : string.Empty)}")"
                                        @onclick="() => SetOperation(operation)">@operation</button>
                            }
                        </div>
                    </div>

                    @if (_simulationError is not null)
                    {
                        <ErrorPanel Problem="@_simulationError" />
                    }
                    else if (_verdict is { } verdict)
                    {
                        <PolicyVerdictView Verdict="verdict" Operation="_operation" Entity="@Selected" />
                    }

                    <p class="a-note" style="border-top:1px solid var(--border);padding-top:var(--space-3)">
                        <strong>Why there is no record picker.</strong>
                        <code class="a-mono">ManagementPolicySimulation</code> takes no record id, deliberately:
                        evaluating a predicate against a stored row needs a read, and the Management API has no
                        data surface. A client that scored a row here would be a second policy evaluator — and
                        the first time it disagreed with the engine, this screen would teach the wrong thing
                        with total confidence. To check one row, open it in Data under your own credential and
                        compare.
                        <a class="a-btn a-btn--sm" style="margin-top:var(--space-3)"
                           href="@($"{AlvoAdmin.BasePath}/data/{Selected}")">Open @Selected in Data</a>
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] _operations = ["list", "get", "create", "update", "delete"];

    private readonly List<Caller> _callers = [];
    private SchemaModel? _schema;
    private IReadOnlyList<KeyValuePair<string, string>> _rules = [];
    private ManagementPolicyVerdict? _verdict;
    private Exception? _error;
    private Exception? _simulationError;
    private Caller _caller = new("anonymous", null, [], null);
    private string _operation = "list";

    /// <summary>The entity whose rules are shown, from the route.</summary>
    [Parameter]
    public string? EntityName { get; set; }

    private string Selected => EntityName ?? _schema?.Entities.FirstOrDefault()?.Name ?? string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _schema = await Gateway.SchemaAsync(CancellationToken.None);
            var descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _rules = DescriptorLens.Rules(descriptor.DescriptorJson, Selected);

            if (_callers.Count == 0)
            {
                await BuildCallersAsync(descriptor.DescriptorJson);
            }

            await SimulateAsync();
        }
        catch (Exception exception) when (exception is ManagementForbiddenException
            or ManagementProjectNotFoundException or ManagementRequestException)
        {
            _error = exception;
        }
    }

    /// <summary>
    /// The callers worth asking about.
    /// </summary>
    /// <remarks>
    /// <b>You, anonymous, and one caller per declared role.</b> "You" is the honest default because
    /// it is the only caller whose answer an operator can go and verify in Data; anonymous is the
    /// one every default-deny argument turns on; and the per-role callers come from
    /// <c>auth.roles</c> rather than from a list here, so a role added to the descriptor appears
    /// without anybody editing this screen.
    /// </remarks>
    private async Task BuildCallersAsync(string descriptorJson)
    {
        var mine = await Records.ContextAsync(CancellationToken.None);
        _caller = new Caller("you", mine.User == default ? null : mine.User.Value,
            [.. mine.Roles.Select(role => role.Name)], mine.Tenant?.Value);

        _callers.Add(_caller);
        _callers.Add(new Caller("anonymous", null, [], null));

        /* A synthetic id per role, because a rule can name @user.id and the engine needs *a*
           subject to compile against. It is not a real account and cannot be: the point of these
           callers is the predicate they produce, and a predicate over @user.id renders with
           whatever id it was given. Your own caller, above, is the one whose answer can be checked
           against Data. */
        foreach (var role in DescriptorLens.DeclaredRoles(descriptorJson))
        {
            _callers.Add(new Caller(role, Guid.NewGuid(), [role, "authenticated"], mine.Tenant?.Value));
        }
    }

    private void Choose(string entity) => Navigation.NavigateTo($"{AlvoAdmin.BasePath}/rules/{entity}");

    private async Task Pick(Caller caller)
    {
        _caller = caller;
        await SimulateAsync();
    }

    private async Task SetOperation(string operation)
    {
        _operation = operation;
        await SimulateAsync();
    }

    private async Task SimulateAsync()
    {
        if (Selected.Length == 0)
        {
            return;
        }

        try
        {
            _simulationError = null;
            _verdict = await Gateway.SimulateAsync(
                new ManagementPolicySimulation(
                    Selected, _operation,
                    new ManagementSimulatedCaller(_caller.User, _caller.Roles, _caller.Tenant)),
                CancellationToken.None);
        }
        catch (Exception exception) when (exception is ManagementSimulationException
            or ManagementForbiddenException or ManagementRequestException)
        {
            _simulationError = exception;
            _verdict = null;
        }
    }

    /// <summary>One caller to ask the engine about.</summary>
    private sealed record Caller(string Label, Guid? User, IReadOnlyList<string> Roles, Guid? Tenant);
}
