@page "/admin/access"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject ILogger<Access> Logger

<PageTitle>Access · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="Access"
                Subtitle="Two different things live here and they take effect at different times. Membership — who exists, what roles they have, which tenant they act in — is the identity store, and a change applies at once. The role catalogue and the three management levels are the descriptor, and a change to either waits for an apply." />

    @if (_problem is not null)
    {
        <ErrorPanel Problem="@_problem.Exception" Fix="@_problem.Fix" />
    }

    @if (_token is { } token)
    {
        <Panel Padded="true" class="a-panel--accent">
            <span class="a-section-title">Credential token for @_tokenFor</span>
            <p class="a-section-sub">
                Hand this over out of band — this build sends no email. It works once, until
                @token.ExpiresAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture).
            </p>
            <pre class="a-code"><code>@token.Token</code></pre>
        </Panel>
    }

    <Panel Title="People">
        <Subtitle>
            @(Gateway.CanAdministerPeople
                ? "From the identity store. Changes here take effect on the next request."
                : "This deployment registered no membership store.")
        </Subtitle>
        <ChildContent>
            @if (!Gateway.CanAdministerPeople)
            {
                <Refusal>
                    This deployment has no membership store, so there is nobody to administer here. An
                    embedded host provides one over its own directory; the standalone image ships with one.
                </Refusal>
            }
            else if (_people is null)
            {
                <Skeleton />
            }
            else
            {
                @foreach (var person in _people.Users)
                {
                    @* A stable id per person, so a row can be addressed by who it is rather than by
                       where it sits in a list that reorders. *@
                    <ListRow id="@($"person-{person.Id.Value}")" class="a-listrow--roomy a-listrow--wrap a-listrow--inline">
                        <span style="flex:1;min-width:220px">
                            <span style="font-size:var(--text-sm);font-weight:var(--weight-medium)">@person.Email</span>
                            <span class="a-switcher-meta">
                                @(person.RoleNames.Count == 0 ? "no roles" : string.Join(", ", person.RoleNames)) ·
                                @(person.Tenant is { } tenant ? $"tenant {tenant.Value}" : "no tenant")
                                @if (person.IsDisabled)
                                {
                                    <text> · disabled</text>
                                }
                            </span>
                        </span>

                        <div class="a-row a-row--gap-2" style="flex-wrap:wrap">
                            <button type="button" class="a-btn a-btn--ghost a-btn--sm"
                                    id="@($"change-{person.Id.Value}")"
                                    @onclick="() => _editing = _editing == person.Id ? null : person.Id">
                                @(_editing == person.Id ? "Close" : "Change")
                            </button>
                        </div>

                        @if (_editing == person.Id)
                        {
                            var self = person.Id == _self;
                            <div class="a-stack" style="flex-basis:100%;gap:var(--space-4)">
                                <Field Label="Roles" LabelId="@($"roles-{person.Id.Value}")" class="a-field--spaced">
                                    <ChildContent>
                                        <ChipGroup TValue="string" Items="_roles" Selected="person.RoleNames" Multiple="true"
                                                   aria-labelledby="@($"roles-{person.Id.Value}")"
                                                   SelectedChanged="roles => SetRolesAsync(person, roles)" />
                                    </ChildContent>
                                    <Hint>
                                        @if (_roles.Count == 0)
                                        {
                                            <text>
                                                This descriptor declares no roles in <code class="a-mono">auth.roles</code>.
                                                A role nothing declares is never minted, so assigning one would do nothing.
                                            </text>
                                        }
                                        else
                                        {
                                            <text>A highlighted role is assigned. Press one to change it.</text>
                                        }
                                    </Hint>
                                </Field>

                                <Field Label="Tenant" For="@(self ? null : $"tenant-{person.Id.Value}")" class="a-field--spaced">
                                    @*
                                        The operator's own row offers no Grant and no Remove. The core refuses a
                                        person granting themselves a tenant (§3.7 U3.2), and a control whose only
                                        outcome is that refusal — shown at the top of the page, far from the
                                        button — is worse than the sentence that says who can. Remove is allowed
                                        by the core; it is hidden with Grant so the row carries no tenant control.
                                    *@
                                    @if (self)
                                    {
                                        <span class="@(person.Tenant is null ? null : "a-mono")" style="font-size:var(--text-sm)">
                                            @(person.Tenant?.Value.ToString() ?? "No tenant")
                                        </span>
                                        <span class="a-hint" data-testid="tenant-self">
                                            You cannot grant yourself a tenant — another administrator can.
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="a-row a-row--gap-2">
                                            <input class="a-input a-mono" id="@($"tenant-{person.Id.Value}")" style="flex:1"
                                                   value="@(person.Tenant?.Value.ToString() ?? string.Empty)"
                                                   autocomplete="off" spellcheck="false"
                                                   @oninput="args => _tenantDraft = args.Value?.ToString() ?? string.Empty" />
                                            <button type="button" class="a-btn a-btn--sm"
                                                    id="@($"grant-tenant-{person.Id.Value}")"
                                                    @onclick="() => SetTenantAsync(person)">Grant</button>
                                            <button type="button" class="a-btn a-btn--ghost a-btn--sm"
                                                    id="@($"clear-tenant-{person.Id.Value}")"
                                                    @onclick="() => ClearTenantAsync(person)">Remove</button>
                                        </div>
                                        <span class="a-hint">
                                            A tenant id (a uuid). One tenant, not a set: a tenant-scoped entity
                                            refuses a person with none before any rule runs.
                                        </span>
                                    }
                                </Field>

                                <div class="a-row" style="flex-wrap:wrap;padding-top:var(--space-3);border-top:1px solid var(--border)">
                                    <button type="button" class="a-btn a-btn--sm"
                                            id="@($"issue-token-{person.Id.Value}")"
                                            @onclick="() => IssueTokenAsync(person)">
                                        Issue a credential token
                                    </button>
                                    <span class="a-spacer"></span>
                                    <button type="button" class="a-btn a-btn--danger a-btn--sm"
                                            id="@($"disable-{person.Id.Value}")"
                                            @onclick="() => SetDisabledAsync(person, !person.IsDisabled)">
                                        @(person.IsDisabled ? "Let them back in" : "Disable")
                                    </button>
                                </div>
                            </div>
                        }
                    </ListRow>
                }

                <div style="padding:var(--space-5);border-top:1px solid var(--border)">
                    <span class="a-section-title">Add a person</span>
                    <p class="a-section-sub">
                        No password field, deliberately: a credential that travels as a value is readable by
                        whoever handles it. The account is created without one and you hand over a
                        single-use token.
                    </p>
                    <div class="a-row a-row--gap-2">
                        <input class="a-input" id="new-person-email" style="flex:1" type="email"
                               placeholder="dispatcher@example.com" value="@_newEmail"
                               @oninput="args => _newEmail = args.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="a-btn a-btn--primary a-btn--sm" @onclick="CreateAsync"
                                disabled="@(_newEmail.Trim().Length == 0)">Create</button>
                    </div>
                </div>
            }
        </ChildContent>
    </Panel>

    <Panel Title="Management levels">
        <Subtitle>
            From the descriptor's <code class="a-mono">access</code> block. Three independent
            predicates, not a hierarchy: all three are evaluated and the highest match wins.
            Changing one is an apply, and an apply that touches this block re-qualifies to admin.
        </Subtitle>
        <ChildContent>
            @if (_levels.Count == 0)
            {
                <EmptyState Title="This descriptor declares no access block"
                            Body="Only the bootstrap administrator can manage the project — which is default-deny working, and is usable: the first-run flow needs nobody else." />
            }
            else
            {
                @foreach (var level in _levels)
                {
                    <ListRow class="a-listrow--roomy a-listrow--stacked">
                        <span class="a-badge a-badge--accent">@level.Key</span>
                        <pre class="a-code" style="margin-top:var(--space-2)"><code>@level.Value</code></pre>
                    </ListRow>
                }
            }
        </ChildContent>
    </Panel>

    <Panel Title="Role catalogue">
        <Subtitle>
            <code class="a-mono">auth.roles</code> — the names a rule may name. A membership row
            naming a role this list does not declare is never minted into a caller's context.
        </Subtitle>
        <ChildContent>
            <div style="padding:var(--space-4) var(--space-5);display:flex;gap:var(--space-2);flex-wrap:wrap">
                @foreach (var role in _roles)
                {
                    <span class="a-badge a-mono">@role</span>
                }
                <span class="a-badge">anon</span>
                <span class="a-badge">authenticated</span>
                <span class="a-badge">admin</span>
            </div>
            <span class="a-hint" style="padding:0 var(--space-5) var(--space-4);display:block">
                The last three are built in and never declared.
            </span>
        </ChildContent>
    </Panel>
</div>

@code {
    private AlvoUserPage? _people;
    private IReadOnlyList<string> _roles = [];
    private IReadOnlyList<KeyValuePair<string, string>> _levels = [];
    private AlvoCredentialToken? _token;
    private AdminProblem? _problem;
    private string _tokenFor = string.Empty;
    private string _tenantDraft = string.Empty;
    private string _newEmail = string.Empty;
    private UserId? _editing;
    private UserId? _self;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _roles = DescriptorLens.DeclaredRoles(descriptor.DescriptorJson);
            _levels = DescriptorLens.AccessLevels(descriptor.DescriptorJson);
            _self ??= await Gateway.SelfAsync(CancellationToken.None);

            if (Gateway.CanAdministerPeople)
            {
                _people = await Gateway.PeopleAsync(new AlvoUserQuery(), CancellationToken.None);
            }
        }
        catch (Exception exception)
        {
            Refused(exception);
        }
    }

    private Task SetRolesAsync(AlvoUser person, IReadOnlyList<string> roles)
        => WriteAsync(() => Gateway.SetRolesAsync(person.Id, roles, CancellationToken.None));

    private async Task SetTenantAsync(AlvoUser person)
    {
        if (!TenantId.TryParse(_tenantDraft, null, out var tenant))
        {
            _problem = AdminProblem.From(new ManagementRequestException("That is not a tenant id."))! with
            {
                Fix = "A tenant is a uuid. Copy it from a row's tenant_id, or from the caller you are modelling.",
            };
            return;
        }

        await WriteAsync(() => Gateway.SetTenantAsync(person.Id, tenant, CancellationToken.None));
    }

    private Task ClearTenantAsync(AlvoUser person)
        => WriteAsync(() => Gateway.SetTenantAsync(person.Id, null, CancellationToken.None));

    private Task SetDisabledAsync(AlvoUser person, bool disabled)
        => WriteAsync(() => Gateway.SetDisabledAsync(person.Id, disabled, CancellationToken.None));

    private async Task IssueTokenAsync(AlvoUser person)
    {
        try
        {
            _token = await Gateway.IssueCredentialTokenAsync(person.Id, CancellationToken.None);
            _tokenFor = person.Email;
            _problem = null;
        }
        catch (Exception exception)
        {
            Refused(exception);
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            await Gateway.CreatePersonAsync(
                new AlvoUserCreation(_newEmail.Trim(), []), CancellationToken.None);
            _newEmail = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Refused(exception);
        }
    }

    private async Task WriteAsync(Func<Task<AlvoUser>> write)
    {
        try
        {
            await write();
            _problem = null;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Refused(exception);
        }
    }

    /// <summary>Renders the refusal, with the fix that says which of the guards produced it.</summary>
    private void Refused(Exception exception)
        => _problem = AdminProblem.From(exception, Logger, ProblemSite.People);
}
