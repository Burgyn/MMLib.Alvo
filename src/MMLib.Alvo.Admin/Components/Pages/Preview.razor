@page "/admin/changes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject AdminSession Session
@inject NavigationManager Navigation
@inject ILogger<Preview> Logger

<PageTitle>Preview changes · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Eyebrow="Schema" EyebrowHref="@AdminPaths.Schema" Title="Preview changes" />

    @if (_problem is not null)
    {
        <ErrorPanel Problem="@_problem.Exception" Fix="@_problem.Fix" />
    }

    @if (!Copy.Loaded)
    {
        <Skeleton />
    }
    else if (!Copy.IsDirty)
    {
        <EmptyState Title="Nothing to apply"
                    Body="@($"The working copy is identical to revision {Copy.Revision}. Change something in Schema, or import a descriptor.")">
            <a class="a-btn a-btn--sm" href="@AdminPaths.Schema">Back to Schema</a>
        </EmptyState>
    }
    else
    {
        <p class="a-note">
            Nothing below has run. Planning asks the database what this change would do, and changes nothing.
            <span class="a-ident a-ident--block">API: PUT …/descriptor?dryRun=true</span>
        </p>

        <Panel Title="What changed">
            <Subtitle>The descriptor as it would be sent, against revision @Copy.Revision.</Subtitle>
            <ChildContent>
                <DescriptorDiff Before="@Copy.AppliedJson" After="@Copy.Json" Revision="@Copy.Revision" />
            </ChildContent>
        </Panel>

        @if (_plan is null)
        {
            <Panel Padded="true" class="a-row">
                <button type="button" class="a-btn a-btn--primary" disabled="@_busy" @onclick="PlanAsync">
                    Plan this change
                </button>
                <button type="button" class="a-btn a-btn--sm" disabled="@_busy"
                        data-testid="discard" @onclick="() => _discarding = true">
                    Discard them
                </button>
            </Panel>
        }
        else
        {
            <Panel Title="@PlanTitle(_plan.Plan)">
                <Subtitle>
                    @(_plan.Plan.IsEmpty
                        ? "A rules-only or access-only edit changes no table. It is still an apply, and it still appends a revision."
                        : "In this order, in one transaction.")
                </Subtitle>
                <ChildContent>
                    @foreach (var step in _plan.Plan.Steps.Select(PlanStep.Parse))
                    {
                        <ListRow data-testid="plan-step" class="a-listrow--inline">
                            <span class="@($"a-badge a-listrow__aside {(step.Destructive ? "a-badge--danger" : "a-badge--ok")}")">
                                @(step.Destructive ? "destroys" : "safe")
                            </span>
                            <span class="a-listrow__main">
                                @* One expression with its trailing space: a bare `@step.Verb` followed by the element on
                                   the next line lost the whitespace between them ("Drop columncustomers.notes"). *@
                                @($"{step.Verb} ")
                                @if (step.Target.Length > 0)
                                {
                                    <code class="a-mono">@step.Target</code>
                                }
                                @if (step.Consequence is { } consequence)
                                {
                                    <text> — @consequence</text>
                                }
                            </span>
                        </ListRow>
                    }
                </ChildContent>
            </Panel>

            @if (_plan.Plan.HasDestructiveChanges)
            {
                <ConfirmByName Title="This plan destroys data"
                               Detail="Permission to lose data is never implied — not by this preview, and not by your management level. Confirming here is what allows it."
                               Expected="@Gateway.Project"
                               OnConfirmedChanged="confirmed => _allowed = confirmed" />
            }

            <Panel Padded="true">
                <Field Label="Why" For="apply-reason">
                    <ChildContent>
                        <input class="a-input" id="apply-reason" value="@_reason" placeholder="@ReasonPlaceholder"
                               @oninput="args => _reason = args.Value?.ToString() ?? string.Empty" />
                    </ChildContent>
                    <Hint>Configuration history shows this on the revision forever.</Hint>
                </Field>
            </Panel>

            <div class="a-toolbar">
                <a class="a-btn a-btn--ghost a-btn--sm" href="@AdminPaths.Schema">Back to the editor</a>
                <button type="button" class="a-btn a-btn--sm" disabled="@_busy"
                        data-testid="discard" @onclick="() => _discarding = true">
                    Discard them
                </button>
                <span class="a-spacer"></span>
                <span class="a-hint">
                    Applying as yourself, against revision @Copy.Revision. If somebody applies first, this is
                    refused rather than written over theirs.
                </span>
                <button type="button" class="a-btn a-btn--primary"
                        disabled="@(_busy || (_plan.Plan.HasDestructiveChanges && !_allowed))"
                        @onclick="ApplyAsync">
                    Apply these changes
                </button>
            </div>
        }
    }

    <DiscardSheet Open="_discarding" OnClose="() => _discarding = false" OnDiscarded="Discarded" />

    @if (_applied is { } result)
    {
        <Panel Padded="true" class="a-panel--accent">
            <span class="a-section-title">Applied as revision @result.Revision</span>
            <p class="a-section-sub">
                @(result.Replayed
                    ? "This request repeated one that had already run — the revision it names was applied by the earlier one."
                    : "The migration ran and the revision was appended.")
            </p>
            <a class="a-btn a-btn--sm" href="@AdminPaths.History">Open Configuration history</a>
        </Panel>
    }
</div>

@code {
    /// <summary>
    /// This operator's working copy, resolved from the store rather than injected.
    /// </summary>
    /// <remarks>
    /// Empty until the first render has resolved who is signed in — the markup therefore reads it
    /// through <c>Copy.Loaded</c> rather than assuming a document is there.
    /// </remarks>
    private WorkingCopy Copy { get; set; } = new();

    private ManagementApplyResult? _plan;
    private ManagementApplyResult? _applied;
    private AdminProblem? _problem;
    private string _reason = string.Empty;
    private bool _allowed;
    private bool _busy;
    private bool _discarding;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Copy = await Session.WorkingCopyAsync(CancellationToken.None);
        }
        catch (Exception exception)
        {
            _problem = AdminProblem.From(exception, Logger);
        }

        /* A copy the assistant composed carries what it was asked for. Pre-filled rather than imposed: the
           operator can replace every character, which is what keeps the history a record of what a person
           meant rather than of what a machine drafted. */
        if (_reason.Length == 0 && Copy.SuggestedReason is { Length: > 0 } suggested)
        {
            _reason = suggested;
        }
    }

    /// <summary>
    /// Returns to the editor once every unapplied edit has been thrown away.
    /// </summary>
    /// <remarks>
    /// <b>The control that was missing, and its absence made the draft one-way.</b> Removing a field, or
    /// any other edit, writes to the working copy immediately and deliberately — nothing has touched the
    /// database, so staging needs no confirmation. That argument only holds while there is a way back, and
    /// there was not: <c>WorkingCopy.Discard</c> existed and no screen called it, so an operator who staged
    /// something they did not want could only apply it or abandon the session.
    /// </remarks>
    private void Discarded()
    {
        _discarding = false;
        _plan = null;
        _applied = null;
        Navigation.NavigateTo(AdminPaths.Schema);
    }

    private static string PlanTitle(ManagementPlanSummary plan) => plan.IsEmpty
        ? "No migration — the schema is unchanged"
        : $"{plan.Steps.Count} step{(plan.Steps.Count == 1 ? string.Empty : "s")} against the database";

    private Task PlanAsync() => SendAsync(dryRun: true);

    private Task ApplyAsync() => SendAsync(dryRun: false);

    private async Task SendAsync(bool dryRun)
    {
        _busy = true;
        _problem = null;

        try
        {
            /* A dry run asks what would happen, so it asks with destruction allowed; the apply asks
               with what the operator has actually confirmed. Asking the plan under `_allowed` was a
               deadlock: a drop was refused before a plan existed, the refusal said to type the
               project's name "above", and that control renders only once there is a plan — so a
               destructive change could be composed and never reviewed or applied from here. Nothing
               is destroyed by describing it. */
            var result = await Gateway.ApplyAsync(
                Copy.Json, Copy.Revision, allowDestructive: dryRun || _allowed, dryRun,
                author: await Gateway.AuthorAsync(),
                reason: _reason.Length > 0 ? _reason : null,
                CancellationToken.None);

            if (dryRun)
            {
                _plan = result;
            }
            else
            {
                _applied = result;
                _plan = null;
                var descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
                Copy.Take(descriptor.DescriptorJson, descriptor.Revision);
            }
        }
        catch (Exception exception)
        {
            _problem = AdminProblem.From(exception, Logger, ProblemSite.SchemaApply);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// What the "Why" box offers before anything is typed: a sentence about this change, when one can be said.
    /// </summary>
    /// <remarks>
    /// The fixed example it replaced — about widening a price — sat above every plan, including ones that
    /// created a table, and read as a value somebody had already filled in. The assistant's own suggestion
    /// comes first, because it knows what it was asked; a one-step plan can be named from the step; anything
    /// else gets the question the box is asking.
    /// </remarks>
    private string ReasonPlaceholder
        => Copy.SuggestedReason is { Length: > 0 } suggested
            ? suggested
            : PlanStep.SuggestReason(_plan?.Plan.Steps ?? []) ?? "What does this change do, and why?";
}
