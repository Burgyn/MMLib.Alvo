@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway

<PageTitle>Overview · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="@(_descriptor is null ? "Overview" : Gateway.Project)" />

    @if (_error is not null)
    {
        <ErrorPanel Problem="@_error" />
    }
    else if (_schema is null)
    {
        <div class="a-cards">
            <div class="a-skeleton" style="height:96px"></div>
            <div class="a-skeleton" style="height:96px"></div>
            <div class="a-skeleton" style="height:96px"></div>
        </div>
    }
    else
    {
        @if (_schema.Entities.Count == 0 || _revisions.Count == 0)
        {
            <div class="a-panel" style="padding:var(--space-5);border-color:var(--accentBorder)">
                <span class="a-section-title">This project is new</span>
                <p class="a-section-sub">
                    Three things make a backend: entities, the rules that guard them, and a tenant if
                    the data is per-customer. The first run walks through them in that order.
                </p>
                <a class="a-btn a-btn--primary a-btn--sm" href="@($"{AlvoAdmin.BasePath}/welcome")">
                    Open the first run
                </a>
            </div>
        }

        @*
            One badge for the fact an operator acts on, and one quiet line for how this instance runs.
            The registered data provider's type name was a third chip here; it is an implementation
            name, and Settings is where it is shown with the sentence that explains it.
        *@
        <div class="a-row" style="gap:var(--space-3);flex-wrap:wrap">
            <span class="a-badge a-badge--ok">Revision @_descriptor!.Revision applied</span>
            <span class="a-note" data-testid="overview-runtime">@Runtime(_info!)</span>
        </div>

        <div class="a-cards">
            <Stat Label="Entities" Value="@_schema.Entities.Count.ToString(CultureInfo.InvariantCulture)"
                  Note="tables Alvo created and keeps in step" />
            <Stat Label="Revisions" Value="@_revisions.Count.ToString(CultureInfo.InvariantCulture)"
                  Note="appended, never rewritten" />
            <Stat Label="Honoured blocks" Value="@_capabilities!.Honoured.Count.ToString(CultureInfo.InvariantCulture)"
                  Note="of the descriptor, running today" />
        </div>

        @if (Declared.Count > 0)
        {
            <div class="a-notyet-panel">
                <div class="a-section">
                    <span class="a-section-title">Declared, and not running yet</span>
                    <span class="a-section-sub">
                        This descriptor declares @Declared.Count block@(Declared.Count == 1 ? "" : "s")
                        that this build parses and then honours nowhere. The apply succeeded; nothing runs.
                    </span>
                </div>
                @foreach (var block in Declared)
                {
                    <div class="a-notyet-panel__body">
                        <span class="a-badge a-badge--warn">@block.Block</span>
                        <span class="a-notyet-panel__consequence">@block.Consequence</span>
                    </div>
                }
            </div>
        }

        <div class="a-panel">
            <div class="a-section">
                <span class="a-section-title">Latest configuration change</span>
                <span class="a-section-sub">The whole history is under Configuration history.</span>
            </div>
            @if (_revisions.Count == 0)
            {
                <div class="a-empty">
                    <div class="a-empty__title">Nothing has been applied yet</div>
                    <div class="a-empty__body">
                        The descriptor this host booted from has not been through an apply.
                        Open Schema to make the first change.
                    </div>
                </div>
            }
            else
            {
                <RevisionRow Revision="@_revisions[0]" />
            }
        </div>
    }
</div>

@code {
    private ManagementDescriptor? _descriptor;
    private SchemaModel? _schema;
    private ManagementCapabilities? _capabilities;
    private ManagementInfo? _info;
    private IReadOnlyList<ManagementRevision> _revisions = [];
    private Exception? _error;

    /// <summary>
    /// <b>Warned blocks intersected with what this descriptor actually declares</b> (§4.2).
    /// <c>capabilities.warned</c> lists every block this build honours nowhere; a project that
    /// declares none of them has nothing to be warned about, and a panel listing five subsystems
    /// nobody asked for would train an operator to ignore the panel.
    /// </summary>
    private IReadOnlyList<ManagementWarnedBlock> Declared { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _schema = await Gateway.SchemaAsync(CancellationToken.None);
            _capabilities = await Gateway.CapabilitiesAsync(CancellationToken.None);
            _info = await Gateway.InfoAsync(CancellationToken.None);
            _revisions = await Gateway.RevisionsAsync(CancellationToken.None);
            Declared = DeclaredWarnings(_descriptor.DescriptorJson, _capabilities);
        }
        catch (Exception exception) when (exception is ManagementForbiddenException
            or ManagementProjectNotFoundException or ManagementRequestException)
        {
            _error = exception;
        }
    }

    /// <summary>How this instance runs, as one line an operator reads rather than three raw values.</summary>
    /// <remarks>
    /// A mode this build does not name is shown as reported rather than hidden, so a future value
    /// reads as itself instead of as the nearest one this switch happens to know.
    /// </remarks>
    private static string Runtime(ManagementInfo info)
    {
        var mode = info.Mode.Length > 0
            ? string.Concat(info.Mode[..1].ToUpperInvariant(), info.Mode[1..])
            : info.Mode;

        var startup = info.StartupMode switch
        {
            "apply" => "applies on start",
            "verify" => "verifies on start",
            "skip" => "leaves the schema alone on start",
            var other => $"starts in {other} mode",
        };

        return $"{mode} · {startup}";
    }

    private static IReadOnlyList<ManagementWarnedBlock> DeclaredWarnings(
        string descriptorJson, ManagementCapabilities capabilities)
    {
        using var document = JsonDocument.Parse(descriptorJson);
        if (document.RootElement.ValueKind != JsonValueKind.Object)
        {
            return [];
        }

        var declared = document.RootElement.EnumerateObject()
            .Select(property => property.Name)
            .ToHashSet(StringComparer.Ordinal);

        return capabilities.Warned.Where(block => declared.Contains(block.Block)).ToList();
    }
}
