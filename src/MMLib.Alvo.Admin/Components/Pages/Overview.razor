@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway
@inject ILogger<Overview> Logger

<PageTitle>Overview · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="@(_descriptor is null ? "Overview" : Gateway.Project)" />

    @if (_problem is not null)
    {
        <ErrorPanel Problem="@_problem.Exception" />
    }
    else if (_schema is null)
    {
        <div class="a-cards">
            <div class="a-skeleton" style="height:96px"></div>
            <div class="a-skeleton" style="height:96px"></div>
            <div class="a-skeleton" style="height:96px"></div>
        </div>
    }
    else
    {
        @if (_schema.Entities.Count == 0 || _revisions.Count == 0)
        {
            <div class="a-panel" style="padding:var(--space-5);border-color:var(--accentBorder)">
                <span class="a-section-title">This project is new</span>
                <p class="a-section-sub">
                    Three things make a backend: entities, the rules that guard them, and a tenant if
                    the data is per-customer. The first run walks through them in that order.
                </p>
                <a class="a-btn a-btn--primary a-btn--sm" href="@AdminPaths.Welcome">
                    Open the first run
                </a>
            </div>
        }

        @*
            One badge for the fact an operator acts on, and one quiet line for how this instance runs.
            The registered data provider's type name was a third chip here; it is an implementation
            name, and Settings is where it is shown with the sentence that explains it.
        *@
        <div class="a-row" style="gap:var(--space-3);flex-wrap:wrap">
            <span class="a-badge a-badge--ok">Revision @_descriptor!.Revision applied</span>
            <span class="a-note" data-testid="overview-runtime">@Runtime(_info!)</span>
        </div>

        <div class="a-cards">
            <Stat Label="Entities" Value="@_schema.Entities.Count.ToString(CultureInfo.InvariantCulture)"
                  Note="tables Alvo created and keeps in step" />
            <Stat Label="Revisions" Value="@_revisions.Count.ToString(CultureInfo.InvariantCulture)"
                  Note="appended, never rewritten" />
            <Stat Label="Honoured blocks" Value="@_capabilities!.Honoured.Count.ToString(CultureInfo.InvariantCulture)"
                  Note="of the descriptor, running today" />
        </div>

        @*
            A normal panel under the stats rather than the centred dashed callout it was: it lists
            facts about blocks this project declared, and the callout's shape — kept for empty states —
            made a list of consequences read as one. The heading claims only what is true of every row;
            DeclaredLimits says why the rows are not split into "not running" and "partly running".
        *@
        @if (Declared.Count > 0)
        {
            <div class="a-panel" data-testid="overview-limits">
                <div class="a-section">
                    <span class="a-section-title">Declared, with limits in this build</span>
                    <span class="a-section-sub">Parts of these blocks are not honoured yet — each says which.</span>
                </div>
                @foreach (var block in Declared)
                {
                    <div class="a-listrow" data-testid="@($"overview-limit-{block.Block}")">
                        <span class="a-listrow__type"><span class="a-badge a-badge--warn a-mono">@block.Block</span></span>
                        <p class="a-note">@block.Consequence</p>
                    </div>
                }
            </div>
        }

        @*
            The four places an operator goes next, each with the one number that says what is there.
            Only counts this screen already holds or reads from the descriptor it already has: a count
            that cost its own round trip would make the landing page the slowest screen to open.
        *@
        <nav class="a-cards" aria-label="Sections" data-testid="overview-links">
            <a class="a-card a-card--action" href="@AdminPaths.Schema" data-testid="overview-link-schema">
                <span class="a-section-title">Schema</span>
                <span class="a-section-sub">@Count(_schema.Entities.Count, "entity", "entities")</span>
            </a>
            <a class="a-card a-card--action" href="@AdminPaths.Data" data-testid="overview-link-data">
                <span class="a-section-title">Data</span>
                <span class="a-section-sub">Browse the records of @Count(_schema.Entities.Count, "entity", "entities")</span>
            </a>
            <a class="a-card a-card--action" href="@AdminPaths.Rules()" data-testid="overview-link-rules">
                <span class="a-section-title">Rules</span>
                <span class="a-section-sub">@Count(_rules, "rule", "rules") declared</span>
            </a>
            <a class="a-card a-card--action" href="@AdminPaths.Access" data-testid="overview-link-access">
                <span class="a-section-title">Access</span>
                <span class="a-section-sub">@Count(_roles, "role", "roles") declared</span>
            </a>
        </nav>

        <div class="a-panel">
            <div class="a-section">
                <span class="a-section-title">Latest configuration change</span>
                <span class="a-section-sub">The whole history is under Configuration history.</span>
            </div>
            @if (_revisions.Count == 0)
            {
                <div class="a-empty">
                    <div class="a-empty__title">Nothing has been applied yet</div>
                    <div class="a-empty__body">
                        The descriptor this host booted from has not been through an apply.
                        Open Schema to make the first change.
                    </div>
                </div>
            }
            else
            {
                <RevisionRow Revision="@_revisions[0]" />
            }
        </div>
    }
</div>

@code {
    private ManagementDescriptor? _descriptor;
    private SchemaModel? _schema;
    private ManagementCapabilities? _capabilities;
    private ManagementInfo? _info;
    private IReadOnlyList<ManagementRevision> _revisions = [];
    private int _rules;
    private int _roles;
    private AdminProblem? _problem;

    /// <summary>The warned blocks this descriptor declares (§4.2) — see <see cref="DeclaredLimits"/>.</summary>
    private IReadOnlyList<ManagementWarnedBlock> Declared { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _descriptor = await Gateway.DescriptorAsync(CancellationToken.None);
            _schema = await Gateway.SchemaAsync(CancellationToken.None);
            _capabilities = await Gateway.CapabilitiesAsync(CancellationToken.None);
            _info = await Gateway.InfoAsync(CancellationToken.None);
            _revisions = await Gateway.RevisionsAsync(CancellationToken.None);
            Declared = DeclaredLimits.Of(_descriptor.DescriptorJson, _capabilities);
            _rules = DescriptorLens.RuleCount(_descriptor.DescriptorJson);
            _roles = DescriptorLens.DeclaredRoles(_descriptor.DescriptorJson).Count;
        }
        catch (Exception exception)
        {
            _problem = AdminProblem.From(exception, Logger);
        }
    }

    /// <summary>How this instance runs, as one line an operator reads rather than three raw values.</summary>
    /// <remarks>
    /// A mode this build does not name is shown as reported rather than hidden, so a future value
    /// reads as itself instead of as the nearest one this switch happens to know.
    /// </remarks>
    private static string Runtime(ManagementInfo info)
    {
        var mode = info.Mode.Length > 0
            ? string.Concat(info.Mode[..1].ToUpperInvariant(), info.Mode[1..])
            : info.Mode;

        var startup = info.StartupMode switch
        {
            "apply" => "applies on start",
            "verify" => "verifies on start",
            "skip" => "leaves the schema alone on start",
            var other => $"starts in {other} mode",
        };

        return $"{mode} · {startup}";
    }

    /// <summary>A count with its noun, singular or plural.</summary>
    private static string Count(int count, string one, string many)
        => $"{count.ToString(CultureInfo.InvariantCulture)} {(count == 1 ? one : many)}";
}
