@page "/admin/set-password"
@layout SignInLayout
@* Statically rendered, and the form post is why, as on sign-in: see AdminApp.razor. *@
@attribute [ExcludeFromInteractiveRouting]
@* Anonymous by declaration: the person opening this has no session yet, and the cookie re-check skips only a
   static asset and an endpoint that says [AllowAnonymous]. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@*
    Setting a password from a credential token's link (design §1, §2).

    The link carries the address and the token in its fragment, which a browser never sends to the server, to a
    proxy's log or in Referer. admin.js reads the fragment, fills the two boxes, hides the token's box, and removes
    the fragment from the address bar and the history. With JavaScript off both boxes stay on screen and a note says
    to type them in, which works because this is an ordinary form post.

    Native markup, as on sign-in (D10): the library's inputs are interactive components and this page has no
    circuit. The form posts to AlvoAdmin.SetPasswordEndpoint, which the host maps because redeeming a token needs the
    identity package. The endpoint answers with a redirect back here with one of the four states below, or on to
    sign-in: the person then signs in with the new password the usual way (design §2, "Why no automatic sign-in").
*@
<PageTitle>Set your password · Alvo</PageTitle>

<div class="a-stack a-signin">
    <div class="a-brand a-brand--hero">
        <img src="@AlvoAdminAssets.Mark" width="34" height="34" alt="" />
        <span>Alvo</span>
    </div>

    <Panel Title="Set your password" class="a-signin__panel">
        <Subtitle>For the account an administrator created for you. You sign in with it afterwards.</Subtitle>
        <ChildContent>
            @Refusal

            <noscript>
                <p class="a-note">
                    This browser is running no JavaScript, so the link could not fill in your address and token.
                    Type your address, and paste the token your administrator gave you.
                </p>
            </noscript>

            @* data-enhance="false": the answer is a redirect, not a page to patch in (see SignIn.razor). *@
            <form method="post" action="@AlvoAdmin.SetPasswordEndpoint" class="a-stack" data-enhance="false"
                  data-alvo-set-password>
                <AntiforgeryToken />

                <Field Label="Email" For="email">
                    <input class="a-input" id="email" name="email" type="email" autocomplete="username"
                           maxlength="256" required />
                </Field>

                @* Shown until admin.js fills it from the link; the person never needs to see a filled one. *@
                <Field Label="Token" For="token" data-alvo-token-field>
                    <input class="a-input a-mono" id="token" name="token" type="text" autocomplete="off"
                           spellcheck="false" autocapitalize="off" maxlength="2048" required />
                </Field>

                <Field Label="New password" For="password">
                    <ChildContent>
                        <input class="a-input" id="password" name="password" type="password"
                               autocomplete="new-password" minlength="@SetPasswordPolicy.MinimumLength"
                               maxlength="@SetPasswordPolicy.MaximumLength" aria-describedby="password-hint" required />
                    </ChildContent>
                    <Hint>@SetPasswordPolicy.Hint</Hint>
                </Field>

                <Field Label="Repeat it" For="repeat">
                    <input class="a-input" id="repeat" name="repeat" type="password" autocomplete="new-password"
                           minlength="@SetPasswordPolicy.MinimumLength" maxlength="@SetPasswordPolicy.MaximumLength"
                           required />
                </Field>

                <button class="a-btn a-btn--primary" type="submit">Set password</button>
            </form>
        </ChildContent>
    </Panel>
</div>

@* The module that reads the fragment. A module is deferred, so the form above exists when it runs. *@
<script type="module" src="@AlvoAdminAssets.Module"></script>

@code {
    /* The query states are private: a query parameter is a cascading value, so nothing requires it be public, and
       a public one would be one more member of the Razor SDK's accidental public surface (Components.* is not
       contract; see AlvoAdmin). */

    /// <summary>The request being rendered; always present, because this page is only ever rendered statically.</summary>
    [CascadingParameter]
    private HttpContext? Http { get; set; }

    /// <summary>Set by the endpoint when the link was refused, for whichever reason.</summary>
    /// <remarks>
    /// One sentence for an unknown address, a wrong, used or expired token, a disabled person and the bootstrap
    /// administrator: telling them apart would tell a stranger which addresses have accounts.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "failed")]
    private bool Failed { get; set; }

    /// <summary>Set by the endpoint when the password itself was the problem: <c>mismatch</c> or <c>weak</c>.</summary>
    [SupplyParameterFromQuery(Name = "problem")]
    private string? Problem { get; set; }

    /// <summary>Set by the host's credential limiter when this network has used its attempts for the minute.</summary>
    [SupplyParameterFromQuery(Name = "throttled")]
    private bool Throttled { get; set; }

    /// <summary>
    /// Keeps the page out of every cache and its address out of every <c>Referer</c> (design §1).
    /// </summary>
    /// <remarks>
    /// Defence in depth: the fragment is never in a request, and the page loads only same-origin assets today. The
    /// headers stop a future link or asset from leaking the page's address, and a shared cache from keeping it.
    /// </remarks>
    protected override void OnInitialized()
    {
        if (Http is { } http)
        {
            http.Response.Headers.CacheControl = "no-store";
            http.Response.Headers["Referrer-Policy"] = "no-referrer";
        }
    }

    /// <summary>The one refusal the endpoint sent the person back with, if it sent one.</summary>
    private RenderFragment? Refusal => (Throttled, Failed, Problem) switch
    {
        (true, _, _) => Refused("Too many attempts from this network.", "Wait a minute and try again."),
        (_, true, _) => Refused("This link does not work.",
            "It may have been used already, have expired, or been copied incompletely. Ask your administrator for a new one."),
        (_, _, "mismatch") => Refused("The two passwords are not the same.", null),
        (_, _, "weak") => Refused(SetPasswordPolicy.Weak, null),
        _ => null,
    };

    private static RenderFragment Refused(string title, string? fix) => @<ErrorPanel Title="@title" Fix="@fix" />;
}
