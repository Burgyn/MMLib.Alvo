@page "/admin/sign-in"
@layout SignInLayout
@* Statically rendered, and the form post is why — see AdminApp.razor. *@
@attribute [ExcludeFromInteractiveRouting]
@* Anonymous by declaration, not by omission: the cookie re-check skips only a static asset and an endpoint
   that says [AllowAnonymous], so the one screen that works with no session stays up when the store does not. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@*
    Signing in.

    Statically rendered, and it has to be: signing in writes an authentication cookie, a cookie is
    written onto a response, and a server-interactive component runs over a WebSocket long after
    that response completed. So this is an ordinary form posting to an ordinary endpoint — which is
    how every Blazor application does it, and which also means it works with JavaScript off.

    The endpoint is the host's, because it needs ASP.NET Core Identity's SignInManager and this
    package holds no reference to it. `AlvoAdmin.SignInEndpoint` is the one spelling of the path.
*@
<PageTitle>Sign in · Alvo</PageTitle>

<div class="a-stack a-signin">
    @* The mark and the name set in the page's own type, rather than the wordmark SVG: that file
       draws "Alvo" with `fill="currentColor"`, and an SVG loaded through <img> has no page to take
       a colour from — it would resolve to black and disappear in the dark theme. The wordmark is
       still published for a host that wants it on a light surface. *@
    <div class="a-brand a-brand--hero">
        <img src="@AlvoAdminAssets.Mark" width="34" height="34" alt="" />
        <span>Alvo</span>
    </div>

    <Panel Title="Sign in" class="a-signin__panel">
        <Subtitle>The administrator this host was configured with, or an account they created.</Subtitle>
        <ChildContent>
            @if (PasswordSet)
            {
                <AlvoAlert Tone="AlvoAlert.AlertTone.Success" TestId="sign-in-password-set">
                    Your password is set. Sign in with it.
                </AlvoAlert>
            }

            @if (Throttled)
            {
                <ErrorPanel Title="Too many attempts from this network." Fix="Wait a minute and try again." />
            }
            else if (Failed)
            {
                <ErrorPanel Title="That email and password do not match"
                            Fix="If this is a new deployment, the account is the one named by Alvo:Admin:BootstrapEmail, with the password in the file Alvo:Admin:BootstrapPasswordFile points at." />
            }

            @* data-enhance="false" — a real browser form post, not an enhanced one.

               Blazor's enhanced form handling posts through fetch and patches the DOM with the
               response. That is right for a form whose answer is a page; it is wrong for this one,
               whose answer is a Set-Cookie and a redirect: the cookie arrives, the redirect is applied
               as a DOM patch, and the operator is left looking at the sign-in screen they just
               completed. Opting out makes the browser navigate, which is what an authentication
               handshake needs. *@
            <form method="post" action="@AlvoAdmin.SignInEndpoint" class="a-stack" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <Field Label="Email" For="email">
                    <input class="a-input" id="email" name="email" type="email" autocomplete="username"
                           required autofocus />
                </Field>

                <Field Label="Password" For="password">
                    <input class="a-input" id="password" name="password" type="password"
                           autocomplete="current-password" required />
                </Field>

                <button class="a-btn a-btn--primary" type="submit">Sign in</button>
            </form>
        </ChildContent>
    </Panel>
</div>

@code {
    /// <summary>Set by the endpoint when the credentials did not match.</summary>
    /// <remarks>
    /// One message for a wrong email and a wrong password, deliberately: telling them apart tells
    /// an attacker which addresses have accounts.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "failed")]
    public bool Failed { get; set; }

    /// <summary>Where to go after signing in.</summary>
    /// <remarks>
    /// Carried through the form so a deep link survives the sign-in. The endpoint refuses anything
    /// that is not a local path — an open redirect is how a sign-in page becomes a phishing page.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>Set by the set-password endpoint once the person's new password is stored.</summary>
    /// <remarks>
    /// The person signs in with it here rather than being signed in by the endpoint: a password typed once more
    /// is a password the browser saved correctly, and an intercepted link stays a password link, never a session.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "passwordSet")]
    private bool PasswordSet { get; set; }

    /// <summary>Set by the host's credential limiter, which sign-in shares with the set-password page.</summary>
    [SupplyParameterFromQuery(Name = "throttled")]
    private bool Throttled { get; set; }
}
