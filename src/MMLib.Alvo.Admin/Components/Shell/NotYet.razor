@page "/admin/functions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ManagementGateway Gateway

@*
    A section that is declared and does not run.

    Design §4.1: a WARNED subsystem and a REFUSED feature are two different states and must not
    look alike. This is the warned one — the descriptor may declare it, the apply accepts it, and
    nothing happens. The consequence is served verbatim from `capabilities`, never reworded here:
    it is the framework's own sentence, and a second wording is a third spelling of one truth.
*@
<PageTitle>@Title · Alvo</PageTitle>

<div class="a-stack">
    <PageHeader Title="@Title" />

    @if (_warning is { } warning)
    {
        <NotYetPanel Title="Not yet" Consequence="@warning.Consequence" data-testid="not-yet-warned">
            <Subtitle>
                This build parses <code class="a-mono">@warning.Block</code> and honours it nowhere.
                A descriptor that declares it applies cleanly; nothing runs.
            </Subtitle>
        </NotYetPanel>
    }
    else if (_capabilities is not null)
    {
        <NotYetPanel Title="Not yet" data-testid="not-yet-unknown">
            <Subtitle>
                This build does not report <code class="a-mono">@Block</code> among the blocks it
                warns about, which means it is not part of the descriptor at all yet.
            </Subtitle>
        </NotYetPanel>
    }
    else
    {
        <Skeleton />
    }

    @foreach (var refusal in RefusalPlaces.On(RefusalScreen.Functions, _capabilities?.Refused ?? []))
    {
        <Refusal data-testid="@($"refused-{refusal.Slot}")">
            <code class="a-mono">@refusal.Slot</code> — @refusal.Consequence @refusal.Fix
        </Refusal>
    }

    <Panel Padded="true">
        <span class="a-section__title">What is here instead</span>
        <p class="a-section__sub">@Alternative</p>
    </Panel>
</div>

@code {
    private const string Title = "Functions";

    @* The build's own block name (UnhonouredSubsystems.cs). Automations left this page when HX-15 made the block run. *@
    private const string Block = "functions";

    private const string Alternative =
        "A host function registered with AddFunction appears in an entity's hooks editor, under an after-hook's 'function' action, with a form for its input.";

    private ManagementCapabilities? _capabilities;
    private ManagementWarnedBlock? _warning;

    protected override async Task OnParametersSetAsync()
    {
        _capabilities = await Gateway.CapabilitiesAsync(CancellationToken.None);
        _warning = _capabilities.Warned.FirstOrDefault(
            block => string.Equals(block.Block, Block, StringComparison.Ordinal));
    }
}
