@*
    One overlay, two shapes: a sheet that rises from the bottom edge on a phone, a centred
    dialog on a desktop. One component rather than two, for the reason the shell itself gives
    about navigation — a second implementation is a second set of behaviours to keep in step,
    and the behaviours here (scrim, Escape, focus, scroll lock) are the part nobody notices
    until one of them is missing.

    It is a modal: the scrim closes it, Escape closes it, and the panel stops the click that
    would otherwise reach the scrim underneath.
*@
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (Open)
{
    <div class="a-scrim a-sheet" @onclick="CloseAsync" data-testid="@TestId">
        <div class="a-sheet__panel" role="dialog" aria-modal="true" aria-label="@Title"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync" @ref="_panel" tabindex="-1">
            <div class="a-sheet__grip" aria-hidden="true"></div>

            <div class="a-sheet__head">
                <div class="a-section" style="gap:2px">
                    <span class="a-section-title">@Title</span>
                    @if (Subtitle is { Length: > 0 })
                    {
                        <span class="a-section-sub">@Subtitle</span>
                    }
                </div>
                <button type="button" class="a-btn a-btn--ghost a-btn--sm a-sheet__close"
                        data-testid="sheet-close" aria-label="Close" @onclick="CloseAsync">Close</button>
            </div>

            <div class="a-sheet__body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _panel;
    private bool _locked;

    /// <summary>Whether the sheet is on the page at all.</summary>
    /// <remarks>
    /// Closed means <em>absent</em>, not hidden: a form left in the DOM keeps its values, its
    /// validation state and its focusability, and the next caller would open somebody else's
    /// half-typed record.
    /// </remarks>
    [Parameter]
    public bool Open { get; set; }

    /// <summary>What the sheet is for, read out as the dialog's label.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>One line under the title, or nothing.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Raised when the operator dismisses it — the scrim, Escape, or the close control.</summary>
    /// <remarks>
    /// Dismissal is the caller's to interpret: this component never decides that closing discards
    /// an edit, because on one screen it does and on another it does not.
    /// </remarks>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>What the sheet holds.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The handle a scenario opens and closes it by.</summary>
    [Parameter]
    public string TestId { get; set; } = "sheet";

    /// <summary>
    /// Takes focus and stops the page behind from scrolling, each time it opens.
    /// </summary>
    /// <remarks>
    /// <b>The scroll lock is what makes a bottom sheet feel like one.</b> Without it a drag near
    /// the panel's edge scrolls the list underneath, and the sheet appears to float over a page
    /// that is still moving. Focus moves to the panel so the first Tab lands inside the dialog
    /// rather than on whatever the operator last touched behind it.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open && !_locked)
        {
            _locked = true;
            await LockAsync(true);
            await _panel.FocusAsync();
        }
        else if (!Open && _locked)
        {
            _locked = false;
            await LockAsync(false);
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    /// <summary>
    /// Holds or releases the page behind the sheet.
    /// </summary>
    /// <remarks>
    /// Guarded because a circuit can be disposed mid-call — a reload, a navigation, a dropped
    /// connection — and a JS call on a dead circuit throws where nobody can act on it.
    /// </remarks>
    private async Task LockAsync(bool locked)
    {
        try
        {
            await Js.InvokeVoidAsync("alvo.lockScroll", locked);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_locked)
        {
            _locked = false;
            await LockAsync(false);
        }
    }
}
