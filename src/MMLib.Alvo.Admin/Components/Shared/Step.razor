@*
    One step of the first run, reporting its own state.
*@
<div class="a-panel" style="padding:var(--space-5)">
    <div class="a-row" style="gap:var(--space-3);align-items:flex-start">
        <span class="@($"a-badge {(Done ? "a-badge--ok" : "a-badge--warn")}")" style="flex:none">
            @(Done ? "done" : "to do")
        </span>
        <span style="flex:1;min-width:0">
            <span style="font-size:var(--text-base);font-weight:var(--weight-medium)">@Title</span>
            <p class="a-section-sub" style="margin-top:var(--space-2)">@ChildContent</p>
        </span>
    </div>
</div>

@code {
    /// <summary>Whether the project is already in this state.</summary>
    [Parameter]
    public bool Done { get; set; }

    /// <summary>What the step is.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Why it matters, and what to do about it.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
