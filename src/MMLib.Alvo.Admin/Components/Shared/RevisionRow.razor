@*
    One entry of the append-only configuration history.

    Author and reason are shown even when absent, as "not recorded" rather than blank: a revision
    with no author is a code-first or system apply, and that is information rather than a gap.
*@
<div class="a-row" style="align-items:flex-start;padding:var(--space-4);gap:var(--space-4)">
    <span class="a-badge a-badge--accent" style="flex:none">r@(Revision.Revision)</span>
    <span style="flex:1;min-width:0">
        <span style="font-size:var(--text-sm);font-weight:var(--weight-medium)">
            @(Revision.Reason ?? "No reason recorded")
        </span>
        <span class="a-switcher-meta">
            @(Revision.Author ?? "code-first or system") ·
            @Revision.CreatedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
            @if (Revision.RolledBackFrom is { } from)
            {
                <text> · restored r@(from)</text>
            }
        </span>
    </span>
</div>

@code {
    /// <summary>The revision to render.</summary>
    [Parameter, EditorRequired]
    public ManagementRevision Revision { get; set; } = default!;
}
