@*
    One entry of the append-only configuration history.

    Author and reason are shown even when absent, as "not recorded" rather than blank: a revision
    with no author is a code-first or system apply, and that is information rather than a gap. The
    one exception is the initial descriptor, which RevisionHistory names for what it is.
*@
<div class="a-revision" data-testid="revision-row">
    <span class="a-badge a-badge--accent a-badge--rev">r@(Revision.Revision)</span>
    <span class="a-item">
        <span class="a-item__title">
            @RevisionHistory.Title(Revision)
        </span>
        <span class="a-meta">
            @if (RevisionHistory.Author(Revision) is { } author)
            {
                <text>@author · </text>
            }
            @Revision.CreatedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
            @if (Revision.RolledBackFrom is { } from)
            {
                <text> · restored r@(from)</text>
            }
        </span>
    </span>
</div>

@code {
    /// <summary>The revision to render.</summary>
    [Parameter, EditorRequired]
    public ManagementRevision Revision { get; set; } = default!;
}
