@*
    Sends an unauthorized visitor to the sign-in screen, carrying where they were going.

    Why a component rather than a line in the router: `NotAuthorized` is a render fragment, and a
    fragment cannot inject `NavigationManager` or run a side effect at the right moment. This runs
    the redirect in `OnInitialized`, which is once per navigation rather than once per render pass
    — a redirect issued from markup would re-fire on every re-render.

    The return URL is the address the visitor asked for, so signing in lands them where they meant
    to go. `AlvoAdminSignIn` refuses an absolute or protocol-relative one — an open redirect is how
    a sign-in page becomes a phishing page — so what travels here is only ever a local path.
*@
@inject NavigationManager Navigation

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var target = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnUrl = "/" + target.TrimStart('/');

        Navigation.NavigateTo(
            $"{AlvoAdmin.SignInPath}?returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: false,
            replace: true);
    }
}
