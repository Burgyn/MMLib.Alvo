<Project>
  <!-- The typed-entity generator in analyzers/dotnet/cs reads these: which AdditionalFiles are Alvo descriptors, the namespace to generate into, and the project's root namespace. -->
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AlvoDescriptor" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AlvoNamespace" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>
</Project>
