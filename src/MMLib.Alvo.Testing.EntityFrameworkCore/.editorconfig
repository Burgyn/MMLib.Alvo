# AlvoSqlDialectContractTests is xUnit test code even though it lives in src/, not test/ —
# it is inherited by every IAlvoSqlDialect implementation's own test project, so its
# [Fact]/[Theory] methods follow the same descriptive snake_case convention as
# test/.editorconfig, for the same reason src/MMLib.Alvo.Testing/Data/.editorconfig does for
# the data suites. Scoped to that file, not the whole project, so TSqlSqlDialect still gets
# the normal naming rule.

[AlvoSqlDialectContractTests.cs]
dotnet_diagnostic.CA1707.severity = none
