#!/usr/bin/env bash
# Tests for scripts/assert-mutation-run — the guard that decides whether a finished
# Stryker run actually measured what its config asked for.
#
# Run: scripts/test-assert-mutation-run
#
# WHY THIS EXISTS. The guard's whole job is "do not trust a green signal", so a guard
# nobody tests is the same shape as the defects it was written for. Its first version
# was a negative `grep -q 'will mutate solution'` that would have failed OPEN on any
# Stryker rewording; the positive assertions that replaced it are only worth something
# if the fail-closed behaviour is still there after the next edit. That is what the
# "reworded" cases below pin.
#
# Fixtures are REAL Stryker output, captured from both working directories and
# committed under scripts/fixtures/mutation-logs/*.txt with provenance headers. They are the
# only way to exercise the branch that catches a genuine regression: the data-ef pair
# is the shard that ran in 10 minutes and then timed out with no config change, and the
# expressions pair is the case that documents why the guard asserts the TEST-PROJECT
# count rather than the mutant count (identical 834 mutants in both modes).
#
# Perturbations — a reworded log line, a collapsed mutant count, ordinary drift — are
# derived from a fixture HERE, with sed, rather than committed as extra files, so that
# every committed fixture stays real captured output and each perturbation is visible
# as the one-line change it is.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GUARD="$ROOT/scripts/assert-mutation-run"
FIXTURES="$ROOT/scripts/fixtures/mutation-logs"
TMP_ROOT="$(mktemp -d)"
trap 'rm -rf "$TMP_ROOT"' EXIT

PASS=0
FAIL=0

pass() { PASS=$((PASS + 1)); printf '  ok   %s\n' "$1"; }
fail() {
  FAIL=$((FAIL + 1))
  printf '  FAIL %s\n' "$1"
  printf '       expected: %s\n' "$2"
  printf '       actual:   %s\n' "$3"
}

# Every case is the same shape: run the guard, assert the exit status, and for a
# failure assert WHICH check tripped — otherwise a guard that fails for the wrong
# reason (or for an unrelated crash) would still look like a pass here.
GUARD_OUT=""
run_guard() { # <log> <config> <expected-mutants> <expected-tests>
  GUARD_OUT="$("$GUARD" "$1" "$2" "$3" "$4" "test-shard" 2>&1)"
  return $?
}

assert_ok() { # <label> <log> <config> <expected-mutants> <expected-tests>
  local label="$1"; shift
  if run_guard "$@"; then
    pass "$label"
  else
    fail "$label" "exit 0 (guard accepts the run)" "exit non-zero: $GUARD_OUT"
  fi
}

assert_rejected() { # <label> <needle proving which check tripped> <log> <config> <expected-mutants> <expected-tests>
  local label="$1" needle="$2"; shift 2
  if run_guard "$@"; then
    fail "$label" "non-zero exit (guard rejects the run)" "exit 0: $GUARD_OUT"
    return
  fi
  case "$GUARD_OUT" in
    *"$needle"*) pass "$label" ;;
    *) fail "$label" "rejection mentioning '$needle'" "$GUARD_OUT" ;;
  esac
}

# Check 5 needs the 6th argument, so it gets its own runner rather than overloading the
# four-argument one — a default-on canary flag would silently apply the check to every
# other case's fixture, which has no summary block at all.
run_canary() { # <log> <config> <expected-mutants> <expected-tests>
  GUARD_OUT="$("$GUARD" "$1" "$2" "$3" "$4" "canary" "canary" 2>&1)"
  return $?
}

assert_canary_ok() { # <label> <log> <config> <expected-mutants> <expected-tests>
  local label="$1"; shift
  if run_canary "$@"; then
    pass "$label"
  else
    fail "$label" "exit 0 (guard accepts an honest canary)" "exit non-zero: $GUARD_OUT"
  fi
}

assert_canary_rejected() { # <label> <needle> <log> <config> <expected-mutants> <expected-tests>
  local label="$1" needle="$2"; shift 2
  if run_canary "$@"; then
    fail "$label" "non-zero exit (guard rejects a lying canary)" "exit 0: $GUARD_OUT"
    return
  fi
  case "$GUARD_OUT" in
    *"$needle"*) pass "$label" ;;
    *) fail "$label" "rejection mentioning '$needle'" "$GUARD_OUT" ;;
  esac
}

# Rejection fingerprints, one per check, so a case cannot pass by tripping the wrong one.
VACUOUS="tested zero mutants"
WRONG_SUITE="expected Stryker to analyse exactly"
NO_MUTANT_LINE="never reports 'N total mutants will be tested'"
COLLAPSED="A collapse this size is not ordinary drift"
NO_TEST_PROJECTS="declares no test-projects"
NO_LOG="no Stryker log at"
CANARY_KILLED="the CANARY reported"
CANARY_NO_KILLED_LINE="never reports 'Killed: N'"
CANARY_NO_SURVIVED_LINE="never reports 'Survived: N'"
CANARY_SHORT="reports only"
CANARY_BAD_ARG="must be the word 'canary' or absent"

# A perturbation that silently matches nothing would leave the fixture untouched, and
# the `assert_ok` drift/growth cases would then pass against an UNCHANGED fixture —
# green for the wrong reason. So refuse to produce a copy identical to its source.
#
# The result comes back in DERIVED, not on stdout, and a no-op RETURNS non-zero rather
# than calling `exit`. Both matter. The first version printed the path and was invoked
# inside a command substitution — but `exit` there only leaves the SUBSHELL, so the suite
# carried on with an empty path, the guard tripped its own usage check, and the case went
# red for entirely the wrong reason while the comment promised an abort that never
# happened. A check that looks like it works is this branch's own subject matter. The
# contract is now `derive ... || exit 1` on its own line at every call site, which the
# "derive aborts" cases below verify both behaviourally and structurally.
DERIVED=""
derive() { # <fixture> <sed-expression> -> sets DERIVED; non-zero if sed changed nothing
  local out
  out="$(mktemp "$TMP_ROOT/derived.XXXXXX")"
  command sed "$2" "$FIXTURES/$1" > "$out"
  if cmp -s "$FIXTURES/$1" "$out"; then
    DERIVED=""
    printf 'derive: sed %s matched nothing in %s — the case it feeds would prove nothing\n' \
      "$2" "$1" >&2
    return 1
  fi
  DERIVED="$out"
}

EXPR_CFG="$ROOT/stryker-config.expressions.json"
EF_CFG="$ROOT/stryker-config.data-ef.json"

[ -x "$GUARD" ] || { printf 'guard not executable: %s\n' "$GUARD"; exit 1; }

# ============================================== the suite is the configured one
# Check 2. Real logs, both working directories, for two different shards.

echo "check 2 — the run used the test projects the config declares"

assert_ok "scoped run (expressions, 1 project, 722 tests) is accepted" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 834 722

assert_rejected "solution mode (expressions, 2211 tests) is rejected" "$WRONG_SUITE" \
  "$FIXTURES/expressions-solution-mode.txt" "$EXPR_CFG" 834 722

# The pair above is the whole argument for check 2 being the test-project count: both
# logs report 834 mutants tested, so no assertion on the mutant count could separate
# them. Pin that premise rather than trusting the comment.
for f in expressions-scoped expressions-solution-mode; do
  tested="$(tr '\r' '\n' < "$FIXTURES/$f.txt" \
    | command grep -oE '[0-9]+[[:space:]]+total mutants will be tested' \
    | command grep -oE '^[0-9]+' | head -1)"
  if [ "$tested" = "834" ]; then
    pass "$f reports 834 mutants (a mutant-count check could not tell the modes apart)"
  else
    fail "$f reports 834 mutants" "834" "$tested"
  fi
done

assert_ok "scoped run (data-ef, 2 projects, 858 tests) is accepted" \
  "$FIXTURES/data-ef-scoped.txt" "$EF_CFG" 596 858

assert_rejected "solution mode (data-ef, 1489 tests) is rejected — the real regression" "$WRONG_SUITE" \
  "$FIXTURES/data-ef-solution-mode.txt" "$EF_CFG" 596 858

# The rejection has to be actionable, so it must quote the inflated suite it saw.
if run_guard "$FIXTURES/data-ef-solution-mode.txt" "$EF_CFG" 596 858; then
  fail "data-ef rejection names the inflated test count" "non-zero exit" "exit 0"
else
  case "$GUARD_OUT" in
    *"1489"*) pass "data-ef rejection names the inflated test count (1489)" ;;
    *) fail "data-ef rejection names the inflated test count (1489)" "message containing 1489" "$GUARD_OUT" ;;
  esac
fi

# ==================================================================== fail-closed
# The property the original negative grep did not have: a line that stops matching
# because a Stryker release reworded it must FAIL, never silently pass.

echo "fail-closed — a reworded Stryker log line must not disarm a check"

derive expressions-scoped.txt 's/Analyzing 1 test project(s)./Resolved 1 test project for mutation./' || exit 1
assert_rejected "reworded 'Analyzing N test project(s).' is rejected" "$WRONG_SUITE" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

derive expressions-scoped.txt 's/834   total mutants will be tested/834   mutants queued for testing/' || exit 1
assert_rejected "reworded 'N total mutants will be tested' is rejected" "$NO_MUTANT_LINE" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

# ================================================================ oversized log
# THE case that the 3-5 KB fixtures cannot express, and the reason it is here: the guard
# used to match with `printf '%s\n' "$text" | grep -q PATTERN`, which under
# `set -o pipefail` returns 141 — not 0 — whenever grep matches early and exits while
# printf is still writing. Every fixture fits the 64 KiB pipe buffer, so the suite was
# green while the guard would have rejected all five shards on the first real run,
# reporting that the log did not contain a line it quoted back in the same message.
# A real Stryker log is hundreds of KB with "Analyzing N test project(s)." near the top.

echo "oversized log — the pipe-buffer trap that small fixtures cannot show"

big="$(mktemp "$TMP_ROOT/big.XXXXXX")"
{
  cat "$FIXTURES/expressions-scoped.txt"
  # Progress output, which is what makes a real log large and lands AFTER discovery.
  i=0
  while [ "$i" -lt 6000 ]; do
    echo "[00:00:00 INF] progress noise line $i emitted after discovery, as a real run does"
    i=$((i + 1))
  done
} > "$big"

big_bytes="$(command wc -c < "$big" | tr -d ' ')"
if [ "$big_bytes" -gt 65536 ]; then
  pass "the oversized fixture exceeds one pipe buffer ($big_bytes bytes)"
else
  fail "the oversized fixture exceeds one pipe buffer" ">65536 bytes" "$big_bytes"
fi

assert_ok "a scoped run in a >64 KiB log is still accepted" \
  "$big" "$EXPR_CFG" 834 722

# =========================================================================== vacuity
# Check 1, kept from the original workflow step: a run that measured nothing.

echo "check 1 — a run that tested nothing is not a passing run"

assert_rejected "a run that tested no mutants is rejected" "$VACUOUS" \
  "$FIXTURES/vacuous-run.txt" "$EXPR_CFG" 834 722

# The vacuous fixture trips two of check 1's alternatives at once. Strip the
# "unable to calculate a mutation score" line so the ZERO-MUTANT alternative has to
# fire on its own — it is the one that was written as `0 total mutants will be tested`,
# with a single space, and could therefore never match Stryker's column-padded
# "0     total mutants will be tested". A dead alternative inside a live check is
# invisible until the live one stops applying.
derive vacuous-run.txt '/unable to calculate a mutation score/d' || exit 1
assert_rejected "a zero-mutant run is rejected on the count alone (padded columns)" "$VACUOUS" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

# ============================================================== mutant-count floor
# Check 3, for the failure a count CAN catch: a mutate glob that stops matching
# reports a collapsed count rather than zero, which check 1 waves through.

echo "check 3 — the mutate glob still matches (one-sided floor at 60%)"

derive expressions-scoped.txt 's/834   total mutants will be tested/400   total mutants will be tested/' || exit 1
assert_rejected "a collapse to 400 of 834 (floor 500) is rejected" "$COLLAPSED" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

derive expressions-scoped.txt 's/834   total mutants will be tested/800   total mutants will be tested/' || exit 1
assert_ok "ordinary drift down to 800 of 834 is accepted" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

derive expressions-scoped.txt 's/834   total mutants will be tested/1200  total mutants will be tested/' || exit 1
assert_ok "growth to 1200 of 834 is accepted (the floor is one-sided on purpose)" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

# ================================================================ suite-size floor
# Check 4. Check 2 catches the suite being SUBSTITUTED (solution mode inflates it);
# this catches it being GUTTED — "the adversarial suite stopped biting", the failure
# mutation testing exists for. Deleting half the tests leaves the project count and the
# mutant count untouched, so checks 1-3 all pass, and per #142 the score cannot be
# relied on either.

echo "check 4 — the suite did not shrink (one-sided floor at 60%)"

derive expressions-scoped.txt 's/Number of tests found: 722/Number of tests found: 300/' || exit 1
assert_rejected "a suite gutted from 722 to 300 tests is rejected" "lost two fifths of its tests" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

derive expressions-scoped.txt 's/Number of tests found: 722/Number of tests found: 700/' || exit 1
assert_ok "ordinary test-count drift 722 -> 700 is accepted" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

derive expressions-scoped.txt 's/Number of tests found: 722/Number of tests found: 1500/' || exit 1
assert_ok "a grown suite 722 -> 1500 is accepted (adding tests is never the bug)" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

derive expressions-scoped.txt 's/Number of tests found: 722/Discovered 722 tests/' || exit 1
assert_rejected "a reworded 'Number of tests found' is rejected" "size of the suite behind this verdict is unknown" \
  "$DERIVED" \
  "$EXPR_CFG" 834 722

# ===================================================================== bad inputs
# A guard that cannot read its own inputs must say so rather than wave the run
# through — these are the paths where "no evidence" could be mistaken for "no problem".

echo "inputs — missing or unusable inputs fail rather than pass"

assert_rejected "a missing log is rejected" "$NO_LOG" \
  "$TMP_ROOT/does-not-exist.txt" "$EXPR_CFG" 834 722

no_tp_cfg="$TMP_ROOT/no-test-projects.json"
jq 'del(.["stryker-config"]["test-projects"])' "$EXPR_CFG" > "$no_tp_cfg"
assert_rejected "a config declaring no test-projects is rejected" "$NO_TEST_PROJECTS" \
  "$FIXTURES/expressions-scoped.txt" "$no_tp_cfg" 834 722

# A non-numeric calibration figure reaches `$(( ))`, which trips `set -u` — and on
# bash 3.2 the script then exits 0, i.e. the guard fails OPEN on a typo in the matrix.
assert_rejected "a non-numeric mutant count is rejected, not silently accepted" "must be a whole number" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" "eight-hundred" 722

assert_rejected "a non-numeric test count is rejected, not silently accepted" "must be a whole number" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 834 "seven-twenty-two"

# `$(( 0834 ))` is octal in bash: a leading zero either computes a silently wrong floor
# (010 -> 8) or aborts on a digit >= 8. Neither may pass as a calibration figure.
assert_rejected "a leading-zero mutant count is rejected (bash reads it as octal)" "leading zero" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 0834 722

assert_rejected "a leading-zero test count is rejected (bash reads it as octal)" "leading zero" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 834 0722

# 010 would quietly become 8 rather than erroring, which is the dangerous direction: a
# floor of 8 accepts almost anything.
assert_rejected "a leading zero with only octal digits is still rejected" "leading zero" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 010 722

# A zero floor is a check that cannot fail, so it must not be accepted either.
assert_rejected "a zero calibration figure is rejected" "leading zero" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 0 722

# ================================================================== derive aborts
# The harness's own fail-open path. `derive` used to `exit 1` from inside a command
# substitution, which leaves only the subshell: the suite continued, an empty path
# reached the guard, and the case went red on the guard's usage check instead of on the
# no-op it was meant to catch — red for the wrong reason, with a comment claiming an
# abort that never ran. Two assertions, because the behaviour and the calling convention
# can each regress on their own.

echo "derive — a perturbation that changes nothing aborts the suite"

# Behavioural: a no-op sed must report failure and leave no path behind.
if derive expressions-scoped.txt 's/no such text anywhere in this fixture/x/' 2>/dev/null; then
  fail "derive returns non-zero when its sed matches nothing" "non-zero return" "returned 0"
elif [ -n "$DERIVED" ]; then
  fail "derive returns non-zero when its sed matches nothing" "empty DERIVED" "DERIVED=$DERIVED"
else
  pass "derive returns non-zero and clears DERIVED when its sed matches nothing"
fi

# Structural: every call site must propagate it. Re-wrapping one in a command
# substitution would silently restore the subshell, and no behavioural test can see that
# from in here. Matching on `derive <fixture>.txt` keeps this from matching its own
# source: the pattern text below is not itself a fixture name.
offenders=""
while IFS= read -r line; do
  case "$line" in
    *:'#'*) continue ;;                       # a comment mentioning a call
    *:derive\ *"|| exit 1") continue ;;       # the required hoisted form
    *:if\ derive\ *) continue ;;              # the behavioural probe just above
    '') continue ;;
    *) offenders="$offenders
    $line" ;;
  esac
done <<EOF
$(command grep -nE 'derive [a-z-]+\.txt ' "$0")
EOF

if [ -n "$offenders" ]; then
  fail "every derive call site propagates the abort" \
    "each one 'derive ... || exit 1' on its own line" "$offenders"
else
  hoisted="$(command grep -cE '^derive [a-z-]+\.txt .* \|\| exit 1$' "$0")"
  if [ "$hoisted" -gt 0 ]; then
    pass "all $hoisted derive call sites are 'derive ... || exit 1', so the abort propagates"
  else
    fail "derive call sites propagate failure" "at least one 'derive ... || exit 1'" "none found"
  fi
fi

# End to end: a copy of this suite with one perturbation neutered must ABORT, not carry
# on to the summary line. This is the assertion the original could not make.
neutered="$TMP_ROOT/neutered.sh"
command sed "s|'/unable to calculate a mutation score/d'|'/no such line/d'|" "$0" > "$neutered"
chmod +x "$neutered"
if "$neutered" >"$TMP_ROOT/neutered.out" 2>&1; then
  fail "a neutered perturbation aborts the whole suite" "non-zero exit" "exit 0"
elif command grep -q 'passed, .* failed' "$TMP_ROOT/neutered.out"; then
  fail "a neutered perturbation aborts the whole suite" \
    "abort before the summary" "reached the summary: $(command tail -1 "$TMP_ROOT/neutered.out")"
else
  pass "a neutered perturbation aborts the whole suite before it can report a result"
fi

# ======================================================================= provenance
# Fixtures are evidence; evidence without provenance is decoration. Every one has to
# say what produced it, when, and at which commit (the discipline of
# docs/superpowers/specs/evidence/).

echo "fixtures — each carries its provenance"

# These fixtures are captured console output committed to a PUBLIC repository, and
# Stryker echoes absolute paths — the worktree root, and the --output directory as a
# file:// URL in the report footer, console-wrapped across several lines. One of those
# footers shipped a local path containing the maintainer's OS username and worktree
# layout while the file's own header claimed such paths had been replaced by /repo. A
# capture is only as safe as the last person who remembered to scrub it, so assert it
# instead of remembering.
for f in "$FIXTURES"/*.txt; do
  name="$(basename "$f")"
  if leaked="$(command grep -nE '/Users/|/home/[a-z]|/private/tmp|C:\\\\Users' "$f")"; then
    fail "$name contains no machine-specific absolute path" \
      "every path scrubbed to /repo" "$leaked"
  else
    pass "$name leaks no machine-specific absolute path"
  fi
done

for f in "$FIXTURES"/*.txt; do
  name="$(basename "$f")"
  head_text="$(command head -20 "$f")"
  missing=""
  case "$head_text" in *"Produced by:"*) ;; *) missing="$missing Produced-by" ;; esac
  case "$head_text" in *"Captured:"*) ;; *) missing="$missing Captured" ;; esac
  case "$head_text" in *"Stryker 4.16.0"*) ;; *) missing="$missing Stryker-version" ;; esac
  if [ -z "$missing" ]; then
    pass "$name states how, when and on what it was captured"
  else
    fail "$name states how, when and on what it was captured" "all present" "missing:$missing"
  fi
done

# Stryker's progress reporter emits \r, so the guard normalises with `tr` before
# matching. That path is only exercised while a fixture still CONTAINS a carriage
# return — and `scripts/** text eol=lf` in .gitattributes would strip them if the
# `-text` override for this directory were ever dropped. Assert the bytes rather than
# trusting the attribute, because a fixture quietly losing what it was capturing is
# the same failure as a test quietly stopping.
# Per FILE, not summed: the two data-ef captures contain no \r of their own, so a total
# would stay green while three of five fixtures were silently normalised.
# canary-dishonest.txt is deliberately NOT in this list: it was captured with stdout
# redirected to a file, and Stryker's progress reporter emits its carriage returns only
# to a TTY, so it genuinely has none. That is the shape CI captures too — for carriage
# returns. NOT for colour: see the ANSI assertion below, which is the half of "what CI
# looks like" this comment used to get wrong. The \r handling stays exercised by the
# three above.
for f in expressions-scoped expressions-solution-mode vacuous-run; do
  crs="$(tr -cd '\r' < "$FIXTURES/$f.txt" | command wc -c | tr -d ' ')"
  if [ "$crs" -gt 0 ]; then
    pass "$f.txt still carries $crs carriage returns (the guard's \\r handling stays exercised)"
  else
    fail "$f.txt still carries carriage returns" "at least one" \
      "none — check the scripts/fixtures/mutation-logs/*.txt -text rule in .gitattributes"
  fi
done

# The same argument for the OTHER thing the guard normalises. Three fixtures are now CI
# captures carrying SGR escapes — canary-honest-ci.txt and the two data-ef legs added
# with check 6 — and all three are asserted below. canary-honest-ci.txt came first, because
# Spectre.Console picks colour from the environment rather than from whether stdout is a
# TTY. Strip them to "tidy" the fixture and the ANSI branch of the normalisation stops
# being exercised while every case here stays green — which is exactly how the guard came
# to have no coverage of the shape it meets on every real run.
for f in canary-honest-ci data-ef-core-timeout-inflated data-ef-rest-no-timeouts; do
  ansi="$(command grep -ac $'\x1b\\[' "$FIXTURES/$f.txt" || true)"
  if [ "${ansi:-0}" -gt 0 ]; then
    pass "$f.txt still carries ANSI escapes (the guard's colour handling stays exercised)"
  else
    fail "$f.txt still carries ANSI escapes" "at least one line with \x1b[" "none"
  fi
done

# Specifically the SUMMARY lines, which is the half that matters and the half that was
# missing. check 6 reads `^Timeout:` and `^Killed:`, and on a runner their digits sit
# between SGR escapes (`Timeout:  \e[38;5;13m249\e[0m`) — so a fixture that kept colour
# somewhere in its banner while losing it on the summary would leave the anchors
# untested while every case here stayed green.
for f in data-ef-core-timeout-inflated data-ef-rest-no-timeouts; do
  if command grep -aqE $'^Timeout:[[:space:]]+\x1b\\[' "$FIXTURES/$f.txt"; then
    pass "$f.txt's Timeout: line still carries colour around its digits"
  else
    fail "$f.txt's Timeout: line still carries colour around its digits" \
      "^Timeout: followed by an SGR escape" "plain digits — the ANSI strip is no longer exercised on the line check 6 reads"
  fi
done

# ============ the data-ef configs must stay a partition of the whole shard =========
#
# stryker-config.data-ef.json is read by no matrix leg, but it is NOT orphaned: this
# suite jq's `test-projects` out of it on every PR (ci.yml's `Script suites` job), and
# it is the only config that can adjudicate the blind spot the split creates — "is a
# data-ef-rest survivor real, or did it only survive because Sqlite.Tests was not
# there?". Both roles need it to stay the union of the two legs, and nothing else
# checks that. The rot direction is silent: forgetting to update data-ef-rest.json
# fails a leg loudly, forgetting data-ef.json fails nothing.
#
# The comparison is over the literal mutate LISTS, not over resolved globs — exact,
# and it cannot drift the way a re-implementation of Stryker's glob matching would.
if ! command -v jq >/dev/null 2>&1; then
  fail "the data-ef configs are a partition of the whole shard" "jq on PATH" "jq is not installed"
else
  whole="$(jq -S '.["stryker-config"].mutate' "$ROOT/stryker-config.data-ef.json")"
  core_list="$(jq -S '.["stryker-config"].mutate' "$ROOT/stryker-config.data-ef-core.json")"
  rest_list="$(jq -S '.["stryker-config"].mutate' "$ROOT/stryker-config.data-ef-rest.json")"

  # rest must be exactly the whole shard plus an exclusion for each core entry.
  expected_rest="$(jq -S -n --argjson whole "$whole" --argjson core "$core_list" \
    '$whole + ($core | map("!" + .))' | jq -S '.')"
  if [ "$rest_list" = "$expected_rest" ]; then
    pass "data-ef-rest.json is the whole shard minus exactly the core leg's files"
  else
    fail "data-ef-rest.json is the whole shard minus exactly the core leg's files" \
      "$expected_rest" "$rest_list"
  fi

  # And every core entry must be a file the whole shard actually mutates — an entry
  # naming a file data-ef.json excludes would mutate something the union does not.
  stray="$(jq -r -n --argjson whole "$whole" --argjson core "$core_list" \
    '($whole | map(select(startswith("!")) | ltrimstr("!"))) as $ex
     | $core | map(select(. as $c | $ex | index($c))) | join(", ")')"
  if [ -z "$stray" ]; then
    pass "every data-ef-core.json entry is a file the whole shard mutates, not one it excludes"
  else
    fail "every data-ef-core.json entry is a file the whole shard mutates, not one it excludes" \
      "no overlap with data-ef.json's exclusions" "also excluded there: $stray"
  fi
fi

# ====================================================== check 5 — the canary (#142)
#
# The one check that catches a run which measured the right thing and LIED about the
# result. `canary-dishonest.txt` is a REAL, COMPLETE run of stryker-config.canary.json:
# 13 mutants of InMemoryDescriptorVersionStore against MMLib.Alvo.Abstractions.Tests, a
# suite that mentions neither that class nor DescriptorVersion, so every mutant is
# known-surviving by construction — and Stryker reported 9 Killed. That fixture is the
# finding and the negative case at once.
#
# `canary-honest.txt` is the SAME pairing after the fix in test/_shared/mutation/ (#142):
# 13 mutants, 0 Killed, 13 Survived. It is a capture, not a derivation — until that fix
# landed this repository could not produce an honest canary run at all, and the honest
# case had to be sed-derived from the dishonest log. The two fixtures together are what
# stop check 5 from rotting in either direction: one run it must reject, one it must
# accept, both real.

CANARY_CFG="$ROOT/stryker-config.canary.json"
CANARY_LOG="$FIXTURES/canary-dishonest.txt"
CANARY_HONEST_LOG="$FIXTURES/canary-honest.txt"
CANARY_HONEST_CI_LOG="$FIXTURES/canary-honest-ci.txt"

assert_canary_rejected "a canary reporting kills is rejected, naming the count" "$CANARY_KILLED" \
  "$CANARY_LOG" "$CANARY_CFG" 13 142

# Same fixture, no canary flag: checks 1-4 have nothing to complain about, which is what
# makes the point that no count and no percentage can see this defect.
assert_ok "the same lying run passes checks 1-4 unchanged — the reason check 5 exists" \
  "$CANARY_LOG" "$CANARY_CFG" 13 142

# An honest canary: all 13 survived, none killed. A real run, not a derived one.
assert_canary_ok "an honest canary — 13 tested, 13 survived, 0 killed — is accepted" \
  "$CANARY_HONEST_LOG" "$CANARY_CFG" 13 142

# And it must pass checks 1-4 too: an honest verdict is worth nothing if the run that
# produced it measured the wrong suite.
assert_ok "the honest canary run also measured the right thing (checks 1-4)" \
  "$CANARY_HONEST_LOG" "$CANARY_CFG" 13 142

# THE SAME VERDICT IN CI'S BYTES. Stryker colourises its summary block on a GitHub
# runner and not on a developer machine redirecting to a file, so `Killed: 0` arrives
# wrapped in SGR escapes. Check 5 is the only check that reads that block, which is why
# nothing here caught it until the canary leg entered the matrix and the first CI run
# failed with "never reports 'Killed: N'" on correct numbers. Both captures are real and
# both stay: one per environment, because that is the axis the defect lived on.
assert_canary_ok "an honest canary is accepted through CI's ANSI colour codes" \
  "$CANARY_HONEST_CI_LOG" "$CANARY_CFG" 13 142

assert_ok "the ANSI-coloured CI run also passes checks 1-4" \
  "$CANARY_HONEST_CI_LOG" "$CANARY_CFG" 13 142

# Fail-CLOSED on a missing summary line, both halves. A reworded Stryker summary must
# fail the check rather than read as zero kills, which is the shape checks 1-4 were all
# repaired for once.
derive canary-dishonest.txt '/^Killed:/d' || exit 1
assert_canary_rejected "a canary log with no 'Killed:' line is rejected, not read as zero" \
  "$CANARY_NO_KILLED_LINE" "$DERIVED" "$CANARY_CFG" 13 142

derive canary-dishonest.txt 's/^Killed:    9/Killed:    0/; /^Survived:/d' || exit 1
assert_canary_rejected "a canary log with no 'Survived:' line is rejected" \
  "$CANARY_NO_SURVIVED_LINE" "$DERIVED" "$CANARY_CFG" 13 142

# Zero kills is not sufficient: a mutant that timed out or errored is also a verdict
# this pairing cannot produce honestly, and it would leave survived < tested.
derive canary-dishonest.txt 's/^Killed:    9/Killed:    0/; s/^Survived:  4/Survived:  11/' || exit 1
assert_canary_rejected "zero kills but survived < tested is rejected — a timeout is a verdict too" \
  "$CANARY_SHORT" "$DERIVED" "$CANARY_CFG" 13 142

# A typo'd 6th argument must be refused, not ignored: silently turning check 5 off is
# the defect class it exists for.
GUARD_OUT="$("$GUARD" "$CANARY_LOG" "$CANARY_CFG" 13 142 "canary" "canry" 2>&1)"
if [ $? -eq 0 ]; then
  fail "a typo'd 6th argument is refused rather than ignored" "non-zero exit" "exit 0: $GUARD_OUT"
else
  case "$GUARD_OUT" in
    *"$CANARY_BAD_ARG"*) pass "a typo'd 6th argument is refused rather than ignored" ;;
    *) fail "a typo'd 6th argument is refused rather than ignored" "rejection mentioning the allowed values" "$GUARD_OUT" ;;
  esac
fi

# ============================================ check 6 — the timeout share of a score
#
# Stryker's score is (Killed + Timeout) / tested, so a mutant that merely ran out of
# time lands in the NUMERATOR while its report entry names no killing test at all. The
# two fixtures below are the same commit, the same provider and the same CI run,
# differing only in how many test assemblies the leg pays for — which is what makes
# them a control pair rather than two anecdotes.
echo "check 6 — a score that is mostly timeouts is not a measurement"

CORE_CFG="$ROOT/stryker-config.data-ef-core.json"
REST_CFG="$ROOT/stryker-config.data-ef-rest.json"
TIMEOUT_SHARE="mutants TIMED OUT"
NO_TIMEOUT_LINE="but never 'Timeout: N'"
OCTAL="must not have a leading zero"

assert_rejected "a leg whose pass is 45 % timeouts is rejected" "$TIMEOUT_SHARE" \
  "$FIXTURES/data-ef-core-timeout-inflated.txt" "$CORE_CFG" 543 1135

# The rejection must name the numbers, or nobody reading a red shard can tell this
# check from a low score — which is the distinction the whole message exists to draw.
case "$GUARD_OUT" in
  *"249 of 543"*) pass "the rejection names the counts (249 of 543)" ;;
  *) fail "the rejection names the counts (249 of 543)" "'249 of 543' in the message" "$GUARD_OUT" ;;
esac

# And it must NOT fire on a leg that simply scores badly. data-ef-rest reports 54.51 %
# in this capture — well under its break threshold, whatever that threshold is set to;
# it was 80 when the log was taken and is 83 now that the leg measures 85.82 % — with
# zero timeouts, and this guard has no opinion about that: a low score is the suite's
# problem, an inflated one is the gate's.
assert_ok "a low score with NO timeouts is accepted — check 6 judges the gate, not the suite" \
  "$FIXTURES/data-ef-rest-no-timeouts.txt" "$REST_CFG" 565 554

# One-sided, like checks 3 and 4: fewer timeouts than the ceiling is never the defect.
# The ceiling is integer `tested * 20 / 100`, so for 543 it is floor(108.6) = 108 and the
# effective bound is 19.89 %, not a clean 20 %. The comparison is `-gt`, so 108 passes
# and 109 fails. Stated exactly because "exactly 20 % of 543" is what the first draft of
# this comment claimed, and it is wrong by half a mutant.
#
# The `249` sits BETWEEN SGR escapes in this capture — `Timeout:  \e[38;5;13m249\e[0m` —
# because Spectre.Console colourises on a GitHub runner. Perturbing the digits alone is
# therefore the honest edit: it leaves the colour codes in place, so these cases keep
# exercising the guard's ANSI strip as well as its arithmetic. (The first draft matched
# `^Timeout:  249$`, which matched nothing; `derive` refused it rather than quietly
# feeding an unchanged fixture to a green assertion — which is what that helper is for.)
derive data-ef-core-timeout-inflated.txt 's/\(^Timeout:  .*m\)249/\1108/' || exit 1
assert_ok "exactly at the 20 % ceiling is accepted (the bound is one-sided)" \
  "$DERIVED" "$CORE_CFG" 543 1135

derive data-ef-core-timeout-inflated.txt 's/\(^Timeout:  .*m\)249/\1109/' || exit 1
assert_rejected "one mutant over the ceiling is rejected" "$TIMEOUT_SHARE" \
  "$DERIVED" "$CORE_CFG" 543 1135

# Fail-closed on a rewording, the property every other check here was repaired for:
# once the summary block is present, a missing Timeout line must be refused rather
# than read as zero timeouts.
derive data-ef-core-timeout-inflated.txt '/^Timeout:/d' || exit 1
assert_rejected "a summary with no 'Timeout:' line is refused, not read as zero" "$NO_TIMEOUT_LINE" \
  "$DERIVED" "$CORE_CFG" 543 1135

# But a log with NO summary at all is a discovery probe — started, watched until the
# mutant list prints, killed by hand — and four committed fixtures are exactly that,
# by their own headers. Check 6 must stay silent there instead of failing a legitimate
# capture, which is why it is conditional on the `Killed:` line rather than on nothing.
assert_ok "a discovery probe with no summary block is untouched by check 6" \
  "$FIXTURES/expressions-scoped.txt" "$EXPR_CFG" 834 722

# The canary is exempt: check 5 already asserts every mutant survived, which is
# strictly stronger, and its message diagnoses #142 rather than the timeout threshold.
assert_canary_ok "the canary is exempt from check 6 (check 5 is strictly stronger there)" \
  "$FIXTURES/canary-honest.txt" "$ROOT/stryker-config.canary.json" 13 142

# ...but the case above does NOT pin the exemption, and saying so is the point. The
# honest canary fixture has `Timeout: 0`, so check 6 would pass on it either way —
# deleting the `!= canary` condition from the guard leaves the whole suite green. The
# exemption only becomes observable on a canary that DID time out, which is what this
# derives: check 5 must be the check that speaks, because "every mutant must survive" is
# the stronger statement and its message is the one that diagnoses #142.
derive canary-honest.txt 's/^Survived: 13$/Survived: 10/; s/^Timeout:   0$/Timeout:   3/' || exit 1
assert_canary_rejected "a canary with timeouts is judged by check 5, not check 6" "$CANARY_SHORT" \
  "$DERIVED" "$ROOT/stryker-config.canary.json" 13 142

# The ceiling must be a share of what the run TESTED, not of what the matrix DECLARED.
# The two used to be interchangeable and are not any more: data-ef-core declares 459
# while this capture logs 543, so reading the wrong one moves the ceiling by 17 % and
# nothing else here would notice. 20 % of 543 is 108.6 -> 108, so 109 is over; 20 % of
# 459 is 91, which 109 would also exceed — hence the second case, where the declared
# count is LOWER and a guard reading it would still reject something it must accept.
derive data-ef-core-timeout-inflated.txt 's/\(^Timeout:  .*m\)249/\1109/' || exit 1
assert_rejected "the ceiling follows the TESTED count, not the declared one (109 > 108)" "$TIMEOUT_SHARE" \
  "$DERIVED" "$CORE_CFG" 459 1135

derive data-ef-core-timeout-inflated.txt 's/\(^Timeout:  .*m\)249/\1100/' || exit 1
assert_ok "100 timeouts of 543 tested is accepted even though it exceeds 20 % of the declared 459" \
  "$DERIVED" "$CORE_CFG" 459 1135

# The summary block is the LAST thing a completed run prints, so the guard reads the
# LAST `Timeout:` line. With `head -1` a single earlier line anywhere above the summary
# decides the verdict — and this is not hypothetical: `head -1` passes this case.
derive data-ef-core-timeout-inflated.txt 's/^.*Safe Mode.*$/Timeout:  0/' || exit 1
assert_rejected "an earlier 'Timeout: 0' line does not override the summary" "$TIMEOUT_SHARE" \
  "$DERIVED" "$CORE_CFG" 543 1135

# And the anchor. Stryker prints its cleartext per-file TABLE *after* the summary block,
# so "the last match wins" is only safe while the pattern is anchored to the start of a
# line: an unanchored `Timeout:[[:space:]]+[0-9]+` plus `tail -1` would read whatever the
# table said last. Nothing in a real table matches today; this pins the pair.
derive data-ef-core-timeout-inflated.txt 's/^\(.*The final mutation score.*\)$/\1 Timeout:  0/' || exit 1
assert_rejected "a mid-line 'Timeout:' AFTER the summary is not mistaken for it" "$TIMEOUT_SHARE" \
  "$DERIVED" "$CORE_CFG" 543 1135

# Malformed input fails CLOSED. `$(( 08 ))` is an octal error in bash; without
# require_number the arithmetic aborts the enclosing `if` and the script runs on to its
# success line and exits 0 — a guard failing open on a typo, which is the exact failure
# require_number's own comment was written for. Declared counts are 1 so check 3's
# magnitude floor cannot reject it first; only the format check can.
derive data-ef-core-timeout-inflated.txt 's/^\(\[09:35:33 INF\] \)543  /\108   /' || exit 1
assert_rejected "a zero-padded mutant count is refused, not silently treated as octal" "$OCTAL" \
  "$DERIVED" "$CORE_CFG" 1 1

# The same guard must NOT reject a bare `Timeout: 0`, which is the healthiest reading
# this script can take. require_number (used for the declared counts) rejects `0` on
# purpose — a floor of zero is a check that cannot fail — so reusing it here would have
# failed every honest run. That is why check 6 has its own require_log_number, and this
# case is what separates the two.
derive data-ef-core-timeout-inflated.txt 's/\(^Timeout:  .*m\)249/\10/' || exit 1
assert_ok "a bare 'Timeout: 0' is a legitimate reading, not a malformed one" \
  "$DERIVED" "$CORE_CFG" 543 1135

# ============================================================================ total

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
