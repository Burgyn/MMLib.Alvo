#!/usr/bin/env bash
# Suite for scripts/ci-changes: builds a throwaway repo per case and checks the classification.
set -euo pipefail
SCRIPT="$(cd "$(dirname "$0")" && pwd)/ci-changes"
FAILED=0

case_() { # <name> <expected full> <path>...
  local name="$1" expected="$2"; shift 2
  local repo; repo="$(mktemp -d)"
  (
    cd "$repo"
    git init -q && git config user.email t@t && git config user.name t
    echo base > base.txt && git add . && git commit -qm base
    for p in "$@"; do mkdir -p "$(dirname "$p")"; echo x > "$p"; done
    [ "$#" -gt 0 ] && git add . && git commit -qm change
    git rev-parse HEAD~"$([ "$#" -gt 0 ] && echo 1 || echo 0)" > .base
  )
  local out; out="$(cd "$repo" && "$SCRIPT" "$(cat .base)" 2>/dev/null)"
  rm -rf "$repo"
  if grep -qx "full=$expected" <<< "$out"; then echo "ok   $name"; else echo "FAIL $name: got [$out]"; FAILED=1; fi
}

case_ "website page is docs-only"          false website/src/content/docs/a.mdx
case_ "root markdown is docs-only"         false README.md CHANGELOG.md
case_ "docs prose is docs-only"            false docs/architecture/x.md docs/superpowers/specs/y.md
case_ "website snippet is docs-only"       false website/src/snippets/extending/a/B.cs
case_ "prototype is everything"            true  docs/design/f5-admin/app.js
case_ "nested markdown is everything"      true  examples/field-service/README.md
case_ "skill markdown is everything"       true  plugins/alvo/skills/x/SKILL.md
case_ "source is everything"               true  src/MMLib.Alvo/A.cs
case_ "one code path among docs"           true  README.md src/MMLib.Alvo/A.cs
case_ "workflow is everything"             true  .github/workflows/ci.yml
case_ "empty diff is everything"           true

if ! "$SCRIPT" 0000000000000000000000000000000000000000 >/dev/null 2>&1 \
   || ! "$SCRIPT" 0000000000000000000000000000000000000000 2>/dev/null | grep -qx 'full=true'; then
  echo "FAIL unreadable base must be everything"; FAILED=1
else echo "ok   unreadable base is everything"; fi

exit "$FAILED"
