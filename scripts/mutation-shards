#!/usr/bin/env python3
"""Generate the weekly mutation sweep's shards: mutation-sweep/*.json and mutation-sweep/matrix.json.

WHY THIS EXISTS. Four legs of .github/workflows/mutation.yml cannot finish under GitHub's 360-minute
job ceiling (expressions, rules/auth/rest, data-ef-core, accounts-store; see "RE-SHARDING THE LONG
LEGS" in its header). On every push they run with Stryker's `since` against the previous main
commit, mutating only what the merge changed. The FULL measurement runs weekly and on
workflow_dispatch, split into shards that each fit — and this script is the one place those shards
come from, so that a source file added tomorrow cannot silently fall out of every shard.

HOW A SHARD IS CUT. Each long leg keeps its committed config (stryker-config.<leg>.json) as the
single source of what it mutates. This script resolves that config's `mutate` globs over the
project's *.cs files, orders them (by path; accounts-store by store), weighs each by the mutants
Stryker CREATES in it (scripts/fixtures/mutation-shards/created-*.tsv, read from a real trace
log), and cuts the ordered list into N contiguous runs of near-equal weight. Contiguous, so a shard
reads as an area (Events/..., Migrations/...) rather than a scatter. Each shard config is its
parent with `mutate` replaced by the exact file list; the union of a leg's shards is its parent's
file set, disjoint, which `--check` re-proves on every PR (scripts/test-assert-mutation-run).

HOW N IS CHOSEN — measured cost, not mutant count. Runner seconds per mutant per suite, from the
sampling run 44877284451 (2026-11-21): expressions 68.9 s (147 mutants, 94 % killed), the core
suite on Rules 59.9 s (104, 89 %), data-ef-core 97.5 s (97, 28 %), data-ef-rest 10.1 s (73).
Survivors cost ~4x what kills do there, and rules/auth/rest last measured ~58 % killed, so its
cost is taken at 107 s (0.58 x 44 s + 0.42 x 194 s, the split the two core-suite samples give),
not at the sample's 59.9. accounts-store has NO measurement: its sample was cancelled with every
Accounts.Tests host force-killed at the test-run timeout under --concurrency 4; at concurrency 2
it is ESTIMATED at 150 s. N is the smallest count that keeps each shard's projected wall clock
(mutants x cost / concurrency) near 180 minutes, so a 340-minute budget is >= 1.7x.

EVERY NUMBER A SHARD CARRIES IS PROVISIONAL until the first sweep measures it: its `mutants:` floor
is 70 % of an estimate (weight x the leg's tested/created ratio), and its `break` is the
collapse floor 30 the header uses for unmeasured legs.

Usage:
  scripts/mutation-shards            write mutation-sweep/
  scripts/mutation-shards --check    fail (exit 1) if mutation-sweep/ is stale or not a partition
"""

from __future__ import annotations

import copy
import json
import math
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "mutation-sweep"
WEIGHTS = ROOT / "scripts" / "fixtures" / "mutation-shards"
TARGET_MINUTES = 180
BUDGET = 340
SHARD_BREAK = 30

CORE = "src/MMLib.Alvo/MMLib.Alvo.csproj"
EF = "src/MMLib.Alvo.Data.EntityFrameworkCore/MMLib.Alvo.Data.EntityFrameworkCore.csproj"

# tested = "N total mutants will be tested" of the leg's last full discovery (run 44834820709 /
# 44850064624); suite = its "Number of tests found"; cost = runner seconds per mutant (see above).
LEGS = [
    {"leg": "expressions", "slug": "expressions", "parent": "stryker-config.expressions.json",
     "project": CORE, "tested": 2591, "suite": 5330, "cost": 68.9, "concurrency": 4},
    {"leg": "rules, auth, rest", "slug": "core", "parent": "stryker-config.json",
     "project": CORE, "tested": 9557, "suite": 5330, "cost": 107.0, "concurrency": 4},
    {"leg": "data-ef-core", "slug": "data-ef-core", "parent": "stryker-config.data-ef-core.json",
     "project": EF, "tested": 863, "suite": 2903, "cost": 97.5, "concurrency": 4},
    {"leg": "accounts-store", "slug": "accounts-store", "parent": "stryker-config.accounts-store.json",
     "project": EF, "tested": 888, "suite": 1750, "cost": 150.0, "concurrency": 2,
     # Its only measurement so far is a sample whose every Accounts.Tests host was force-killed;
     # the first sweep keeps Stryker's trace log (logs/*.txt) so a repeat can be read, not guessed.
     "debug-log": True,
     # By store, so a shard boundary falls between stores where the weights allow it.
     "order": ["EfCoreAccountStore", "Internal/AuthTables", "EfCoreTenantStore.cs", "EfCoreTenantStore.Members",
               "Internal/TenantTables", "EfCoreTenantStore.Invitations", "Internal/InvitationTables",
               "Internal/InvitationAcceptance", "EfCoreAppTokenStore", "Internal/AppTokenTables"]},
]

# Run whole in the sweep: it fits one job (2950 x 10.1 s / 4 = ~124 min).
WHOLE = [
    {"name": "data-ef-rest", "config": "stryker-config.data-ef-rest.json", "project": EF,
     "mutants": 2950, "suite": 1560, "timeout": 250},
]


def glob_regex(pattern: str) -> re.Pattern[str]:
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pattern[i] == "*":
            out, i = out + "[^/]*", i + 1
        else:
            out, i = out + re.escape(pattern[i]), i + 1
    return re.compile("^" + out + "$")


def resolve(project_dir: pathlib.Path, mutate: list[str]) -> list[str]:
    include = [glob_regex(p) for p in mutate if not p.startswith("!")]
    exclude = [glob_regex(p[1:]) for p in mutate if p.startswith("!")]
    files = []
    for path in sorted(project_dir.rglob("*.cs")):
        rel = path.relative_to(project_dir).as_posix()
        if rel.split("/")[0] in ("bin", "obj"):
            continue
        if any(r.match(rel) for r in include) and not any(r.match(rel) for r in exclude):
            files.append(rel)
    return files


def weights(project: str, files: list[str]) -> dict[str, float]:
    name = pathlib.Path(project).stem
    table = {}
    for line in (WEIGHTS / f"created-{name}.tsv").read_text(encoding="utf-8").splitlines():
        if line and not line.startswith("#"):
            rel, count = line.split("\t")
            table[rel] = int(count)
    project_dir = ROOT / pathlib.Path(project).parent
    lines_known = sum(len((project_dir / r).read_text(encoding="utf-8").splitlines())
                      for r in table if (project_dir / r).exists())
    per_line = sum(table.values()) / max(lines_known, 1)
    return {rel: table.get(rel, len((project_dir / rel).read_text(encoding="utf-8").splitlines()) * per_line)
            for rel in files}


def order(files: list[str], prefixes: list[str] | None) -> list[str]:
    if not prefixes:
        return files
    def key(rel: str) -> tuple[int, str]:
        for index, prefix in enumerate(prefixes):
            if rel.startswith(prefix):
                return index, rel
        return len(prefixes), rel
    return sorted(files, key=key)


def greedy(files: list[str], weight: dict[str, float], limit: float) -> list[list[str]]:
    """Contiguous runs, each as long as it stays within `limit` (a lone heavier file is its own run)."""
    shards, current, acc = [], [], 0.0
    for rel in files:
        if current and acc + weight[rel] > limit:
            shards.append(current)
            current, acc = [], 0.0
        current.append(rel)
        acc += weight[rel]
    if current:
        shards.append(current)
    return shards


def cut(files: list[str], weight: dict[str, float], limit: float) -> list[list[str]]:
    """The fewest contiguous shards none of which exceeds `limit` (or a single file heavier than
    it), then the most even cut into that many: the smallest limit that still needs no more."""
    count = len(greedy(files, weight, limit))
    low, high = max(weight[f] for f in files), limit
    for _ in range(60):
        middle = (low + high) / 2
        if len(greedy(files, weight, middle)) <= count:
            high = middle
        else:
            low = middle
    return greedy(files, weight, high)


def build() -> dict[str, str]:
    files_out: dict[str, str] = {}
    matrix = []
    for leg in LEGS:
        parent = json.loads((ROOT / leg["parent"]).read_text(encoding="utf-8"))
        project_dir = ROOT / pathlib.Path(leg["project"]).parent
        files = order(resolve(project_dir, parent["stryker-config"]["mutate"]), leg.get("order"))
        weight = weights(leg["project"], files)
        total = sum(weight.values())
        ratio = leg["tested"] / total
        minutes_per_weight = ratio * leg["cost"] / leg["concurrency"] / 60
        # No shard projected past TARGET_MINUTES — except a single file heavier than that
        # (EfAlvoData.cs), which no file-level cut can shorten.
        shards = cut(files, weight, TARGET_MINUTES / minutes_per_weight)
        for number, shard in enumerate(shards, start=1):
            config = copy.deepcopy(parent)
            config["stryker-config"]["mutate"] = shard
            thresholds = config["stryker-config"].setdefault("thresholds", {})
            thresholds["break"] = SHARD_BREAK
            name = f"{leg['slug']}.{number:02d}"
            path = f"mutation-sweep/stryker-config.{name}.json"
            files_out[path] = json.dumps(config, indent=2, ensure_ascii=False) + "\n"
            estimate = sum(weight[f] for f in shard) * ratio
            minutes = estimate * leg["cost"] / leg["concurrency"] / 60
            matrix.append({
                # "of", not "/": the name is also the artifact name, which may not contain a slash.
                "name": f"{leg['leg']} {number} of {len(shards)}",
                "config": path, "project": leg["project"],
                "mutants": max(1, math.floor(estimate * 0.7)), "suite": leg["suite"],
                "timeout": BUDGET, "concurrency": leg["concurrency"],
                "projected-minutes": round(minutes), "files": len(shard),
                **({"debug-log": True} if leg.get("debug-log") else {}),
            })
    for whole in WHOLE:
        matrix.append({**whole, "concurrency": 4})
    files_out["mutation-sweep/matrix.json"] = json.dumps({"include": matrix}, indent=2) + "\n"
    return files_out


def main() -> int:
    check = sys.argv[1:] == ["--check"]
    wanted = build()
    on_disk = {p.relative_to(ROOT).as_posix() for p in OUT.glob("*.json")} if OUT.exists() else set()
    if check:
        stale = sorted(p for p, text in wanted.items()
                       if not (ROOT / p).exists() or (ROOT / p).read_text(encoding="utf-8") != text)
        extra = sorted(on_disk - set(wanted))
        if stale or extra:
            for path in stale:
                print(f"stale or missing: {path}")
            for path in extra:
                print(f"not generated by this script: {path}")
            print("Run scripts/mutation-shards and commit mutation-sweep/.")
            return 1
        print(f"mutation-sweep/ is current: {len(wanted) - 1} shard configs and matrix.json.")
        return 0
    OUT.mkdir(exist_ok=True)
    for path in on_disk - set(wanted):
        (ROOT / path).unlink()
    for path, text in wanted.items():
        (ROOT / path).write_text(text, encoding="utf-8")
    matrix = json.loads(wanted["mutation-sweep/matrix.json"])["include"]
    for entry in matrix:
        print(f"{entry['name']:28s} files {entry.get('files', '-'):>4} floor {entry['mutants']:>5} "
              f"~{entry.get('projected-minutes', '-')} min  budget {entry['timeout']}  c={entry['concurrency']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
