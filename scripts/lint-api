#!/usr/bin/env bash
# lint-api — lint the committed OpenAPI document snapshots against schema/openapi-ruleset.yaml:
# the core's (the Data API alone) and the sign-in host's (accounts mapped: the auth operations and the
# Bearer scheme beside the Data API).
#
# The cheap half of #26's static gate: no build, no .NET, no running host, so it fires the moment
# someone edits the snapshot and it costs a second. The other caller of the same ruleset is
# MMLib.Alvo.Api.Invariants.Tests.Integration, which lints the three appliable examples/ descriptors
# and sixteen generated ones over a running host. One ruleset file, two callers — never two authorities.
#
# --fail-severity warn rather than the default `error`: after the mutes the ruleset declares, the
# document is clean at EVERY severity, so a new warning is a regression and not noise to accumulate.
#
# vacuum sniffs content rather than the file extension (measured), so the `.verified.txt` snapshot is
# linted where it lies rather than copied to a `.json` first.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
VACUUM="$("$DIR/ensure-vacuum")"
RULESET="$ROOT/schema/openapi-ruleset.yaml"
DOCUMENTS=(
  "$ROOT/test/MMLib.Alvo.Api.Tests/OpenApiDocumentTests.The_document_is_stable.verified.txt"
  "$ROOT/test/MMLib.Alvo.Accounts.Tests/AccountsOpenApiTests.The_document_with_sign_in_is_stable.verified.txt"
)

# Every document is checked for presence before any is linted, so a missing one fails the run even when
# another is clean: a lint with no document to lint is not a pass.
for DOCUMENT in "${DOCUMENTS[@]}"; do
  if [ ! -f "$DOCUMENT" ]; then
    echo "[lint-api] FAIL: a document snapshot is missing: $DOCUMENT" >&2
    echo "[lint-api] Run the suite that owns it first — a lint with no document to lint is not a pass." >&2
    exit 1
  fi
done

for DOCUMENT in "${DOCUMENTS[@]}"; do
  echo "[lint-api] vacuum lint $(basename "$DOCUMENT")"
  "$VACUUM" lint --no-style --no-banner --details --all-results \
    --fail-severity warn --ruleset "$RULESET" "$DOCUMENT"
done
echo "[lint-api] OK"
