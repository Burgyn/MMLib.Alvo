#!/usr/bin/env bash
# ring2 — run before opening a PR (ring1 + integration (affected) + API
# invariant + Vacuum). None of those exist yet — add them here when they land.
# Full run (+ e2e) stays in CI on the PR; mutation runs post-merge on `main`.
# Do not run either locally.
# The compose + TeaPie e2e is NOT here: see scripts/test-e2e for why (it needs an image build and a
# multi-service stack, and the design places the full e2e in CI on the PR).
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
"$DIR/test-ring1"

integration="$(find "$ROOT" -name '*.Tests.Integration.csproj' -not -path '*/bin/*' -not -path '*/obj/*' 2>/dev/null || true)"
if [ -z "$integration" ]; then
  echo "[ring2] no integration test projects yet — skipping"
else
  # This affected-scoping is now LOAD-BEARING, and it was not before. While ring0
  # ran `dotnet test` over the whole solution, the integration projects had already
  # run by the time this loop reached them, so a "unaffected, skipping" line cost
  # nothing. ring0 no longer runs them (it must not need Docker), so a skip here is
  # now a real skip. That is the intended behaviour — an integration project is
  # skipped only on a POSITIVE determination that nothing it depends on changed, and
  # every other path (no `origin/main`, dotnet-affected failing) falls through to
  # running it — but it means this scoping decides coverage, so treat a change to it
  # as a change to what the PR gate proves.
  echo "[ring2] integration tests (Testcontainers), affected-scoped"
  base="${ALVO_AFFECTED_BASE:-origin/main}"
  affected_scoped=false
  affected_list=""
  if git -C "$ROOT" rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
    if affected_raw="$(dotnet tool run dotnet-affected -- --repository-path "$ROOT" --filter-file-path "$ROOT/MMLib.Alvo.slnx" --from "$base" --to HEAD --dry-run -f text 2>/dev/null)"; then
      affected_scoped=true
      affected_list="$(printf '%s\n' "$affected_raw" | grep '\.csproj$' || true)"
    fi
  fi
  while IFS= read -r proj; do
    if [ -z "$proj" ]; then
      continue
    fi
    if [ "$affected_scoped" = true ] && ! grep -qxF "$proj" <<< "$affected_list"; then
      echo "[ring2] unaffected, skipping $(basename "$proj")"
      continue
    fi
    dotnet test --project "$proj" -c "${ALVO_CONFIGURATION:-Debug}"
  done <<< "$integration"
fi

echo "[ring2] placeholder: API invariant + Vacuum — land in a later F1 PR"
echo "[ring2] OK"
