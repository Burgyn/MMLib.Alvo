#!/usr/bin/env bash
# e2e — the compose stacks plus TeaPie, as a black box over the published ports.
#
# In NO ring, deliberately. The F3 design's testing table places the full e2e at "CI on the PR,
# never locally", ring0 must stay Docker-free by its own comment, and ring2's Docker use is one
# self-skipping Testcontainers image rather than an image BUILD plus a multi-service stack. This
# script exists so a human can run the same thing CI runs, on purpose, not because a ring calls it.
#
# TWO stacks, and they answer two different questions:
#
#   docker-compose.yml (:8080, vehicle-registry)  — does the stack boot and answer? Three entities,
#       no tenancy, no audit, no hidden fields. Its suite guards the smoke path and the two
#       mutations that protect it (descriptor swap, provider swap).
#
#   docker-compose.field-service.yml (:8081)      — does the PRODUCT behave as documented? The
#       complex demo: two tenants, five keys differing in role and tenant, an audited entity beside
#       an unaudited one, hidden and readOnly fields, an unconfigured operation, and both a
#       caller-level and a row-level predicate. Its suite drives the query grammar, problem
#       documents, ETag/If-Match, Idempotency-Key, confidentiality, authorization, tenant isolation
#       and six multi-step journeys.
#
# "The stack boots and answers" is not "the product behaves as documented", and only the second is
# worth shipping — so both run, and the run fails if either does.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
cd "$ROOT"

REPORT_DIR="$ROOT/artifacts/teapie"
ENV_FILE="$REPORT_DIR/env.json"
REPORT_FILE="$REPORT_DIR/report.xml"
FIELD_SERVICE_REPORT_FILE="$REPORT_DIR/report-field-service.xml"

FIELD_SERVICE_COMPOSE=(
  --env-file "$ROOT/examples/field-service/demo-identities.env"
  -f "$ROOT/docker-compose.field-service.yml"
)

# The image ships no credential (§2.14), so every stack is handed fresh ones per run and the TeaPie
# environment is generated from the same values — one source of truth, and nothing secret committed.
export ALVO_DEMO_KEY_SECRET="${ALVO_DEMO_KEY_SECRET:-$(openssl rand -hex 16)}"
export ALVO_FS_DISPATCHER_NORTH_SECRET="${ALVO_FS_DISPATCHER_NORTH_SECRET:-$(openssl rand -hex 16)}"
export ALVO_FS_TECH_NORTH_SECRET="${ALVO_FS_TECH_NORTH_SECRET:-$(openssl rand -hex 16)}"
export ALVO_FS_SPARE_NORTH_SECRET="${ALVO_FS_SPARE_NORTH_SECRET:-$(openssl rand -hex 16)}"
export ALVO_FS_DISPATCHER_SOUTH_SECRET="${ALVO_FS_DISPATCHER_SOUTH_SECRET:-$(openssl rand -hex 16)}"
export ALVO_FS_ADMIN_SECRET="${ALVO_FS_ADMIN_SECRET:-$(openssl rand -hex 16)}"

# The field-service demo's non-secret constants — tenant ids, user ids, the published port. Sourced
# rather than restated: compose interpolates the same file, so the environment TeaPie asserts
# against and the environment the container was configured with cannot drift apart.
set -a
# shellcheck source=../examples/field-service/demo-identities.env
. "$ROOT/examples/field-service/demo-identities.env"
set +a

write_teapie_environment() {
  mkdir -p "$REPORT_DIR"
  cat > "$ENV_FILE" <<JSON
{
  "\$shared": {
    "baseUrl": "http://localhost:8080",
    "apiKeyId": "demo"
  },
  "compose": {
    "apiKeySecret": "$ALVO_DEMO_KEY_SECRET",

    "fsBaseUrl": "http://localhost:$ALVO_FS_PORT",

    "tenantNorth": "$ALVO_FS_TENANT_NORTH",
    "tenantSouth": "$ALVO_FS_TENANT_SOUTH",
    "userDispatcherNorth": "$ALVO_FS_USER_DISPATCHER_NORTH",
    "userTechNorth": "$ALVO_FS_USER_TECH_NORTH",
    "userSpareNorth": "$ALVO_FS_USER_SPARE_NORTH",
    "userDispatcherSouth": "$ALVO_FS_USER_DISPATCHER_SOUTH",
    "userAdmin": "$ALVO_FS_USER_ADMIN",

    "keyDispatcherNorth": "dispatcher-north.$ALVO_FS_DISPATCHER_NORTH_SECRET",
    "keyTechNorth": "tech-north.$ALVO_FS_TECH_NORTH_SECRET",
    "keySpareNorth": "spare-north.$ALVO_FS_SPARE_NORTH_SECRET",
    "keyDispatcherSouth": "dispatcher-south.$ALVO_FS_DISPATCHER_SOUTH_SECRET",
    "keyAdmin": "admin.$ALVO_FS_ADMIN_SECRET"
  }
}
JSON
}

teardown() {
  status=$?
  trap - EXIT
  if [ "$status" != 0 ]; then
    echo "[e2e] FAILED — container logs follow" >&2
    docker compose logs --no-color --tail 200 >&2 || true
    docker compose "${FIELD_SERVICE_COMPOSE[@]}" logs --no-color --tail 200 >&2 || true
  fi
  docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  docker compose "${FIELD_SERVICE_COMPOSE[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  exit "$status"
}

start_the_stacks() {
  # Down first, so the run owns its databases rather than inheriting them. Without it a stack left up
  # by a previous run carries that run's rows, and both suites' row assertions — the vehicle
  # registry's single-owner count and every exact-set comparison in the field-service suite — could
  # not tell a row this run created from one it found. The field-service seed additionally reuses
  # fixed `reference` values, which are declared unique.
  docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  docker compose "${FIELD_SERVICE_COMPOSE[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true

  # Build and pull outside the timed window: §2.14's criterion is "a working backend within 60 s",
  # which is boot time, not compile time and not the speed of a registry. Both stacks build the same
  # image from the same context, so the second build is a cache hit.
  echo "[e2e] docker compose build"
  docker compose build
  docker compose "${FIELD_SERVICE_COMPOSE[@]}" build
  docker compose pull --quiet --ignore-buildable >/dev/null 2>&1 || true

  echo "[e2e] docker compose up --wait (60s budget, from baas-analyza.md §2.14)"
  docker compose up --detach --wait --wait-timeout 60

  echo "[e2e] docker compose -f docker-compose.field-service.yml up --wait"
  docker compose "${FIELD_SERVICE_COMPOSE[@]}" up --detach --wait --wait-timeout 60
}

run_the_suites() {
  dotnet tool restore

  # --no-cache-vars: TeaPie caches collection variables between runs, so a stale OwnerId from an
  # earlier run would let 002-follow-location pass on a stack that never answered a 201 — and, in
  # the field-service suite, a stale RegionNorthId would let a whole seeded chain resolve against
  # ids the current database does not hold.
  echo "[e2e] teapie test test/teapie -e compose"
  dotnet tool run teapie -- test test/teapie \
    -e compose \
    --env-file "$ENV_FILE" \
    -r "$REPORT_FILE" \
    --no-cache-vars \
    --no-logo

  echo "[e2e] teapie test test/teapie-field-service -e compose"
  dotnet tool run teapie -- test test/teapie-field-service \
    -e compose \
    --env-file "$ENV_FILE" \
    -r "$FIELD_SERVICE_REPORT_FILE" \
    --no-cache-vars \
    --no-logo
}

# The one fact TeaPie cannot carry, and the one that separates "the app answered" from "the app used
# the database compose gave it". Under a stack switched to SQLite every HTTP check above stays green
# and only this fails ("relation \"owners\" does not exist"), which is exactly why it is here.
# PostgreSQL publishes no host port, so this asks the container rather than the network.
#
# Exactly one, not at least one: the run starts from a torn-down stack and the suite performs exactly
# one successful create, so any other count means either the row is missing or the database is not
# the one this run started.
assert_the_row_reached_postgresql() {
  echo "[e2e] the owner TeaPie created is a row in the PostgreSQL compose started"
  local rows
  rows="$(docker compose exec -T postgres \
    psql -U alvo -d alvo -v ON_ERROR_STOP=1 -tAc \
    "select count(*) from owners where name = 'TeaPie Ltd'" | tr -d '[:space:]')"
  if [ "$rows" != "1" ]; then
    echo "[e2e] expected exactly one owner named 'TeaPie Ltd' in PostgreSQL, found '${rows}'." >&2
    exit 1
  fi
  echo "[e2e] owners named 'TeaPie Ltd' in PostgreSQL: $rows"
}

# The same fact for the field-service stack, and it carries one the HTTP suite structurally cannot:
# a HIDDEN column's value. `internal_notes` is masked out of every response, so no assertion over
# HTTP can distinguish "the write was stored and withheld from the reader" from "the write was
# silently dropped" — the suite proves the second half and this proves the first. It is also the
# stack's own descriptor-and-provider check: under a SQLite switch or a swapped descriptor mount
# there is no `work_orders` table to count.
assert_the_hidden_value_reached_postgresql() {
  echo "[e2e] the hidden field the field-service suite wrote is stored in PostgreSQL"
  local rows
  rows="$(docker compose "${FIELD_SERVICE_COMPOSE[@]}" exec -T postgres \
    psql -U alvo -d alvo_field_service -v ON_ERROR_STOP=1 -tAc \
    "select count(*) from work_orders where reference = 'WO-1001' and internal_notes like 'A hidden field is still WRITABLE%'" \
    | tr -d '[:space:]')"
  if [ "$rows" != "1" ]; then
    echo "[e2e] expected exactly one work order whose hidden 'internal_notes' carries the value" >&2
    echo "[e2e] 060-Confidentiality wrote, found '${rows}'. A hidden field is writable and stored;" >&2
    echo "[e2e] only the READ is masked, and no HTTP assertion can tell those two apart." >&2
    exit 1
  fi
  echo "[e2e] work orders carrying the written hidden value: $rows"
}

# Tenant isolation, asserted at the row level rather than at the API's. The suite proves tenant B is
# answered 404; this proves the rows really are partitioned by `tenant_id` in the table, so a driver
# that answered correctly while storing everything under one discriminator would be caught.
assert_the_tenants_are_partitioned_in_postgresql() {
  echo "[e2e] the two tenants' rows carry two distinct tenant_id values in PostgreSQL"
  local tenants
  tenants="$(docker compose "${FIELD_SERVICE_COMPOSE[@]}" exec -T postgres \
    psql -U alvo -d alvo_field_service -v ON_ERROR_STOP=1 -tAc \
    "select count(distinct tenant_id) from work_orders" | tr -d '[:space:]')"
  if [ "$tenants" != "2" ]; then
    echo "[e2e] expected work orders in exactly 2 tenants, found '${tenants}'." >&2
    exit 1
  fi
  echo "[e2e] distinct tenant_id values in work_orders: $tenants"
}

write_teapie_environment
trap teardown EXIT
start_the_stacks
run_the_suites
assert_the_row_reached_postgresql
assert_the_hidden_value_reached_postgresql
assert_the_tenants_are_partitioned_in_postgresql
echo "[e2e] OK"
