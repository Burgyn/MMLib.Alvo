#!/usr/bin/env bash
# e2e — the compose stack plus TeaPie, as a black box over the published port.
#
# In NO ring, deliberately. The F3 design's testing table places the full e2e at "CI on the PR,
# never locally", ring0 must stay Docker-free by its own comment, and ring2's Docker use is one
# self-skipping Testcontainers image rather than an image BUILD plus a multi-service stack. This
# script exists so a human can run the same thing CI runs, on purpose, not because a ring calls it.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
cd "$ROOT"

REPORT_DIR="$ROOT/artifacts/teapie"
ENV_FILE="$REPORT_DIR/env.json"
REPORT_FILE="$REPORT_DIR/report.xml"

# The image ships no credential (§2.14), so the stack is handed a fresh one per run and the TeaPie
# environment is generated from the same value — one source of truth, and nothing secret committed.
export ALVO_DEMO_KEY_SECRET="${ALVO_DEMO_KEY_SECRET:-$(openssl rand -hex 16)}"

write_teapie_environment() {
  mkdir -p "$REPORT_DIR"
  cat > "$ENV_FILE" <<JSON
{
  "\$shared": {
    "baseUrl": "http://localhost:8080",
    "apiKeyId": "demo"
  },
  "compose": {
    "apiKeySecret": "$ALVO_DEMO_KEY_SECRET"
  }
}
JSON
}

teardown() {
  status=$?
  trap - EXIT
  if [ "$status" != 0 ]; then
    echo "[e2e] FAILED — container logs follow" >&2
    docker compose logs --no-color --tail 200 >&2 || true
  fi
  docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  exit "$status"
}

start_the_stack() {
  # Down first, so the run owns its database rather than inheriting one. Without it a stack left up
  # by a previous run carries that run's rows, and the row assertion below could not tell a row this
  # run created from one it found.
  docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true

  # Build and pull outside the timed window: §2.14's criterion is "a working backend within 60 s",
  # which is boot time, not compile time and not the speed of a registry.
  echo "[e2e] docker compose build"
  docker compose build
  docker compose pull --quiet --ignore-buildable >/dev/null 2>&1 || true

  echo "[e2e] docker compose up --wait (60s budget, from baas-analyza.md §2.14)"
  docker compose up --detach --wait --wait-timeout 60
}

run_the_suite() {
  echo "[e2e] teapie test tests/teapie -e compose"
  dotnet tool restore
  # --no-cache-vars: TeaPie caches collection variables between runs, so a stale OwnerId from an
  # earlier run would let 002-follow-location pass on a stack that never answered a 201.
  dotnet tool run teapie -- test tests/teapie \
    -e compose \
    --env-file "$ENV_FILE" \
    -r "$REPORT_FILE" \
    --no-cache-vars \
    --no-logo
}

# The one fact TeaPie cannot carry, and the one that separates "the app answered" from "the app used
# the database compose gave it". Under a stack switched to SQLite every HTTP check above stays green
# and only this fails ("relation \"owners\" does not exist"), which is exactly why it is here.
# PostgreSQL publishes no host port, so this asks the container rather than the network.
#
# Exactly one, not at least one: the run starts from a torn-down stack and the suite performs exactly
# one successful create, so any other count means either the row is missing or the database is not
# the one this run started.
assert_the_row_reached_postgresql() {
  echo "[e2e] the owner TeaPie created is a row in the PostgreSQL compose started"
  local rows
  rows="$(docker compose exec -T postgres \
    psql -U alvo -d alvo -v ON_ERROR_STOP=1 -tAc \
    "select count(*) from owners where name = 'TeaPie Ltd'" | tr -d '[:space:]')"
  if [ "$rows" != "1" ]; then
    echo "[e2e] expected exactly one owner named 'TeaPie Ltd' in PostgreSQL, found '${rows}'." >&2
    exit 1
  fi
  echo "[e2e] owners named 'TeaPie Ltd' in PostgreSQL: $rows"
}

write_teapie_environment
trap teardown EXIT
start_the_stack
run_the_suite
assert_the_row_reached_postgresql
echo "[e2e] OK"
