#!/usr/bin/env bash
# ensure-vacuum — resolve the pinned Vacuum binary and print its path on stdout.
#
# Vacuum lints the generated OpenAPI document against schema/openapi-ruleset.yaml (#26). It is a
# development/CI tool invoked as a separate process, which is the carve-out alvo-dotnet-conventions
# already names it in, alongside Stryker, TeaPie and k6: nothing ships, nothing is linked, and its MIT
# licence reaches no artifact this repo publishes.
#
# WHY A DOWNLOAD AND NOT A DOCKER IMAGE. CI runs scripts/test-ring2 on windows-latest, whose Docker
# daemon runs Windows containers and cannot run a Linux image. A vacuum that existed only in a Linux
# container would make the invariant suite self-skip there — and CI sets
# TESTINGPLATFORM_EXITCODE_IGNORE=8 on Windows, so an assembly that ran zero tests would report
# success. A pinned, checksum-verified release asset exists for every platform in the matrix
# (verified against the release), so this is the only shape that keeps the gate honest on both.
#
# WHY THE VERSION IS PINNED. A linter's ruleset semantics are part of the gate: a minor release that
# adds a rule to `recommended` would turn a green PR red for a reason nobody in that PR changed, and
# one that drops a rule would turn a red PR green. Bump it deliberately and re-run scripts/test-ring2.
#
# Two environment overrides, both for scripts/test-ensure-vacuum's benefit — it builds a fake release
# in a temp directory and serves it over file://, so the suite needs no network:
#   ALVO_VACUUM_BASE_URL   where releases are fetched from
#   ALVO_VACUUM_HOME       where the resolved binary is kept
set -euo pipefail
VERSION="0.30.3"
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
BASE_URL="${ALVO_VACUUM_BASE_URL:-https://github.com/daveshanley/vacuum/releases/download}"
HOME_DIR="${ALVO_VACUUM_HOME:-$ROOT/artifacts/tools/vacuum}"

asset_name() {
  local os arch
  case "$(uname -s)" in
    Darwin)               os=darwin ;;
    Linux)                os=linux ;;
    MINGW*|MSYS*|CYGWIN*) os=windows ;;
    *) echo "ensure-vacuum: unsupported OS '$(uname -s)'" >&2; return 1 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64)  arch=x86_64 ;;
    *) echo "ensure-vacuum: unsupported architecture '$(uname -m)'" >&2; return 1 ;;
  esac
  echo "vacuum_${VERSION}_${os}_${arch}.tar.gz"
}

binary_name() {
  case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) echo "vacuum.exe" ;; *) echo "vacuum" ;; esac
}

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}';
  else sha256sum "$1" | awk '{print $1}'; fi
}

case "${1:-}" in
  --print-asset)   asset_name; exit 0 ;;
  --print-version) echo "$VERSION"; exit 0 ;;
esac

# Already resolved at the pinned version — the common path, and the reason ring2 can call this before
# every run without paying for it twice.
resolved="$HOME_DIR/$(binary_name)"
if [ -x "$resolved" ] && [ "$("$resolved" version 2>/dev/null | tr -d '\r' || true)" = "$VERSION" ]; then
  echo "$resolved"
  exit 0
fi

# A local vacuum at the pinned version is used as-is — the same courtesy scripts/test-load extends to
# a local k6. A different version warns rather than being silently trusted: the ruleset is written
# against this one, and two of its rules are only non-vacuous on a version whose `casing` function
# still honours `field: "@key"`.
if command -v vacuum >/dev/null 2>&1; then
  local_version="$(vacuum version 2>/dev/null | tr -d '\r' || true)"
  if [ "$local_version" = "$VERSION" ]; then
    command -v vacuum
    exit 0
  fi
  echo "ensure-vacuum: WARNING local vacuum is '$local_version', not $VERSION — fetching the pinned one" >&2
fi

asset="$(asset_name)"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
echo "ensure-vacuum: fetching $asset" >&2
curl -sSLf -o "$stage/$asset" "$BASE_URL/v$VERSION/$asset"
curl -sSLf -o "$stage/checksums.txt" "$BASE_URL/v$VERSION/checksums.txt"

# checksums.txt is the authority, not the asset's presence: an asset the manifest does not list is
# refused rather than trusted, so a release whose naming changed fails loudly instead of quietly
# installing something unverified.
expected="$(awk -v a="$asset" '$2 == a || $2 == "*"a {print $1}' "$stage/checksums.txt" | head -1)"
if [ -z "$expected" ]; then
  echo "ensure-vacuum: $asset is not listed in checksums.txt — refusing an unverified binary" >&2
  exit 1
fi
actual="$(sha256_of "$stage/$asset")"
if [ "$expected" != "$actual" ]; then
  echo "ensure-vacuum: checksum mismatch for $asset" >&2
  echo "ensure-vacuum:   expected $expected" >&2
  echo "ensure-vacuum:   actual   $actual" >&2
  exit 1
fi

tar xzf "$stage/$asset" -C "$stage"
mkdir -p "$HOME_DIR"
mv "$stage/$(binary_name)" "$resolved"
chmod +x "$resolved"
echo "$resolved"
