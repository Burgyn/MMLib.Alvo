#!/usr/bin/env bash
# assert-mutation-run — decide whether a finished Stryker run actually MEASURED what
# its config asked for. Called by .github/workflows/mutation.yml after every shard;
# runnable by hand over a saved log, which is the point (see "Verifying this" below).
#
# usage: scripts/assert-mutation-run <stryker-log> <stryker-config> <expected-mutants> <expected-tests> <shard-name>
#
# WHY THIS EXISTS. A mutation gate has two ways to be green, and only one of them is
# honest. This repository has already shipped the dishonest one twice: once as a
# vacuous run (0 mutants, `project_mutation_gate`), and once as a run that quietly
# substituted a different test suite for the one the config named (#99 — Stryker's
# solution mode ignores `test-projects`, so the expressions shard ran 2211 tests
# instead of 722 and could not finish inside 120 minutes). Both reported success.
#
# The first version of the second guard was `grep -q 'will mutate solution'` — a
# NEGATIVE assertion, and therefore fail-OPEN: reword that log line in any Stryker
# release and the guard silently stops guarding, which is the same class of defect it
# was added to catch. Everything below is a POSITIVE assertion instead: it states the
# number the run must report, and a missing or reworded line fails the check.
#
# WHY NOT ASSERT THE MUTANT COUNT AGAINST SOLUTION MODE. Measured, because it is the
# obvious idea and it does not work: solution mode changes which TEST PROJECTS run,
# not which files are mutated. Same commit, `stryker-config.expressions.json`, both
# modes report "4064 mutants created" and "834 total mutants will be tested"; only
# "Number of tests found" moves (722 -> 2211). data-sqlite likewise: 38 and 38, with
# 403 -> 783 tests. So the assertion that catches solution mode is the TEST-PROJECT
# COUNT (check 2); the two counts are asserted for different failures (checks 3, 4).
#
# NO PIPELINES INTO grep. The log is normalised once into a temp file and every check
# greps that file. This is not style: `printf '%s\n' "$text" | grep -q PATTERN` under
# `set -o pipefail` yields 141, not 0, whenever grep matches early and exits while
# printf is still writing — which is what happens on any real (multi-hundred-KB) log,
# because "Analyzing N test project(s)." appears near the top. That inverted check 2,
# and would have failed every shard on the first real run while reporting that the log
# did not contain a line it had just quoted back. scripts/test-assert-mutation-run
# pins it with an oversized fixture; keep that case if you touch this.
#
# VERIFYING THIS SCRIPT: scripts/test-assert-mutation-run runs it over real Stryker
# logs captured in both working directories. To try one by hand:
#   scripts/assert-mutation-run scripts/fixtures/mutation-logs/data-ef-solution-mode.txt \
#                               stryker-config.data-ef.json 596 858 data-ef
# It must fail check 2 on a solution-mode log and pass on a `test/`-scoped one.
set -uo pipefail

log="${1:?usage: assert-mutation-run <log> <config> <expected-mutants> <expected-tests> <shard-name>}"
config="${2:?missing stryker config path}"
expected_mutants="${3:?missing expected mutant count}"
expected_tests="${4:?missing expected test count}"
shard="${5:?missing shard name}"

fail() {
    echo "::error::Mutation run ($shard): $1"
    exit 1
}

require_number() { # <value> <what it is>
    case "$1" in
        ''|*[!0-9]*)
            # Not pedantry: `$(( ))` on a non-numeric value trips `set -u`, and on
            # bash 3.2 (macOS, where the header invites running this by hand) the
            # script then exits 0 — a guard failing open on a typo in its own
            # arguments.
            fail "$2 must be a whole number, got '$1'." ;;
    esac
}

require_number "$expected_mutants" "the expected mutant count"
require_number "$expected_tests" "the expected test count"

[ -f "$log" ] || fail "no Stryker log at '$log' — the run produced nothing to judge."
[ -f "$config" ] || fail "no Stryker config at '$config'."
command -v jq >/dev/null 2>&1 || fail "jq is not installed, so the config's declared test-projects cannot be read. Refusing to pass a run this script was unable to check."

# Stryker's progress reporter writes \r-terminated lines; normalise once, to a FILE,
# so that no check has to pipe into grep (see the header).
norm="$(mktemp)"
trap 'rm -f "$norm"' EXIT
tr '\r' '\n' < "$log" > "$norm"

# ---------------------------------------------------------------------------
# Check 1 — vacuity. A run that discovered or tested zero mutants is not a passing
# run, it is a broken one (stryker-net#3094). Its failure mode differs from the
# checks below: this one catches a run that measured NOTHING, they catch a run that
# measured the WRONG thing.
#
# Note `[[:space:]]+`: Stryker column-pads the count, emitting
# "0     total mutants will be tested", so the single-space pattern this check
# inherited from the inline workflow step could never match and that whole
# alternative was dead.
# ---------------------------------------------------------------------------
if command grep -qE '(^|[^0-9])0[[:space:]]+total mutants will be tested|unable to calculate a mutation score|Number of tests found: 0([^0-9]|$)' "$norm"; then
    fail "tested zero mutants (vacuous run) — see the log above. Failing the gate instead of a false green (stryker-net#3094)."
fi

# ---------------------------------------------------------------------------
# Check 2 — the suite is the one the config named. Stryker prints "Analyzing N test
# project(s)." only when it resolves `test-projects` itself; in solution mode it
# prints "Stryker will mutate solution ..." and discovers test projects on its own,
# so the line is absent and this check fails. N comes from the config rather than a
# hand-maintained constant, so it cannot drift out of sync with what it guards.
# ---------------------------------------------------------------------------
declared="$(jq -r '.["stryker-config"]["test-projects"] | if . == null then "null" else length end' "$config" 2>/dev/null)"
case "$declared" in
    ''|null|0)
        fail "config '$config' declares no test-projects. Stryker would fall back to the working directory, which is not a measurement anyone chose."
        ;;
esac

if ! command grep -qF "Analyzing $declared test project(s)." "$norm"; then
    reported="$(command grep -oE 'Analyzing [0-9]+ test project\(s\)\.' "$norm" | head -1)"
    tests_found="$(command grep -oE 'Number of tests found: [0-9]+' "$norm" | head -1)"
    fail "expected Stryker to analyse exactly $declared test project(s) (the number '$config' declares), but the log does not say so — it says '${reported:-<nothing>}' (${tests_found:-tests found: unknown}).
    The usual cause is Stryker entering SOLUTION mode, which discards test-projects and substitutes every test project referencing the mutated assembly: a silent ~3x suite inflation whose only other symptom is a timeout weeks later (#99). Run from 'test/', not the repository root.
    If a Stryker upgrade merely reworded the line, fix this assertion — do not delete it."
fi

# ---------------------------------------------------------------------------
# Check 3 — the mutate glob still matches. Different failure from check 1: a glob that
# stops matching after a rename or a folder move does not report zero, it reports a
# COLLAPSED count, which the vacuity check waves through and a score cannot reveal
# (fewer mutants, same percentage). Anchored on the matrix's measured count.
#
# TOLERANCE: a one-sided floor at 60 % of the declared count, not a band.
#   - One-sided because only a collapse is a defect. More mutants than declared means
#     more code under measurement, which is never the bug — so growth must not fail a
#     run, or every ordinary PR that adds a line would need this file edited too.
#   - 60 % because the declared numbers are a dated snapshot, not a contract, and
#     ordinary drift between refreshes is single-digit percent. Losing two fifths of a
#     600-800 mutant shard is not drift; it is a glob that stopped matching or an area
#     that got excluded. The looseness is deliberate: check 2 is the exact one, and it
#     can afford to be exact because it is derived from the config.
# ---------------------------------------------------------------------------
tested="$(command grep -oE '[0-9]+[[:space:]]+total mutants will be tested' "$norm" | command grep -oE '^[0-9]+' | head -1)"
[ -n "$tested" ] || fail "the log never reports 'N total mutants will be tested', so there is no verdict to trust. Either the run did not reach the mutation loop, or a Stryker upgrade reworded the line — in which case fix this assertion rather than deleting it."

mutant_floor=$(( expected_mutants * 60 / 100 ))
if [ "$tested" -lt "$mutant_floor" ]; then
    fail "tested $tested mutants, but '$config' measured $expected_mutants when this shard was last calibrated (floor $mutant_floor = 60 %).
    A collapse this size is not ordinary drift: check the mutate globs against the files that moved. If the drop is legitimate, update the shard's 'mutants:' in .github/workflows/mutation.yml so the floor tracks reality."
fi

# ---------------------------------------------------------------------------
# Check 4 — the suite did not shrink. Check 2 catches the suite being SUBSTITUTED
# (solution mode inflates it); this catches it being GUTTED, which is the failure
# mutation testing exists to detect in the first place — "the adversarial suite
# stopped biting". Without it, deleting half of MMLib.Alvo.Tests passes checks 1-3
# unchanged (same projects, same mutants), and per #142 the score cannot currently be
# relied on to notice either. Same one-sided 60 % floor, same reasoning: tests are
# added far more often than removed, so only a collapse is a signal.
# ---------------------------------------------------------------------------
found="$(command grep -oE 'Number of tests found: [0-9]+' "$norm" | command grep -oE '[0-9]+$' | head -1)"
[ -n "$found" ] || fail "the log never reports 'Number of tests found: N', so the size of the suite behind this verdict is unknown. If a Stryker upgrade reworded the line, fix this assertion rather than deleting it."

test_floor=$(( expected_tests * 60 / 100 ))
if [ "$found" -lt "$test_floor" ]; then
    fail "ran against $found tests, but this shard was calibrated at $expected_tests (floor $test_floor = 60 %).
    A suite that lost two fifths of its tests is the exact regression this gate exists to catch, and it is invisible to the mutation score. If the shrinkage is legitimate, update the shard's 'suite:' in .github/workflows/mutation.yml."
fi

echo "[assert-mutation-run] $shard OK — $declared test project(s) as configured, $tested mutants tested (declared $expected_mutants, floor $mutant_floor), $found tests (declared $expected_tests, floor $test_floor)."
