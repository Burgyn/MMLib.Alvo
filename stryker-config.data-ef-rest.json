{
  "stryker-config": {
    "project": "MMLib.Alvo.Data.EntityFrameworkCore.csproj",
    "test-projects": [
      "MMLib.Alvo.Data.EntityFrameworkCore.Tests/MMLib.Alvo.Data.EntityFrameworkCore.Tests.csproj"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "additional-timeout": 300000,
    "mutate": [
